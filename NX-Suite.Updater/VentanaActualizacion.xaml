<Window x:Class="NX_Suite_Updater.VentanaActualizacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Width="520" Height="300"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True">
    <Grid>
        <Border CornerRadius="16" Background="#1A1A2E">
            <Border.Effect>
                <DropShadowEffect Color="#00D2FF" BlurRadius="32" ShadowDepth="0" Opacity="0.4"/>
            </Border.Effect>
        </Border>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
            <TextBlock Text="NX-SWITE"
                       Foreground="#00D2FF"
                       FontSize="28"
                       FontWeight="Bold"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#00D2FF" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="UPDATER"
                       Foreground="#5AEAFF"
                       FontSize="11"
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28"/>
            <TextBlock x:Name="TxtEstado"
                       Text="Iniciando..."
                       Foreground="#E0E0FF"
                       FontSize="14"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,16"/>
            <Grid Margin="0,0,0,12">
                <Border Height="6" CornerRadius="3" Background="#2A2A4A"/>
                <Border x:Name="BarraProgreso"
                        Height="6"
                        CornerRadius="3"
                        HorizontalAlignment="Left"
                        Width="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00D2FF" Offset="0"/>
                            <GradientStop Color="#7B2FFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                    </Border.Effect>
                </Border>
            </Grid>
            <Grid>
                <TextBlock x:Name="TxtPorcentaje"
                           Text="0%"
                           Foreground="#00D2FF"
                           FontSize="12"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="TxtDetalle"
                           Text=""
                           Foreground="#606080"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="280"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
