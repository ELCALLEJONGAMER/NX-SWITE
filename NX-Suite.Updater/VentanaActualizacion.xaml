<Window x:Class="NX_Suite_Updater.VentanaActualizacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NX-SWITE Updater" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" ResizeMode="NoResize"
        ShowInTaskbar="True" Topmost="True">

    <!-- Mismo aspecto que el splash de NX-SWITE: logo flotante con glow, etiqueta UPDATER y barra de progreso. -->
    <Grid>
    <!-- Fondo oscuro difuminado a pantalla completa: centra la atención en el progreso -->
    <Grid.Background>
        <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
            <GradientStop Color="#E6101018" Offset="0"/>
            <GradientStop Color="#D9050508" Offset="0.6"/>
            <GradientStop Color="#F2000000" Offset="1"/>
        </RadialGradientBrush>
    </Grid.Background>
    <StackPanel x:Name="PanelContenido" VerticalAlignment="Center" HorizontalAlignment="Center" Width="440" Opacity="0">

        <Grid Height="240" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="EscalaLogo" ScaleX="0.88" ScaleY="0.88"/>
            </Grid.RenderTransform>
            <Image x:Name="ImgLogo" HorizontalAlignment="Center" VerticalAlignment="Center"
                   MaxWidth="440" MaxHeight="240" Stretch="Uniform" Source="pack://application:,,,/Assets/logo.png"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect Color="#00D2FF" BlurRadius="40" ShadowDepth="0" Opacity="0.75"/>
                </Image.Effect>
            </Image>
        </Grid>

        <!-- Tarjeta de estado -->
        <Border CornerRadius="14" Background="#E60D0D14" BorderBrush="#2A2A35" BorderThickness="1"
                Padding="20,14,20,14" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="U P D A T E R" Foreground="#BD00FF" FontSize="11" FontWeight="Bold"
                           FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtEstado" Text="Iniciando..." Foreground="#E0E0FF" FontSize="14" FontWeight="SemiBold"
                           FontFamily="Segoe UI" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,0,0,12"/>
                <Grid Width="400" Margin="0,0,0,8">
                    <Border Height="6" CornerRadius="3" Background="#22222F"/>
                    <Border x:Name="BarraProgreso" Height="6" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00D2FF" Offset="0"/>
                                <GradientStop Color="#BD00FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
                <Grid Width="400">
                    <TextBlock x:Name="TxtPorcentaje" Text="0%" Foreground="#00D2FF" FontSize="12" FontWeight="SemiBold"
                               FontFamily="Segoe UI" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TxtDetalle" Text="" Foreground="#606080" FontSize="11" FontFamily="Segoe UI"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
    </Grid>
</Window>
