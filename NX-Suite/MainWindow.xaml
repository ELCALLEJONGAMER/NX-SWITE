<Window x:Class="NX_Swite.MainWindow"
        xmlns:controles="clr-namespace:NX_Swite.UI.Controles"
        xmlns:local="clr-namespace:NX_Swite"
        xmlns:core="clr-namespace:NX_Swite.Core"
        xmlns:cfg="clr-namespace:NX_Swite.Core.Configuracion"
        xmlns:models="clr-namespace:NX_Swite.Models"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NX-Swite"
        Icon="Assets/NX-SWITE_SIMPLIFICADO.ico"
        MinHeight="540"
        MinWidth="960"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="15"
            Background="#0D0D12"
            BorderBrush="#2A2A35"
            BorderThickness="1">
        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════
                 TOP BAR  –  arrastre + título + acciones
                 ══════════════════════════════════════════ -->
            <Border x:Name="BarraTopBar"
                    Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="#0F0F16"
                    BorderBrush="#2A2A35"
                    BorderThickness="0,0,0,1"
                    CornerRadius="15,15,0,0"
                    Height="52"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo fijo a la izquierda (no se mueve) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="14,0,0,0"
                                IsHitTestVisible="False">
                        <TextBlock Text="NX" Foreground="#00D2FF"
                                   FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="-SWITE" Foreground="#707080"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Rectangle Width="1" Height="14" Fill="#2A2A35" Margin="10,0"/>
                        <TextBlock x:Name="TxtTopBarSeccion" Text="Catálogo"
                                   Foreground="#505060" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   MaxWidth="120"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Iconos centrados -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <!-- Botón Ajustes -->
                        <Button x:Name="BtnAjustes"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Margin="0,0,4,0" Width="32" Height="32"
                                ToolTip="Ajustes"
                                Click="BtnAjustes_Click"
                                Style="{StaticResource EstiloBotonTopBar}">
                            <controles:GifIcon Width="32" Height="32" Stretch="Uniform" Opacity="0.55"
                                   AnimateOnHover="True"
                                   Url="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoConfigUrl}"/>
                        </Button>

                        <!-- Botón Cola de Procesos -->
                        <Button x:Name="BtnAbrirQueue"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Margin="0,0,4,0" Width="32" Height="32"
                                ToolTip="Cola de procesos"
                                Click="BtnAbrirQueue_Click"
                                Style="{StaticResource EstiloBotonTopBar}">
                            <Grid Width="32" Height="32">
                                <controles:GifIcon Width="32" Height="32" Stretch="Uniform" Opacity="0.65"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       AnimateOnHover="True"
                                       Url="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoQueueUrl}"/>
                                <Border x:Name="BadgeQueue"
                                        Background="#BD00FF" CornerRadius="6"
                                        MinWidth="13" Height="13" Padding="2,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,-3,-3,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source={x:Static core:Servicios.Cola}, Path=TieneActivos}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Source={x:Static core:Servicios.Cola}, Path=ContadorActivos}"
                                               FontSize="8" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Rectangle Width="1" Height="20" Fill="#2A2A35" Margin="4,0"/>

                        <!-- Notificaciones (reservado para uso futuro) -->
                        <Button x:Name="BtnNotificaciones"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Margin="0,0,4,0" Width="32" Height="32"
                                ToolTip="Notificaciones"
                                Visibility="Collapsed"
                                Style="{StaticResource EstiloBotonTopBar}">
                            <controles:GifIcon Width="32" Height="32" Stretch="Uniform" Opacity="0.55"
                                   AnimateOnHover="True"
                                   Url="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoBellUrl}"/>
                        </Button>

                        <!-- Mensajes (reservado para uso futuro) -->
                        <Button x:Name="BtnMensajes"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Margin="0,0,4,0" Width="32" Height="32"
                                ToolTip="Mensajes"
                                Visibility="Collapsed"
                                Style="{StaticResource EstiloBotonTopBar}">
                            <controles:GifIcon Width="32" Height="32" Stretch="Uniform" Opacity="0.55"
                                   AnimateOnHover="True"
                                   Url="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoMailUrl}"/>
                        </Button>

                        <!-- Log de actividad -->
                        <Button x:Name="BtnLog"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Margin="0,0,4,0" Width="32" Height="32"
                                ToolTip="Registro de actividad"
                                Click="BtnLog_Click"
                                Style="{StaticResource EstiloBotonTopBar}">
                            <controles:GifIcon Width="32" Height="32" Stretch="Uniform" Opacity="0.55"
                                   AnimateOnHover="True"
                                   Url="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoLogUrl}"/>
                        </Button>

                        <!-- RP2040 / Picofly -->
                        <Button x:Name="BtnRp2040"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Margin="0,0,4,0" Width="32" Height="32"
                                ToolTip="Actualizar firmware Picofly (RP2040)"
                                Click="BtnRp2040_Click"
                                Style="{StaticResource EstiloBotonTopBar}">
                            <controles:GifIcon Width="32" Height="32" Stretch="Uniform" Opacity="0.55"
                                   AnimateOnHover="True"
                                   Url="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoRp2040Url}"/>
                        </Button>

                        <!-- Actualizaciones -->
                        <Button x:Name="BtnActualizaciones"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Margin="0,0,0,0" Width="32" Height="32"
                                ToolTip="Actualizaciones"
                                Click="BtnActualizaciones_Click"
                                Style="{StaticResource EstiloBotonTopBar}">
                            <Grid Width="32" Height="32">
                                <controles:GifIcon Width="32" Height="32" Stretch="Uniform" Opacity="0.55"
                                       AnimateOnHover="True"
                                       Url="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoUpdateUrl}"/>
                                <!-- Badge verde pulsante: visible cuando hay actualización -->
                                <Border x:Name="BadgeActualizacion"
                                        Background="#22C55E" CornerRadius="5"
                                        Width="9" Height="9"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,-2,-2,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source={x:Static core:Servicios.Actualizacion}, Path=HayActualizacion}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <Trigger Property="IsVisible" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard x:Name="PulsoBadgeActualizacion">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="1" To="0.2"
                                                                                 Duration="0:0:0.9"
                                                                                 AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PulsoBadgeActualizacion"/>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Button>

                    </StackPanel>

                    <!-- Minimizar y Cerrar — estilo macOS (invertidos: amarillo izq, rojo der) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                        <Button x:Name="BtnMinimizar"
                                Margin="0,0,8,0"
                                Click="BtnMinimizar_Click"
                                ToolTip="Minimizar"
                                Style="{StaticResource EstiloBotonMacMinimizar}"/>
                        <Button x:Name="BtnCerrar"
                                Click="BtnCerrar_Click"
                                ToolTip="Cerrar"
                                Style="{StaticResource EstiloBotonMacCerrar}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Paneles laterales y contenido central en fila 1 -->
            <StackPanel x:Name="PanelLateralIzquierdo"
                        Grid.Row="1" Grid.Column="0"
                        Orientation="Horizontal"
                        Panel.ZIndex="10">
                <controles:PanelIzquierdo x:Name="MenuMundos" Width="220"/>
            </StackPanel>

            <Grid x:Name="GridContenidoCentral" Grid.Row="1" Grid.Column="1" ClipToBounds="True">
                <Grid x:Name="GridContenidoCentralContenido"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,12,20,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Titulo y subtitulo (siempre colapsado: la info ya aparece en la TopBar) -->
                        <Grid x:Name="PanelTituloSeccion"
                              Grid.Row="0" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTituloSeccion"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="#00D2FF"
                                           Margin="0,0,0,4" Text=""/>
                                <TextBlock x:Name="TxtSubtituloSeccion"
                                           Text="" Foreground="#707080"
                                           FontSize="11" FontWeight="SemiBold"
                                           Opacity="0.85"/>
                            </StackPanel>
                        </Grid>

                        <!-- Barra de búsqueda y chips de filtro -->
                        <Grid x:Name="PanelChipsFiltro"
                              Grid.Row="1"
                              Margin="0,0,0,10"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Chips de categoría (fluyen en dos columnas / múltiples filas) -->
                            <ListBox x:Name="ChipsFiltro"
                                     Grid.Row="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="0,0,0,8"
                                     ItemContainerStyle="{StaticResource EstiloItemChipFiltro}"
                                     ItemTemplate="{StaticResource PlantillaFiltroCentroMando}"
                                     SelectionChanged="ListaCategorias_SelectionChanged"
                                     PreviewMouseLeftButtonDown="ChipsFiltro_PreviewMouseLeftButtonDown">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <!-- Fila inferior: volver + barra de búsqueda + botón herramientas -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Botón volver al hub CFW (premium, reutilizable) -->
                                <Button x:Name="BtnVolverHubDesdeCatalogo"
                                        Grid.Column="0"
                                        Style="{StaticResource EstiloBotonVolverPremium}"
                                        Click="BtnVolverHubDesdeCatalogo_Click"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="2,0">
                                        <Path Data="M 7,1 L 1,6 L 7,11"
                                              Stroke="White" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="VOLVER"
                                                   FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Barra de búsqueda -->
                                <Border Grid.Column="1"
                                        CornerRadius="20"
                                        BorderThickness="2"
                                        BorderBrush="#2A2A35"
                                        Background="#0F0F15"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Width="220"
                                        Height="34">
                                    <Grid Margin="12,0">
                                        <TextBlock x:Name="PlaceholderBusqueda"
                                                   Text="🔍  Buscar módulo..."
                                                   Foreground="#505060"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                        <TextBox x:Name="TxtBusqueda"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#C0C0D0"
                                                 FontSize="11"
                                                 FocusVisualStyle="{x:Null}"
                                                 VerticalAlignment="Center"
                                                 CaretBrush="#00D2FF"
                                                 TextChanged="TxtBusqueda_TextChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Botón herramientas Hekate (solo visible en mundo personalizacion) -->
                                <Button x:Name="BtnHerramientasPersonalizacion"
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        Width="200" Height="34"
                                        Visibility="Collapsed"
                                        Cursor="Hand"
                                        Click="BtnHerramientasPersonalizacion_Click"
                                        Style="{StaticResource EstiloBotonAccionBase}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2699;" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Crear tema para hekate"
                                                   FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- Inicio / News (ahora a ancho completo: el diagnostico SD
                             vive en su propia seccion, ver VistaDiagnosticoSD) -->
                        <Grid x:Name="VistaNews" Grid.Row="2" Visibility="Collapsed">
                            <Border CornerRadius="22"
                                    BorderBrush="#2A2A35"
                                    BorderThickness="2"
                                    Background="#0AFFFFFF"
                                    Padding="28,22">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                                        <TextBlock Text="NOTICIAS"
                                                   Foreground="#00D2FF"
                                                   FontSize="26"
                                                   FontWeight="ExtraBold"/>
                                        <TextBlock Text="Ultimas novedades de NX-Swite y el ecosistema CFW"
                                                   Foreground="#707080"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.85"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="ListaNews"
                                                          ItemTemplate="{StaticResource PlantillaNewsItem}"
                                                          ButtonBase.Click="News_ClickBoton">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock x:Name="TxtSinNews"
                                                   Text="No hay noticias disponibles por ahora."
                                                   Foreground="#505060"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Diagnostico rapido SD — seccion propia, accesible desde
                             la tarjeta "Alertas y Estado" del hub CFW. -->
                        <Grid x:Name="VistaDiagnosticoSD" Grid.Row="2" Visibility="Collapsed">
                            <Border CornerRadius="22"
                                    BorderBrush="#2A2A35"
                                    BorderThickness="2"
                                    Background="#0800D2FF"
                                    Padding="28,22">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Encabezado -->
                                    <Grid Grid.Row="0" Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Botón volver al hub CFW -->
                                        <Button Grid.Column="0"
                                                Style="{StaticResource EstiloBotonVolverPremium}"
                                                Click="BtnVolverHubDesdeDiagnostico_Click"
                                                VerticalAlignment="Center"
                                                Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal" Margin="2,0">
                                                <Path Data="M 7,1 L 1,6 L 7,11"
                                                      Stroke="White" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="VOLVER"
                                                           FontSize="10" FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ALERTAS Y ESTADO"
                                                       Foreground="#00D2FF"
                                                       FontSize="18" FontWeight="ExtraBold"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtDiagSubtitulo"
                                                       Text="Conecta una SD para analizar."
                                                       Foreground="#707080"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Sin SD -->
                                    <StackPanel x:Name="PanelDiagSinSD"
                                                Grid.Row="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="&#x29C6;"
                                                   Foreground="#2A2A45" FontSize="48"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Sin SD conectada"
                                                   Foreground="#505060"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <!-- Sin problemas -->
                                    <StackPanel x:Name="PanelDiagOK"
                                                Grid.Row="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Visibility="Collapsed">
                                        <TextBlock Text="✓"
                                                   Foreground="#40C057" FontSize="48"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Todo en orden"
                                                   Foreground="#40C057"
                                                   FontSize="14" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,0"/>
                                        <TextBlock Text="No se encontraron problemas de configuración."
                                                   Foreground="#707080" FontSize="10"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   HorizontalAlignment="Center"
                                                   MaxWidth="260" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Lista de módulos con problemas -->
                                    <ScrollViewer x:Name="ScrollDiag"
                                                  Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  Visibility="Collapsed">
                                        <StackPanel>

                                            <!-- ── Sección: Configuración ── -->
                                            <StackPanel x:Name="SeccionDiagConfig">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Border Width="4" CornerRadius="2"
                                                            Background="#FF4444" Margin="0,0,8,0"/>
                                                    <TextBlock Text="CONFIGURACIÓN"
                                                               Foreground="#FF4444"
                                                               FontSize="9" FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ItemsControl x:Name="ListaDiagnostico"
                                                              ButtonBase.Click="Diagnostico_ClickReparar">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="12"
                                                                    BorderBrush="#2A2A35"
                                                                    BorderThickness="1"
                                                                    Background="#0F0F15"
                                                                    Padding="14,10"
                                                                    Margin="0,0,10,8"
                                                                    ClipToBounds="True">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <!-- Progreso de instalación (relleno verde de abajo arriba) -->
                                                                    <Rectangle Grid.RowSpan="3" IsHitTestVisible="False"
                                                                               Opacity="0.45" VerticalAlignment="Stretch"
                                                                               HorizontalAlignment="Stretch"
                                                                               RenderTransformOrigin="0.5,1">
                                                                        <Rectangle.Fill>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="#C040C057" Offset="0.0"/>
                                                                                <GradientStop Color="#6040C057" Offset="0.55"/>
                                                                                <GradientStop Color="#1A40C057" Offset="1.0"/>
                                                                            </LinearGradientBrush>
                                                                        </Rectangle.Fill>
                                                                        <Rectangle.RenderTransform>
                                                                            <ScaleTransform ScaleY="{Binding ProgresoInstalacion}"/>
                                                                        </Rectangle.RenderTransform>
                                                                        <Rectangle.Style>
                                                                            <Style TargetType="Rectangle">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding EstaInstalando}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Rectangle.Style>
                                                                    </Rectangle>

                                                                    <!-- Nombre módulo -->
                                                                    <TextBlock Grid.Row="0"
                                                                               Text="{Binding Nombre}"
                                                                               Foreground="White"
                                                                               FontSize="11" FontWeight="Bold"
                                                                               Margin="0,0,0,6"/>

                                                                    <!-- Hallazgos -->
                                                                    <ItemsControl Grid.Row="1"
                                                                                  ItemsSource="{Binding HallazgosConfig}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Orientation="Horizontal"
                                                                                            Margin="0,0,0,3">
                                                                                    <Border CornerRadius="4"
                                                                                            Padding="5,2"
                                                                                            Margin="0,0,6,0">
                                                                                        <Border.Style>
                                                                                            <Style TargetType="Border">
                                                                                                <Setter Property="Background" Value="#14FFD54A"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding EsCritico}" Value="True">
                                                                                                        <Setter Property="Background" Value="#14FF4444"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Border.Style>
                                                                                        <TextBlock FontSize="8" FontWeight="Bold">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Text"       Value="RECOMENDADA"/>
                                                                                                    <Setter Property="Foreground" Value="#FFD54A"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding EsCritico}" Value="True">
                                                                                                            <Setter Property="Text"       Value="CRÍTICO"/>
                                                                                                            <Setter Property="Foreground" Value="#FF4444"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </Border>
                                                                                    <TextBlock Text="{Binding Mensaje}"
                                                                                               Foreground="#A0A0B0"
                                                                                               FontSize="10"
                                                                                               VerticalAlignment="Center"
                                                                                               TextWrapping="Wrap"/>
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <!-- Botón Reparar -->
                                                                    <Button Grid.Row="2"
                                                                            HorizontalAlignment="Right"
                                                                            Height="24"
                                                                            Margin="0,8,0,0"
                                                                            Tag="{Binding}"
                                                                            Style="{DynamicResource EstiloBotonTarjetaInstalar}">
                                                                        <TextBlock Text="REPARAR"
                                                                                   FontSize="8" FontWeight="Bold"
                                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- ── Separador entre secciones ── -->
                                            <Rectangle x:Name="SepDiag"
                                                       Height="1" Fill="#1AFFFFFF"
                                                       Margin="0,4,0,12"/>

                                            <!-- ── Sección: Dependencias rotas (estilo "causa principal") ── -->
                                            <StackPanel x:Name="SeccionDiagDeps">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="&#x26A0;" FontSize="12"
                                                               Foreground="#FFD54A" Margin="0,0,8,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="DEPENDENCIAS ROTAS"
                                                               Foreground="#FFD54A"
                                                               FontSize="11" FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ItemsControl x:Name="ListaDiagDeps"
                                                              ButtonBase.Click="Diagnostico_ClickInstalarDep">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="14"
                                                                    BorderBrush="#3A3212"
                                                                    BorderThickness="1.5"
                                                                    Background="#0D0C08"
                                                                    Padding="18,16"
                                                                    Margin="0,0,0,10">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Icono hexagonal del módulo raíz (causa principal) -->
                                                                    <Border Grid.Column="0"
                                                                            Width="52" Height="52"
                                                                            CornerRadius="12"
                                                                            Background="#1AFFD54A"
                                                                            BorderBrush="#3A3212" BorderThickness="1"
                                                                            Margin="0,0,16,0"
                                                                            VerticalAlignment="Top">
                                                                        <Image Width="32" Height="32" Stretch="Uniform"
                                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                                               Source="{Binding ModuloCausante.IconoUrl, Converter={StaticResource IconoCacheConverter}}"/>
                                                                    </Border>

                                                                    <!-- Título + descripción + afecta a -->
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                            <TextBlock Text="{Binding TituloCausa}"
                                                                                       Foreground="White"
                                                                                       FontSize="15" FontWeight="Black"
                                                                                       Margin="0,0,10,0"/>
                                                                            <Border Background="#1AFFD54A" CornerRadius="6" Padding="8,3">
                                                                                <TextBlock Text="CAUSA PRINCIPAL"
                                                                                           FontSize="9" FontWeight="Bold"
                                                                                           Foreground="#FFD54A"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding MensajeCausa}"
                                                                                   Foreground="#8A8A70" FontSize="11"
                                                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="Afecta a: " Foreground="#707060"
                                                                                       FontSize="10" FontWeight="Bold"/>
                                                                            <ItemsControl ItemsSource="{Binding ModulosAfectados}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel/>
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <TextBlock Text="{Binding Nombre}"
                                                                                                   Foreground="#B0AA80" FontSize="10"
                                                                                                   Margin="0,0,8,2"/>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <!-- Contador + botón -->
                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                                                Margin="14,0,0,0">
                                                                        <Border Background="#12FFD54A" CornerRadius="8"
                                                                                Padding="10,6" Margin="0,0,0,8"
                                                                                HorizontalAlignment="Center">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#x1F465;" FontSize="11" Margin="0,0,6,0"/>
                                                                                <TextBlock Text="{Binding ModulosAfectados.Count, StringFormat={}{0} módulo(s) afectados}"
                                                                                           Foreground="#FFD54A" FontSize="9" FontWeight="Bold"
                                                                                           VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Button HorizontalAlignment="Stretch"
                                                                                Height="30"
                                                                                Tag="{Binding ModuloCausante}"
                                                                                Style="{DynamicResource EstiloBotonTarjetaAmbar}">
                                                                            <TextBlock Text="ACTUALIZAR"
                                                                                       FontSize="9" FontWeight="Bold"
                                                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- ── Sección: Incompatibilidad por Firmware (real) ── -->
                                            <StackPanel x:Name="SeccionDiagCompatRota" Visibility="Collapsed">
                                                <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,4,0,12"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="&#x26A0;" FontSize="12"
                                                               Foreground="#FF4444" Margin="0,0,8,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="INCOMPATIBILIDAD POR FIRMWARE"
                                                               Foreground="#FF4444"
                                                               FontSize="11" FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ItemsControl x:Name="ListaDiagCompatRota"
                                                              ButtonBase.Click="Diagnostico_ClickResolverIncompat"
                                                              ItemTemplate="{StaticResource PlantillaTarjetaIncompatReal}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- ── Sección: Incompatibilidad por Atmosphere (real) ── -->
                                            <StackPanel x:Name="SeccionDiagCompatAtmos" Visibility="Collapsed">
                                                <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,4,0,12"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="&#x26A0;" FontSize="12"
                                                               Foreground="#FF4444" Margin="0,0,8,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="INCOMPATIBILIDAD POR ATMOSPHERE"
                                                               Foreground="#FF4444"
                                                               FontSize="11" FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ItemsControl x:Name="ListaDiagCompatAtmos"
                                                              ButtonBase.Click="Diagnostico_ClickResolverIncompat"
                                                              ItemTemplate="{StaticResource PlantillaTarjetaIncompatReal}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- ── Sección: Incompatibilidad por Atmosphere (conflictos cruzados entre módulos) ── -->
                                            <StackPanel x:Name="SeccionDiagIncompat" Visibility="Collapsed">
                                                <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,4,0,12"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="&#x26A0;" FontSize="12"
                                                               Foreground="#FF4444" Margin="0,0,8,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="INCOMPATIBILIDAD POR ATMOSPHERE"
                                                               Foreground="#FF4444"
                                                               FontSize="11" FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ItemsControl x:Name="ListaDiagIncompat"
                                                              ButtonBase.Click="Diagnostico_ClickResolverIncompat"
                                                              ItemTemplate="{StaticResource PlantillaTarjetaIncompatReal}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>

                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Catálogo -->
                        <ScrollViewer x:Name="VistaCatalogo"
                                      Grid.Row="2"
                                      SizeChanged="VistaCatalogo_SizeChanged"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <ItemsControl x:Name="CatalogoModulos"
                                          ItemTemplate="{StaticResource PlantillaModuloGamer}"
                                          MouseLeftButtonDown="Catalogo_ClickTarjeta"
                                          ButtonBase.Click="Catalogo_ClickBoton">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>


                        <!-- Detalle de módulo -->
                        <Grid x:Name="VistaDetalle" Grid.Row="2" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="190"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ── Banner con blur glass ── -->
                            <Grid Grid.Row="0" ClipToBounds="True">
                                <!-- Imagen de fondo desenfocada (centrada) -->
                                <Rectangle RenderOptions.BitmapScalingMode="LowQuality" CacheMode="BitmapCache">
                                    <Rectangle.Fill>
                                        <ImageBrush x:Name="BrushBannerDetalle"
                                                    Stretch="UniformToFill"
                                                    AlignmentX="Center"
                                                    AlignmentY="Center"/>
                                    </Rectangle.Fill>
                                    <Rectangle.Effect>
                                        <BlurEffect Radius="15"/>
                                    </Rectangle.Effect>
                                </Rectangle>
                                <!-- Capa oscura sobre el banner -->
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#99050510" Offset="0"/>
                                            <GradientStop Color="#EE0D0D12" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <!-- Borde neon inferior del banner -->
                                <Border VerticalAlignment="Bottom" Height="1"
                                        Background="#2800D2FF" Opacity="0.6"/>
                                <!-- Acento ambiental sutil detrás del header, color según estado -->
                                <Ellipse x:Name="GlowHeaderDetalle" Width="420" Height="180"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Margin="0,10,0,0" IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop x:Name="GlowHeaderStop1" Color="#1400D2FF" Offset="0"/>
                                            <GradientStop x:Name="GlowHeaderStop2" Color="#0000D2FF" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <!-- Botón volver (top-left) -->
                                <Button Style="{StaticResource EstiloBotonVolver}"
                                        Click="BtnVolver_Click"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="10,10,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="2,0">
                                        <Path Data="M 7,1 L 1,6 L 7,11"
                                              Stroke="White" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="VOLVER"
                                                   FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- Jerarquía: [ESTADO] encima del nombre del módulo, centrado -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="0,20,0,0">
                                    <Border x:Name="BadgeEstadoHeaderDetalle"
                                            CornerRadius="10" Padding="14,4"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtEstadoHeaderDetalle"
                                                   FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="TxtTituloDetalle"
                                               FontSize="50" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#00D2FF" BlurRadius="20"
                                                              ShadowDepth="0" Opacity="0.7"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock x:Name="TxtVersionDetalle"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#A0A0B0"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ── Row 1: columna izquierda (icono + etiquetas) + columna derecha (contenido) ── -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icono solapando el banner + etiquetas debajo -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Top"
                                            HorizontalAlignment="Center"
                                            Margin="0,-56,0,0" Panel.ZIndex="20">
                                    <Border Width="150" Height="150"
                                            CornerRadius="0"
                                            BorderBrush="#00D2FF" BorderThickness="2"
                                            Background="#1A0D0D12"
                                            HorizontalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00D2FF" BlurRadius="50"
                                                              ShadowDepth="0" Opacity="0.50"/>
                                        </Border.Effect>
                                        <Image x:Name="ImgDetalle" Stretch="Uniform"
                                               MaxWidth="146" MaxHeight="146"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- Etiquetas debajo del icono -->
                                    <ItemsControl x:Name="ListaEtiquetasDetalle" Margin="4,10,4,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="5" Padding="6,3" Margin="0,0,4,4"
                                                        BorderBrush="#2A2A35" BorderThickness="1"
                                                        Background="#1A1A25">
                                                    <TextBlock Text="{Binding}" FontSize="9"
                                                               Foreground="#707080" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Contenido principal + cache -->
                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                              Padding="0,0,4,0">
                                    <Grid Margin="8,18,16,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="210"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Info principal -->
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">

                                            <!-- Descripción -->
                                            <TextBlock Text="DESCRIPCIÓN"
                                                       Foreground="#707080"
                                                       FontSize="10" FontWeight="Bold"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock x:Name="TxtDescDetalle"
                                                       FontSize="14" Foreground="White"
                                                       TextWrapping="Wrap"
                                                       Opacity="0.85" LineHeight="22"
                                                       Margin="0,0,0,18"/>

                                            <!-- Diagnóstico de instalación parcial — solo visible cuando
                                                 EstadoSd == ParcialmenteInstalado. Muestra la MISMA
                                                 evidencia (rutas faltantes) que produjo el detector, sin
                                                 volver a analizar la SD desde la UI. -->
                                            <StackPanel x:Name="PanelDiagnosticoParcial"
                                                        Visibility="Collapsed"
                                                        Margin="0,0,0,18">
                                                <TextBlock Text="INSTALACIÓN"
                                                           Foreground="#707080"
                                                           FontSize="10" FontWeight="Bold"
                                                           Margin="0,0,0,8"/>
                                                <Border CornerRadius="12"
                                                        BorderBrush="#3A2F12"
                                                        BorderThickness="1.5"
                                                        Background="#0D0A05"
                                                        Padding="14,12">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBlock Text="⚠" FontSize="14"
                                                                       Foreground="#F59E0B"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"/>
                                                            <TextBlock Text="Instalación incompleta"
                                                                       Foreground="#F59E0B"
                                                                       FontSize="13" FontWeight="Bold"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="TxtDiagnosticoResumen"
                                                                   Foreground="#C0A050" FontSize="11"
                                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                        <TextBlock x:Name="TxtDiagnosticoVersion"
                                                                   Foreground="#8A8A70" FontSize="10"
                                                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                        <Button x:Name="BtnVerDetallesDiagnostico"
                                                                HorizontalAlignment="Left"
                                                                Background="Transparent"
                                                                BorderBrush="#3A2F12"
                                                                BorderThickness="1"
                                                                Foreground="#F59E0B"
                                                                FontSize="9" FontWeight="Bold"
                                                                Padding="10,5"
                                                                Cursor="Hand"
                                                                Click="BtnVerDetallesDiagnostico_Click">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                            <TextBlock x:Name="TxtBtnVerDetallesDiagnostico" Text="VER DETALLES"/>
                                                        </Button>

                                                        <StackPanel x:Name="PanelDetallesDiagnostico"
                                                                    Visibility="Collapsed"
                                                                    Margin="0,12,0,0">
                                                            <TextBlock x:Name="TxtCabeceraElementosFaltantes"
                                                                       Text="ELEMENTOS NO ENCONTRADOS"
                                                                       Foreground="#707080"
                                                                       FontSize="9" FontWeight="Bold"
                                                                       Margin="0,0,0,6"/>
                                                            <ScrollViewer MaxHeight="160"
                                                                          VerticalScrollBarVisibility="Auto"
                                                                          HorizontalScrollBarVisibility="Disabled">
                                                                <ItemsControl x:Name="ListaElementosFaltantes">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Margin="0,0,0,4"
                                                                                       FontSize="10"
                                                                                       Foreground="#D0A0A0"
                                                                                       FontFamily="Consolas"
                                                                                       TextWrapping="Wrap">
                                                                                <Run Text="✕ " Foreground="#EF4444"/>
                                                                                <Run Text="{Binding Mode=OneWay}"/>
                                                                            </TextBlock>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>

                                                            <Button x:Name="BtnCopiarDiagnostico"
                                                                    Content="COPIAR"
                                                                    HorizontalAlignment="Left"
                                                                    Background="Transparent"
                                                                    BorderBrush="#2A2A35"
                                                                    BorderThickness="1"
                                                                    Foreground="#707080"
                                                                    FontSize="9" FontWeight="Bold"
                                                                    Padding="10,5"
                                                                    Margin="0,10,0,0"
                                                                    Cursor="Hand"
                                                                    Click="BtnCopiarDiagnostico_Click"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Capturas de pantalla -->
                                            <StackPanel x:Name="PanelScreenshots" Visibility="Collapsed"
                                                        Margin="0,0,0,10">
                                                <TextBlock Text="CAPTURAS" Foreground="#707080"
                                                           FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <ScrollViewer x:Name="ScrollCapturas"
                                                              Style="{StaticResource EstiloScrollViewerHorizontal}"
                                                              HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              SizeChanged="ScrollCapturas_SizeChanged">
                                                    <StackPanel x:Name="ContenedorCapturas"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Center">
                                                        <ItemsControl x:Name="ListaScreenshots"
                                                                      SizeChanged="ScrollCapturas_SizeChanged">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="224" Height="132" Margin="0,0,10,0"
                                                                            CornerRadius="10" ClipToBounds="True"
                                                                            BorderBrush="#2A2A35" BorderThickness="1">
                                                                        <Image Source="{Binding}" Stretch="Uniform"
                                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </StackPanel>

                                        </StackPanel>

                                        <!-- Cache local (columna derecha) -->
                                        <Border x:Name="PanelCacheDetalle" Grid.Column="1"
                                                Visibility="Collapsed"
                                                CornerRadius="15" Padding="14,12"
                                                Background="#0AFFFFFF"
                                                BorderBrush="#2A2A35" BorderThickness="3"
                                                VerticalAlignment="Top">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtCabeceraCachePanel"
                                                           Text="CACHE EN PC" Foreground="#707080"
                                                           FontSize="12" FontWeight="Bold" Margin="0,0,0,12"
                                                           Visibility="Collapsed"/>

                                                <!-- ZIP -->
                                                <StackPanel x:Name="FilaCacheZip" Orientation="Horizontal"
                                                            Margin="0,5,0,20" Visibility="Collapsed"
                                                            VerticalAlignment="Center">
                                                    <Image Width="24" Height="24" Stretch="Uniform"
                                                           VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0"
                                                           Source="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoZipUrl}"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="ZIP" Foreground="#707080" FontSize="12"
                                                                   FontWeight="Bold"/>
                                                        <TextBlock x:Name="TxtTamanoZip" Foreground="#00D2FF"
                                                                   FontSize="14" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <Button x:Name="BtnBorrarCacheZip"
                                                            Background="Transparent" BorderThickness="0"
                                                            Cursor="Hand" VerticalAlignment="Center" Margin="60,0,0,0"
                                                            Click="BtnBorrarCacheZip_Click">
                                                        <Image Width="32" Height="32" Stretch="Uniform" Opacity="0.70"
                                                               Source="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoEliminarUrl}"/>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Separador ZIP/Carpeta (oculto: cache ahora en chips) -->
                                                <Rectangle x:Name="SepCacheTopRows"
                                                           Height="3" Fill="#2A2A35" Margin="0,0,0,20"
                                                           Visibility="Collapsed"/>

                                                <!-- Carpeta extraída -->
                                                <StackPanel x:Name="FilaCacheCarpeta" Orientation="Horizontal"
                                                            Visibility="Collapsed" VerticalAlignment="Center">
                                                    <Image Width="24" Height="24" Stretch="Uniform"
                                                           VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0"
                                                           Source="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoCacheUrl}"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Extraído" Foreground="#707080" FontSize="12"
                                                                   FontWeight="Bold"/>
                                                        <TextBlock x:Name="TxtTamanoCarpeta" Foreground="#00D2FF"
                                                                   FontSize="14" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <Button x:Name="BtnBorrarCacheCarpeta"
                                                            Background="Transparent" BorderThickness="0"
                                                            Cursor="Hand" VerticalAlignment="Center" Margin="45,0,0,0"
                                                            Click="BtnBorrarCacheCarpeta_Click">
                                                        <Image Width="32" Height="32" Stretch="Uniform" Opacity="0.70"
                                                               Source="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoEliminarUrl}"/>
                                                    </Button>
                                                </StackPanel>

                                                <!-- ── Chips de versiones disponibles ── -->

                                                <StackPanel x:Name="PanelCabeceraVersiones" Visibility="Collapsed" Margin="0,0,0,8">
                                                    <TextBlock x:Name="TxtTituloVersiones"
                                                               Text="VERSIONES" Foreground="#505060"
                                                               FontSize="14" FontWeight="Bold"/>
                                                    <TextBlock Text="Versiones disponibles y caché local"
                                                               Foreground="#404050" FontSize="9" FontWeight="SemiBold"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <ScrollViewer x:Name="ScrollVersiones"
                                                              MaxHeight="340"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel x:Name="PanelChipsVersiones" Margin="0,0,4,0"/>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>

                                    </Grid>
                                </ScrollViewer>
                            </Grid>

                            <!-- ── Botones de acción inteligentes ── -->
                            <WrapPanel Grid.Row="2" HorizontalAlignment="Center"
                                       Margin="0,10,0,0" Orientation="Horizontal">
                                <Button x:Name="BtnInstalarDetalle"
                                        Content="INSTALAR"
                                        Style="{StaticResource EstiloBotonInstalar}"
                                        Width="160" Height="50"
                                        Click="BtnInstalar_Click"/>
                                <Button x:Name="BtnActualizarDetalle"
                                        Content="ACTUALIZAR"
                                        Style="{StaticResource EstiloBotonActualizar}"
                                        Width="160" Height="50"
                                        Click="BtnInstalar_Click"/>
                                <controles:SafeButton x:Name="BtnBorrarDetalle"
                                        Content="ELIMINAR"
                                        IsSafeMode="True"
                                        HoldTimeSeconds="2"
                                        Style="{StaticResource EstiloBotonEliminarHold}"
                                        Click="BtnBorrar_Click"/>
                                <Button x:Name="BtnAbrirUbicacionDetalle"
                                        Content="ABRIR UBICACIÓN"
                                        Style="{StaticResource EstiloBotonActualizar}"
                                        Width="160" Height="50"
                                        Click="BtnAbrirUbicacion_Click"/>
                                <Button x:Name="BtnSitioWebDetalle"
                                        Content="SITIO WEB"
                                        Style="{StaticResource EstiloBotonMenu}"
                                        Width="160" Height="50"
                                        Click="BtnSitioWeb_Click"/>
                            </WrapPanel>
                        </Grid>

                        <!-- Vista Asistida -->
                        <controles:VistaAsistida x:Name="VistaAsistida"
                                                  Grid.Row="2"
                                                  Visibility="Collapsed"/>

                        <!-- Vista Personalizacion -->
                        <controles:VistaPersonalizacion x:Name="VistaPersonalizacion"
                                                         Grid.Row="2"
                                                         Visibility="Collapsed"/>

                        <!-- Vista Hub CFW — fase 1 (solo visual, aún no conectada a la
                             navegación de MundosMenu ni al Gist). Ver CODEBASE_INDEX.md. -->
                        <controles:VistaHubCFW x:Name="VistaHubCFW"
                                                Grid.Row="2"
                                                Visibility="Collapsed"/>

                        <!-- Vista emuMMC (mundo del menú lateral, fase 1: solo lectura) -->
                        <controles:VistaEmuMMC x:Name="VistaEmuMMC"
                                                Grid.Row="2"
                                                Visibility="Collapsed"/>

                    </Grid>
                </Grid>

                <!-- Flash neon de transición entre mundos -->
                <Rectangle x:Name="FlashNavegacion"
                           Panel.ZIndex="5"
                           IsHitTestVisible="False"
                           Opacity="0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="Transparent" Offset="0.0"/>
                            <GradientStop Color="#0800D2FF"   Offset="0.2"/>
                            <GradientStop Color="#2200D2FF"   Offset="0.5"/>
                            <GradientStop Color="#0800D2FF"   Offset="0.8"/>
                            <GradientStop Color="Transparent" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Border x:Name="FondoOscuro"
                        Background="Black"
                        Opacity="0"
                        Visibility="Collapsed"
                        Panel.ZIndex="100">
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Click="BtnCerrarPaneles_Click"/>
                </Border>

                <Grid x:Name="OverlayCarga"
                      Visibility="Collapsed"
                      Panel.ZIndex="1000">
                    <!-- Backdrop bloqueante: captura TODOS los clicks para evitar
                         que el usuario interactúe con la app durante operaciones
                         críticas. NO tiene handler de cierre — sólo se cierra
                         programáticamente vía ControladorCarga.Ocultar(). -->
                    <Border Background="#E605050A"
                            IsHitTestVisible="True"
                            MouseLeftButtonDown="OverlayCarga_BloquearClick"
                            MouseRightButtonDown="OverlayCarga_BloquearClick"/>
                    <Border Background="#12121A"
                            BorderBrush="{StaticResource PincelNeonRotatorio}"
                            BorderThickness="1.5"
                            CornerRadius="20"
                            Width="460"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#00D2FF" BlurRadius="40" ShadowDepth="0" Opacity="0.25"/>
                        </Border.Effect>
                        <Grid Margin="32,28">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                                    <TextBlock Text="O P E R A C I Ó N   E N   C U R S O"
                                           Foreground="#BD00FF" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock x:Name="TxtCargaSubtitulo"
                                           Text="Instalando Paquete"
                                           Foreground="#00D2FF" FontSize="22" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Width="100" Height="100"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="0,20">
                                <Path Data="M 50,0 A 50,50 0 1 1 0,50"
                                      Stroke="{StaticResource PincelNeonRotatorio}" StrokeThickness="5"
                                      StrokeEndLineCap="Round" Stretch="None">
                                    <Path.Effect>
                                        <DropShadowEffect Color="#00D2FF" BlurRadius="15" ShadowDepth="0"/>
                                    </Path.Effect>
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="GiroSpinner" CenterX="50" CenterY="50"/>
                                    </Path.RenderTransform>
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <Trigger Property="IsVisible" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard x:Name="GiroSpinnerSB">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360"
                                                                                 Duration="0:0:1"
                                                                                 RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="GiroSpinnerSB"/>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock x:Name="TxtCargaPorcentaje"
                                           Text="0%" Foreground="White"
                                           FontSize="20" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="0,0,0,18">
                                <Border x:Name="PistaProgresoCarga" Background="#1A1A24" CornerRadius="10"
                                        Height="8" BorderBrush="#2A2A35"
                                        BorderThickness="1" ClipToBounds="True"
                                        Margin="0,0,0,10">
                                    <Border x:Name="BarraProgresoNeon"
                                                Background="{StaticResource PincelNeonRotatorio}" Width="0"
                                                HorizontalAlignment="Left" CornerRadius="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00D2FF" BlurRadius="10" ShadowDepth="0"/>
                                        </Border.Effect>
                                    </Border>
                                </Border>
                                <TextBlock x:Name="TxtCargaDetalle"
                                           Text="Preparando motores..."
                                           Foreground="#707080" FontSize="12"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <UniformGrid x:Name="PanelPasosCarga" Grid.Row="3" Columns="2" Rows="2" Margin="10,0">
                                <TextBlock x:Name="TxtPaso1" Text="1. Descargando paquete"
                                           Foreground="#707080" FontSize="12"
                                           FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock x:Name="TxtPaso2" Text="2. Extrayendo archivos"
                                           Foreground="#707080" FontSize="12"
                                           FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock x:Name="TxtPaso3" Text="3. Aplicando en SD"
                                           Foreground="#707080" FontSize="12"
                                           FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock x:Name="TxtPaso4" Text="4. Limpiando temporales"
                                           Foreground="#707080" FontSize="12"
                                           FontWeight="SemiBold" Margin="0,5"/>
                            </UniformGrid>

                            <ScrollViewer x:Name="ScrollModulosCarga" Grid.Row="4"
                                          MaxHeight="170" Margin="10,4,10,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="Collapsed">
                                <StackPanel x:Name="PanelModulosCarga"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="GridPanelDerechoContenedor" Grid.Row="1" Grid.Column="2" Panel.ZIndex="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <controles:RetractilDer x:Name="ArsenalRetractil" Grid.Column="0"/>
                <controles:PanelDerecho x:Name="InfoSD" Grid.Column="1"/>
            </Grid>

            <!-- Overlay ligero de refresco de catálogo (~1 s tras salir de ventana de deps) -->
            <Border x:Name="OverlayRefrescandoCatalogo"
                    Grid.Row="1" Grid.Column="1"
                    Panel.ZIndex="50"
                    Visibility="Collapsed"
                    IsHitTestVisible="True"
                    Background="#CC000008">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Width="40" Height="40"
                          Data="M 20,0 A 20,20 0 1 1 0,20"
                          Stroke="#00D2FF" StrokeThickness="3"
                          StrokeEndLineCap="Round" HorizontalAlignment="Center">
                        <Path.Effect>
                            <DropShadowEffect Color="#00D2FF" BlurRadius="12"
                                              ShadowDepth="0" Opacity="0.9"/>
                        </Path.Effect>
                        <Path.RenderTransform>
                            <RotateTransform x:Name="GiroSpinnerCatalogo" CenterX="20" CenterY="20"/>
                        </Path.RenderTransform>
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <Trigger Property="IsVisible" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard x:Name="GiroSpinnerCatalogoSB">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360"
                                                                     Duration="0:0:0.8"
                                                                     RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="GiroSpinnerCatalogoSB"/>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock Text="Actualizando estados..."
                               Foreground="#00D2FF" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════
                 OVERLAY: Cola de Procesos (PS5-style)
                 ══════════════════════════════════════════════ -->
            <Grid x:Name="PanelQueueOverlay"
                  Grid.Row="0" Grid.RowSpan="2"
                  Grid.Column="0" Grid.ColumnSpan="3"
                  Visibility="Collapsed"
                  Panel.ZIndex="900">

                <!-- Click-away para cerrar -->
                <Border Background="Transparent"
                        MouseLeftButtonDown="BtnCerrarQueue_Click"/>

                <!-- Panel flotante bajo el top bar, alineado a la izquierda -->
                <Border Width="390" MaxHeight="560"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="180,52,0,0"
                        CornerRadius="0,0,16,16"
                        Background="#0C0C14"
                        BorderBrush="#2A2A35" BorderThickness="1,0,1,1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.7"/>
                    </Border.Effect>
                    <Border.Resources>
                        <Style x:Key="QueuePbStyle" TargetType="ProgressBar">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="#1A1A25" CornerRadius="2" ClipToBounds="True">
                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00D2FF" Offset="0"/>
                                                        <GradientStop Color="#BD00FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera -->
                        <Grid Grid.Row="0" Margin="16,14,12,12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="COLA DE PROCESOS"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#00D2FF" Opacity="0.85"/>
                                <TextBlock Text="{Binding Source={x:Static core:Servicios.Cola}, Path=ContadorActivos,
                                                         StringFormat={}{0} proceso(s) activo(s)}"
                                           FontSize="10" Foreground="#707080" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Click="BtnCerrarQueue_Click">
                                <TextBlock Text="✕" FontSize="14" Foreground="#707080" Opacity="0.7"/>
                            </Button>
                        </Grid>

                        <Rectangle Grid.Row="0" Height="1" Fill="#2A2A35"
                                   VerticalAlignment="Bottom"/>

                        <!-- Lista de items -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Padding="12,8,12,0">
                            <ItemsControl ItemsSource="{Binding Source={x:Static core:Servicios.Cola}, Path=Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ItemQueue}">
                                        <Border Margin="0,0,0,8" CornerRadius="10"
                                                Background="#12121C"
                                                BorderBrush="#2A2A35" BorderThickness="1"
                                                Padding="12,10">
                                            <StackPanel>
                                                <!-- Fila 1: Titulo + badge estado + cancelar -->
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Titulo}"
                                                               FontSize="11" FontWeight="Bold"
                                                               Foreground="White"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,110,0"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel HorizontalAlignment="Right"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <!-- Estado badge -->
                                                        <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#20707080"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoQueue.EnProceso}">
                                                                            <Setter Property="Background" Value="#1800D2FF"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoQueue.Completado}">
                                                                            <Setter Property="Background" Value="#1822C55E"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoQueue.Error}">
                                                                            <Setter Property="Background" Value="#18EF4444"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding TextoEstado}" FontSize="9" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#707080"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoQueue.EnProceso}">
                                                                                <Setter Property="Foreground" Value="#00D2FF"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoQueue.Completado}">
                                                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Estado}" Value="{x:Static models:EstadoQueue.Error}">
                                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <!-- Botón cancelar (solo si activo) -->
                                                        <Button Tag="{Binding}"
                                                                Background="Transparent" BorderThickness="0"
                                                                Cursor="Hand" VerticalAlignment="Center"
                                                                Click="BtnCancelarItemQueue_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EsActivo}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Border Background="#20EF4444" CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="Cancelar" FontSize="9"
                                                                           FontWeight="Bold" Foreground="#EF4444"/>
                                                            </Border>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Barra de progreso -->
                                                <ProgressBar Value="{Binding Progreso}" Maximum="100" Height="4"
                                                             Margin="0,0,0,6"
                                                             Style="{StaticResource QueuePbStyle}"/>

                                                <!-- Mensaje estado -->
                                                <TextBlock Text="{Binding MensajeEstado}"
                                                           FontSize="9" Foreground="#707080"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Pie: limpiar completados -->
                        <Border Grid.Row="2" BorderBrush="#2A2A35" BorderThickness="0,1,0,0"
                                Padding="12,10">
                            <Grid>
                                <TextBlock Text="No hay procesos en cola"
                                           FontSize="10" Foreground="#707080"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source={x:Static core:Servicios.Cola}, Path=TieneItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Content="LIMPIAR COMPLETADOS"
                                        HorizontalAlignment="Right"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" FontSize="10" FontWeight="Bold"
                                        Foreground="#707080"
                                        Click="BtnLimpiarQueue_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source={x:Static core:Servicios.Cola}, Path=TieneItems}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 OVERLAY: Panel de Actualización de la App
                 ══════════════════════════════════════════════════════════ -->
            <Grid x:Name="PanelActualizacionOverlay"
                  Grid.Row="0" Grid.RowSpan="2"
                  Grid.Column="0" Grid.ColumnSpan="3"
                  Visibility="Collapsed"
                  Panel.ZIndex="901">

                <!-- Fondo oscurecido (click-away para cerrar) -->
                <Border Background="#B3050508" CornerRadius="15"
                        MouseLeftButtonDown="BtnCerrarActualizacion_Click"/>

                <!-- Tarjeta centrada -->
                <Border Width="540" MaxHeight="620"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="18"
                        Background="#0B0B14"
                        BorderBrush="#2A2A35" BorderThickness="1"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="Black" Opacity="0.85"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Franja de acento superior -->
                        <Border Grid.Row="0" Height="4" CornerRadius="18,18,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00D2FF" Offset="0"/>
                                    <GradientStop Color="#22C55E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- ── Cabecera ── -->
                        <Grid Grid.Row="1" Margin="24,20,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icono de descarga -->
                            <Border Width="52" Height="52" CornerRadius="26"
                                    Background="#0E2416" BorderBrush="#22C55E" BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Path Data="M 12,2 L 12,15 M 6,10 L 12,16 L 18,10 M 4,20 L 20,20"
                                      Stroke="#22C55E" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="24" Height="24" Stretch="None"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ACTUALIZACIÓN DISPONIBLE"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#22C55E" Margin="0,0,0,2"/>
                                <TextBlock Text="Hay una nueva versión de NX-Swite"
                                           FontSize="19" FontWeight="Bold"
                                           Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtSubtituloActualizacion"
                                           Text="Recomendamos actualizar para tener las últimas mejoras y correcciones."
                                           FontSize="11" Foreground="#707080"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2" VerticalAlignment="Top"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" ToolTip="Cerrar"
                                    Click="BtnCerrarActualizacion_Click">
                                <TextBlock Text="✕" FontSize="14" Foreground="#707080" Opacity="0.7"/>
                            </Button>
                        </Grid>

                        <!-- ── Cuerpo: versiones + notas ── -->
                        <Grid Grid.Row="2" Margin="24,22,24,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Comparativa de versiones -->
                            <Border Grid.Row="0" CornerRadius="12" Padding="18,12"
                                    Background="#10101A" BorderBrush="#22222D" BorderThickness="1"
                                    Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="INSTALADA" FontSize="9" FontWeight="Bold"
                                                   Foreground="#505060" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtVersionActualOverlay"
                                                   Text="v—" FontSize="22" FontWeight="Bold"
                                                   Foreground="#707080" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <Path Grid.Column="1" Data="M 0,8 L 28,8 M 21,1 L 28,8 L 21,15"
                                          Stroke="#22C55E" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" Margin="16,12,16,0"/>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="NUEVA" FontSize="9" FontWeight="Bold"
                                                   Foreground="#22C55E" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtVersionNuevaOverlay"
                                                   Text="v—" FontSize="22" FontWeight="Bold"
                                                   Foreground="#22C55E" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Novedades / Changelog -->
                            <TextBlock Grid.Row="1" Text="NOVEDADES" Foreground="#505060"
                                       FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                            <Border Grid.Row="2" CornerRadius="12" Background="#0F0F18"
                                    BorderBrush="#22222D" BorderThickness="1"
                                    Padding="16,12" MaxHeight="220">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="TxtNotasActualizacion"
                                               Text="" Foreground="#B0B0C8"
                                               FontSize="12" TextWrapping="Wrap"
                                               LineHeight="21"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- ── Barra de progreso de descarga (oculta inicialmente) ── -->
                        <StackPanel x:Name="PanelProgresoActualizacion"
                                    Grid.Row="3" Margin="24,4,24,12"
                                    Visibility="Collapsed">
                            <Border x:Name="ContenedorBarraActualizacion"
                                    Background="#12121C" CornerRadius="5" Height="8"
                                    BorderBrush="#2A2A35" BorderThickness="1"
                                    ClipToBounds="True" Margin="0,0,0,8">
                                <Border x:Name="BarraProgresoActualizacion"
                                        Width="0" HorizontalAlignment="Left"
                                        CornerRadius="5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00D2FF" Offset="0"/>
                                            <GradientStop Color="#22C55E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                            <TextBlock x:Name="TxtEstadoActualizacion"
                                       Text="Preparando descarga..."
                                       Foreground="#707080" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- ── Pie: aviso + botones ── -->
                        <Border Grid.Row="4" Background="#08080F"
                                BorderBrush="#1C1C26" BorderThickness="0,1,0,0"
                                CornerRadius="0,0,18,18" Padding="20,14,20,18">
                            <StackPanel>
                                <TextBlock Text="NX-Swite se cerrará y se reiniciará automáticamente al terminar."
                                           FontSize="10" Foreground="#505060"
                                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="BtnRecordarMasTardeActualizacion"
                                            Grid.Column="0" Margin="0,0,6,0" Height="42"
                                            Content="MÁS TARDE"
                                            Click="BtnRecordarMasTarde_Click"
                                            Style="{StaticResource EstiloBotonMenu}"/>

                                    <Button x:Name="BtnActualizarAhora"
                                            Grid.Column="1" Margin="6,0,0,0" Height="42"
                                            Content="ACTUALIZAR AHORA"
                                            Click="BtnActualizarAhora_Click"
                                            Style="{StaticResource EstiloBotonInstalar}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 OVERLAY: Selector de modo de actualización CFW
                 Mismo estilo visual que el selector de instalación
                 (VistaAsistida.OverlaySelectorModo): dos tarjetas premium.
                 ══════════════════════════════════════════════════════════ -->
            <Grid x:Name="PanelSelectorActualizarOverlay"
                  Grid.Row="1" Grid.Column="1"
                  Visibility="Collapsed"
                  Panel.ZIndex="906"
                  Background="#07070D">

                <!-- Botón volver al hub CFW -->
                <Button HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="24,24,0,0"
                        Style="{StaticResource EstiloBotonVolverPremium}"
                        Click="BtnCerrarSelectorActualizar_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 9,1 L 1,8 L 9,15"
                              Stroke="White" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="VOLVER A CFW"
                                   FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="700">

                    <TextBlock Text="Elige cómo quieres actualizar"
                               FontSize="26" FontWeight="Black" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Selecciona el tipo de actualización que quieres aplicar a tu SD."
                               FontSize="12" Foreground="#505060"
                               HorizontalAlignment="Center" Margin="0,0,0,32"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ACTUALIZAR PAQUETE PREDEFINIDO -->
                        <Border x:Name="TarjetaActualizarPaquete" Grid.Column="0"
                                CornerRadius="16" BorderThickness="2" BorderBrush="#1A00D2FF"
                                Background="#0A0A14" Cursor="Hand" Padding="28,24"
                                RenderTransformOrigin="0.5,0.5"
                                MouseEnter="TarjetaSelectorActualizar_MouseEnter"
                                MouseLeftButtonDown="TarjetaSelectorActualizar_MouseLeftButtonDown"
                                MouseLeftButtonUp="TarjetaActualizarPaquete_Click">
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="SombraActualizarPaquete" BlurRadius="28" ShadowDepth="0" Color="#00D2FF" Opacity="0"/>
                            </Border.Effect>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="SombraActualizarPaquete" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="SombraActualizarPaquete" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <StackPanel>
                                <Border Background="#1800D2FF" CornerRadius="6" Padding="10,4"
                                        HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <TextBlock Text="RECOMENDADO" FontSize="12" FontWeight="Bold" Foreground="#00D2FF"/>
                                </Border>
                                <TextBlock Text="Actualizar paquete predefinido" FontSize="20" FontWeight="Black"
                                           Foreground="White" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#606070" Margin="0,0,0,20"
                                           Text="Reinstala el conjunto de módulos recomendados con sus últimas versiones."/>
                                <TextBlock Text="✓  Módulos recomendados preconfigurados" FontSize="12" Foreground="#00D2FF" Margin="0,0,0,4"/>
                                <TextBlock Text="✓  Mantiene dependencias resueltas"       FontSize="12" Foreground="#00D2FF"/>
                            </StackPanel>
                        </Border>

                        <!-- ACTUALIZAR MODULOS -->
                        <Border x:Name="TarjetaActualizarModulos" Grid.Column="2"
                                CornerRadius="16" BorderThickness="2" BorderBrush="#1A707080"
                                Background="#0A0A14" Cursor="Hand" Padding="28,24"
                                RenderTransformOrigin="0.5,0.5"
                                MouseEnter="TarjetaSelectorActualizar_MouseEnter"
                                MouseLeftButtonDown="TarjetaSelectorActualizar_MouseLeftButtonDown"
                                MouseLeftButtonUp="TarjetaActualizarModulos_Click">
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="SombraActualizarModulos" BlurRadius="22" ShadowDepth="0" Color="#A0A0B0" Opacity="0"/>
                            </Border.Effect>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="SombraActualizarModulos" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="SombraActualizarModulos" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <StackPanel>
                                <Border Background="#14707080" CornerRadius="6" Padding="10,4"
                                        HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <TextBlock Text="AVANZADO" FontSize="12" FontWeight="Bold" Foreground="#707080"/>
                                </Border>
                                <TextBlock Text="Actualizar Módulos" FontSize="20" FontWeight="Black"
                                           Foreground="White" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#606070" Margin="0,0,0,20"
                                           Text="Muestra el catálogo filtrado solo con los módulos que tienen una versión más reciente disponible."/>
                                <TextBlock Text="✓  Solo módulos con actualización" FontSize="12" Foreground="#707080" Margin="0,0,0,4"/>
                                <TextBlock Text="✓  Elige cuáles actualizar"         FontSize="12" Foreground="#707080"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Backdrop invisible para VentanaPersonalizacion de Hekate.
                 Bloquea hover/click del fondo y cierra la ventana al hacer
                 click fuera, manteniendo la UX igual que los overlays modales. -->
            <Grid x:Name="PanelPersonalizacionBackdrop"
                  Grid.Row="0" Grid.RowSpan="2"
                  Grid.Column="0" Grid.ColumnSpan="3"
                  Visibility="Collapsed"
                  Panel.ZIndex="902">
                <Border Background="Transparent"
                        MouseLeftButtonDown="PanelPersonalizacionBackdrop_MouseDown"/>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════════════
                 OVERLAY: Formateo FAT32 — frosted glass + SafeButton hold-to-confirm.
                 Lee la SD activa del panel derecho (no tiene combo propio). Sin
                 botón ✕ ni Refrescar: cierra con click fuera o desconexión de la SD.
                 La pantalla de carga global (OverlayCarga) muestra el progreso.
                 ══════════════════════════════════════════════════════════════════ -->
            <Grid x:Name="PanelFormatoFAT32Overlay"
                  Grid.Row="0" Grid.RowSpan="2"
                  Grid.Column="0" Grid.ColumnSpan="3"
                  Visibility="Collapsed"
                  Panel.ZIndex="860">

                <!-- Backdrop: click fuera = cerrar -->
                <Border Background="{StaticResource OverlayBackdropBrush}"
                        MouseLeftButtonDown="PanelFormato_BackdropClick"/>

                <Border Style="{StaticResource EstiloOverlayPanel}" Width="520" Height="520">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header cian -->
                        <Border Grid.Row="0" Style="{StaticResource EstiloOverlayHeader}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{StaticResource OverlayAcentoCian}"
                                        Margin="0,0,12,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00D2FF" BlurRadius="10"
                                                          ShadowDepth="0" Opacity="0.9"/>
                                    </Border.Effect>
                                </Border>
                                <TextBlock Text="FORMATEAR EN FAT32"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource OverlayAcentoCian}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Cuerpo -->
                        <StackPanel Grid.Row="1" Margin="28,22,28,18"
                                    VerticalAlignment="Center">

                            <!-- Tarjeta SD (read-only desde panel derecho) -->
                            <Border Style="{StaticResource EstiloOverlayTarjetaSD}"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#1400D2FF" CornerRadius="8"
                                            Padding="14,4" Margin="0,0,14,0">
                                        <TextBlock x:Name="TxtLetraSDFormato"
                                                   Text="—" FontSize="26" FontWeight="Black"
                                                   Foreground="{StaticResource OverlayAcentoCian}"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtNombreSDFormato"
                                                   Text="Sin SD seleccionada"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource OverlayTextoTitulo}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtInfoSDFormato"
                                                   Text="Selecciona una SD en el panel derecho"
                                                   FontSize="12"
                                                   Foreground="{StaticResource OverlayTextoSecundario}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Image Grid.Column="2"
                                           Width="30" Height="30" Stretch="Uniform"
                                           Opacity="0.9"
                                           ToolTip="microSD"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoMicroSDUrl, Converter={StaticResource IconoCacheConverter}}"/>
                                </Grid>
                            </Border>

                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="ETIQUETA DE VOLUMEN"
                                           Foreground="{StaticResource OverlayTextoApagado}"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <Border CornerRadius="12"
                                        Background="#111621"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="1"
                                        Height="40"
                                        Padding="12,0">
                                    <TextBox x:Name="TxtEtiquetaFormato"
                                             Text="SWITCH SD"
                                             MaxLength="11"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="White"
                                             CaretBrush="#00D2FF"
                                             FontSize="13"
                                             FontWeight="Bold"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             FocusVisualStyle="{x:Null}"/>
                                </Border>
                            </StackPanel>

                            <!-- Aviso amber: visible cuando no hay SD válida -->
                            <Border x:Name="AvisoSinSDFormato"
                                    Style="{StaticResource EstiloOverlayAviso}"
                                    Margin="0,0,0,14"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠" FontSize="16"
                                               Foreground="{StaticResource OverlayAcentoAmber}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="#C0A050"
                                               FontSize="12" VerticalAlignment="Center">
                                        Selecciona una <Run FontWeight="Bold" Foreground="{StaticResource OverlayAcentoAmber}">microSD</Run> en el panel derecho para continuar.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Warning destructivo: visible siempre (es destructivo) -->
                            <Border Style="{StaticResource EstiloOverlayWarning}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚠" FontSize="18" Foreground="#FF6B6B"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="#FFD0D0"
                                               FontSize="13" LineHeight="20" VerticalAlignment="Center">
                                        <Run FontWeight="Bold" Foreground="#EF4444">ATENCIÓN:</Run>
                                        <Run>se BORRARÁN todos los datos de la microSD.</Run>
                                        <Run>La unidad quedará formateada como</Run>
                                        <Run FontWeight="Bold" Foreground="White">FAT32 con etiqueta "</Run><Run FontWeight="Bold" Foreground="White" Text="{Binding Text, ElementName=TxtEtiquetaFormato}"/><Run FontWeight="Bold" Foreground="White">"</Run><Run>.</Run>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Footer -->
                        <Border Grid.Row="2" Style="{StaticResource EstiloOverlayFooter}">
                            <Grid>
                                <TextBlock x:Name="TxtEstadoFormato"
                                           Text="Mantén pulsado para confirmar"
                                           Foreground="{StaticResource OverlayTextoApagado}"
                                           FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>

                                <controles:SafeButton x:Name="BtnFormatearAhora"
                                        HorizontalAlignment="Center"
                                        IsEnabled="False"
                                        Width="220" Height="44"
                                        HoldTimeSeconds="2"
                                        IsSafeMode="True"
                                        Style="{StaticResource EstiloBotonEliminarHold}"
                                        Click="BtnFormatearAhora_Click">
                                    <TextBlock Text="FORMATEAR"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </controles:SafeButton>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════════════
                 OVERLAY: Particionado y Formateo SD — frosted glass, acento púrpura.
                 Lee SD del panel derecho. Sin botones ✕ ni Refrescar: cierra con
                 click fuera o desconexión de la SD. La pantalla de carga global
                 (OverlayCarga) muestra el progreso de la operación.
                 ══════════════════════════════════════════════════════════════════ -->
            <Grid x:Name="PanelParticionadoOverlay"
                  Grid.Row="0" Grid.RowSpan="2"
                  Grid.Column="0" Grid.ColumnSpan="3"
                  Visibility="Collapsed"
                  Panel.ZIndex="870">

                <!-- Backdrop: click fuera = cerrar -->
                <Border Background="{StaticResource OverlayBackdropBrush}"
                        MouseLeftButtonDown="PanelParticionado_BackdropClick"/>

                <Border Style="{StaticResource EstiloOverlayPanel}" Width="620" Height="620">

                    <Border.Resources>
                        <!-- Slider con acento purple -->
                        <Style x:Key="SliderParticionado" TargetType="Slider">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Slider">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Height="6" CornerRadius="3"
                                                    Background="#1A1A28" Margin="8,0">
                                                <Border HorizontalAlignment="Left" CornerRadius="3"
                                                        Background="#BD00FF" Width="0"/>
                                            </Border>
                                            <Track Grid.Row="0" x:Name="PART_Track" Margin="0,-6,0,-6">
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Width="20" Height="20" CornerRadius="4"
                                                                        Background="#BD00FF"
                                                                        BorderBrush="#80FFFFFF" BorderThickness="1">
                                                                    <Border.Effect>
                                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0"
                                                                                          Color="#BD00FF" Opacity="0.8"/>
                                                                    </Border.Effect>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header púrpura -->
                        <Border Grid.Row="0" Style="{StaticResource EstiloOverlayHeader}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{StaticResource OverlayAcentoPurple}"
                                        Margin="0,0,12,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#BD00FF" BlurRadius="10"
                                                          ShadowDepth="0" Opacity="0.9"/>
                                    </Border.Effect>
                                </Border>
                                <TextBlock Text="PARTICIONAR Y FORMATEAR SD"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource OverlayAcentoPurple}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Cuerpo -->
                        <StackPanel Grid.Row="1" Margin="24,18,24,14"
                                    VerticalAlignment="Center">

                            <!-- Tarjeta SD (read-only desde panel derecho) -->
                            <Border Style="{StaticResource EstiloOverlayTarjetaSD}"
                                    Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#14BD00FF" CornerRadius="8"
                                            Padding="14,4" Margin="0,0,14,0">
                                        <TextBlock x:Name="TxtLetraSDParticionado"
                                                   Text="—" FontSize="26" FontWeight="Black"
                                                   Foreground="{StaticResource OverlayAcentoPurple}"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtNombreSDParticionado"
                                                   Text="Sin SD seleccionada"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource OverlayTextoTitulo}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtInfoSDParticionado"
                                                   Text="Selecciona una SD en el panel derecho"
                                                   FontSize="12"
                                                   Foreground="{StaticResource OverlayTextoSecundario}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Image Grid.Column="2"
                                           Width="30" Height="30" Stretch="Uniform"
                                           Opacity="0.9"
                                           ToolTip="microSD"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoMicroSDUrl, Converter={StaticResource IconoCacheConverter}}"/>
                                </Grid>
                            </Border>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="ETIQUETA DE VOLUMEN"
                                           Foreground="{StaticResource OverlayTextoApagado}"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <Border CornerRadius="12"
                                        Background="#111621"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="1"
                                        Height="40"
                                        Padding="12,0">
                                    <TextBox x:Name="TxtEtiquetaParticionado"
                                             Text="SWITCH SD"
                                             MaxLength="11"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="White"
                                             CaretBrush="#BD00FF"
                                             FontSize="13"
                                             FontWeight="Bold"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             FocusVisualStyle="{x:Null}"/>
                                </Border>
                            </StackPanel>

                            <!-- Aviso amber: visible cuando no hay SD válida -->
                            <Border x:Name="AvisoSinSDParticionado"
                                    Style="{StaticResource EstiloOverlayAviso}"
                                    Margin="0,0,0,16"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠" FontSize="16"
                                               Foreground="{StaticResource OverlayAcentoAmber}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="#C0A050"
                                               FontSize="12" VerticalAlignment="Center">
                                        Selecciona una <Run FontWeight="Bold" Foreground="{StaticResource OverlayAcentoAmber}">microSD</Run> en el panel derecho para continuar.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Tamaño emuMMC -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TAMAÑO EMUMMC" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource OverlayTextoApagado}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtGbValorParticionado"
                                               Text="12 GB" FontSize="30" FontWeight="Black"
                                               Foreground="{StaticResource OverlayAcentoPurple}"/>
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="BadgeRecParticionado"
                                        Background="#1400D2FF" CornerRadius="6"
                                        Padding="10,5" VerticalAlignment="Center" Margin="0,18,0,0">
                                    <TextBlock Text="RECOMENDADO" FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource OverlayAcentoPurple}"/>
                                </Border>
                            </Grid>

                            <Slider x:Name="SliderGbParticionado"
                                    Minimum="0" Maximum="7" Value="2"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Style="{StaticResource SliderParticionado}"
                                    ValueChanged="SliderGbParticionado_ValueChanged"
                                    Margin="0,0,0,6"/>

                            <Grid Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="4"  FontSize="10" Foreground="{StaticResource OverlayTextoApagado}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="8"  FontSize="10" Foreground="{StaticResource OverlayTextoApagado}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="12" FontSize="10" Foreground="{StaticResource OverlayAcentoPurple}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="16" FontSize="10" Foreground="{StaticResource OverlayTextoApagado}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="24" FontSize="10" Foreground="{StaticResource OverlayAcentoPurple}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="32" FontSize="10" Foreground="{StaticResource OverlayTextoApagado}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="48" FontSize="10" Foreground="{StaticResource OverlayTextoApagado}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="7" Text="64" FontSize="10" Foreground="{StaticResource OverlayTextoApagado}" HorizontalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="GB" FontSize="9"
                                       Foreground="{StaticResource OverlayTextoApagado}"
                                       HorizontalAlignment="Right" Margin="0,2,10,18"/>

                            <!-- Warning destructivo -->
                            <Border Style="{StaticResource EstiloOverlayWarning}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚠" FontSize="18" Foreground="#FF6B6B"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="#FFD0D0"
                                               FontSize="13" LineHeight="20" VerticalAlignment="Center">
                                        <Run FontWeight="Bold" Foreground="#EF4444">ATENCIÓN:</Run>
                                        <Run>se BORRARÁN todos los datos de la microSD.</Run>
                                        <Run>Quedará dividida en</Run>
                                        <Run FontWeight="Bold" Foreground="White" Text="{Binding Text, ElementName=TxtEtiquetaParticionado}"/><Run> y se instalarán los módulos recomendados.</Run>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Footer -->
                        <Border Grid.Row="2" Style="{StaticResource EstiloOverlayFooter}">
                            <Grid>
                                <TextBlock x:Name="TxtEstadoParticionado"
                                           Text="Mantén pulsado para confirmar"
                                           Foreground="{StaticResource OverlayTextoApagado}"
                                           FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>

                                <controles:SafeButton x:Name="BtnParticionarAhora"
                                        HorizontalAlignment="Center"
                                        IsEnabled="False"
                                        Width="240" Height="40"
                                        HoldTimeSeconds="2"
                                        IsSafeMode="True"
                                        Style="{StaticResource EstiloBotonEliminarHold}"
                                        Click="BtnParticionarAhora_Click">
                                    <TextBlock Text="FORMATEAR Y PARTICIONAR"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </controles:SafeButton>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════════════
                 OVERLAY: Asistido Completo — frosted glass, acento cian.
                 Particiona la SD del panel derecho + instala los módulos
                 recomendados (con sus dependencias) en una sola operación.
                 Lee SD del panel derecho. Sin ✕ ni Refrescar. La pantalla de
                 carga global muestra el progreso real de la operación.
                 ══════════════════════════════════════════════════════════════════ -->
            <Grid x:Name="PanelAsistidoCompletoOverlay"
                  Grid.Row="0" Grid.RowSpan="2"
                  Grid.Column="0" Grid.ColumnSpan="3"
                  Visibility="Collapsed"
                  Panel.ZIndex="880">

                <!-- Backdrop: click fuera = cerrar -->
                <Border Background="{StaticResource OverlayBackdropBrush}"
                        MouseLeftButtonDown="PanelAsistidoCompleto_BackdropClick"/>

                <Border Style="{StaticResource EstiloOverlayPanel}" Width="1140" MaxWidth="{Binding ActualWidth, ElementName=MainGrid}" Height="780">

                    <Border.Resources>
                        <!-- Selector de preset emuMMC (segmented control cian) -->
                        <Style x:Key="EstiloPresetEmuMMC" TargetType="RadioButton">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Height" Value="72"/>
                            <Setter Property="Foreground" Value="#707080"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Bd" CornerRadius="10" BorderThickness="1.5"
                                                Background="#0F0F18" BorderBrush="#252530">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1400D2FF"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource OverlayAcentoCian}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4000D2FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Tarjeta de módulo recomendado (cian) -->
                        <DataTemplate x:Key="PlantillaModuloRecomendado">
                            <Border x:Name="BdMod" CornerRadius="10" BorderThickness="1"
                                    Padding="12,10" Margin="0,0,8,8"
                                    Background="#0F0F18" BorderBrush="#3300D2FF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Seleccionado, Mode=TwoWay}"
                                              Style="{StaticResource EstiloToggleSwitch}"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="7"
                                            Margin="0,0,10,0" Background="#14FFFFFF">
                                        <Image Source="{Binding Modulo.IconoUrl, Converter={StaticResource IconoCacheConverter}}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Modulo.Nombre}" TextTrimming="CharacterEllipsis"
                                                   FontSize="13" FontWeight="Bold" Foreground="White"/>
                                        <Border Background="#1400D2FF" CornerRadius="4"
                                                Padding="5,1" Margin="0,3,0,0"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding VersionFijadaVisible}">
                                            <TextBlock Text="{Binding EtiquetaVersion}"
                                                       FontSize="8" Foreground="#00D2FF" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Seleccionado}" Value="False">
                                    <Setter TargetName="BdMod" Property="Opacity" Value="0.45"/>
                                    <Setter TargetName="BdMod" Property="BorderBrush" Value="#252530"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

                        <!-- Tarjeta de dependencia (amber) -->
                        <DataTemplate x:Key="PlantillaModuloDependencia">
                            <Border CornerRadius="10" Background="#0C0C10"
                                    BorderBrush="#44FFD54A" BorderThickness="1"
                                    Padding="12,10" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="7"
                                            Margin="0,0,10,0" Background="#18FFD54A">
                                        <Image Source="{Binding IconoUrl, Converter={StaticResource IconoCacheConverter}}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nombre}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="#FFD54A"/>
                                        <TextBlock Text="dep. automática"
                                                   FontSize="9" Foreground="#806040"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </Border.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header cian -->
                        <Border Grid.Row="0" Style="{StaticResource EstiloOverlayHeader}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{StaticResource OverlayAcentoCian}"
                                            Margin="0,0,12,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00D2FF" BlurRadius="10"
                                                              ShadowDepth="0" Opacity="0.9"/>
                                        </Border.Effect>
                                    </Border>
                                    <TextBlock x:Name="TxtTituloAsistidoCompleto"
                                               Text="ASISTIDO COMPLETO"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource OverlayAcentoCian}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="BtnVolverAsistidoCompleto"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource EstiloBotonVolverPremium}"
                                        Click="BtnVolverAsistidoCompleto_Click"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 7,1 L 1,6 L 7,11"
                                              Stroke="White" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="VOLVER"
                                                   FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Cuerpo: izquierda = destino y opciones, derecha = contenido -->
                        <Grid Grid.Row="1" Margin="24,20,24,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="420"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                                <!-- Tarjeta SD (read-only) / Ruta de descarga en modo PC -->
                                <Border x:Name="TarjetaSDAsistido" Style="{StaticResource EstiloOverlayTarjetaSD}"
                                        Margin="0,0,0,18"
                                        MouseLeftButtonDown="TarjetaSDAsistido_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="52" Height="52"
                                                Background="#1400D2FF" CornerRadius="10"
                                                Margin="0,0,14,0" VerticalAlignment="Center">
                                            <Grid>
                                            <Path x:Name="ImgIconoSDAsistido" Width="24" Height="30" Stretch="Uniform"
                                                  Data="M 3,0 L 14,0 L 14,3 L 17,3 L 17,8 L 20,11 L 20,28 Q 20,30 18,30 L 2,30 Q 0,30 0,28 L 0,2 Q 0,0 2,0 Z"
                                                  Fill="Transparent" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                  Stroke="{StaticResource OverlayAcentoCian}"/>
                                            <TextBlock x:Name="TxtIconoCarpetaAsistido" Text="📁" FontSize="28"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtTituloDestinoAsistido" Text="Destino" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource OverlayTextoApagado}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                <TextBlock x:Name="TxtNombreSDAsistido"
                                                           Text="Sin SD seleccionada"
                                                           FontSize="16" FontWeight="Bold"
                                                           Foreground="{StaticResource OverlayTextoTitulo}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="200"/>
                                                <Border Background="#1400D2FF" CornerRadius="5" Padding="6,0"
                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtLetraSDAsistido"
                                                               Text="—" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource OverlayAcentoCian}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtInfoSDAsistido"
                                                       Text="Selecciona una SD en el panel derecho"
                                                       FontSize="12"
                                                       Foreground="{StaticResource OverlayTextoSecundario}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Border x:Name="BtnCambiarDestinoAsistido" Grid.Column="2" CornerRadius="8" Padding="12,6"
                                                BorderThickness="1" VerticalAlignment="Center" Cursor="Hand"
                                                Visibility="Collapsed">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1400D2FF"/>
                                                    <Setter Property="BorderBrush" Value="#6600D2FF"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#3300D2FF"/>
                                                            <Setter Property="BorderBrush" Value="#00D2FF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock x:Name="TxtBtnCambiarDestinoAsistido" Text="Elegir carpeta" FontSize="11" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Aviso amber: visible cuando no hay SD válida -->
                                <Border x:Name="AvisoSinSDAsistido"
                                        Style="{StaticResource EstiloOverlayAviso}"
                                        Margin="0,0,0,16"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠" FontSize="16"
                                                   Foreground="{StaticResource OverlayAcentoAmber}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="TxtAvisoSinSDAsistido" TextWrapping="Wrap"
                                                   Foreground="#C0A050"
                                                   FontSize="12" VerticalAlignment="Center">
                                            Selecciona una <Run FontWeight="Bold" Foreground="{StaticResource OverlayAcentoAmber}">microSD</Run> en el panel derecho para continuar.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Controles exclusivos del modo Instalación Completa -->
                                <StackPanel x:Name="PanelOpcionesFormato">

                                <StackPanel Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource OverlayAcentoCian}" Margin="0,0,10,0">
                                            <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#0D0D12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Nombre de la microSD" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Así aparecerá la tarjeta en Windows. Puedes dejarlo como está."
                                               FontSize="11" Foreground="{StaticResource OverlayTextoSecundario}"
                                               Margin="30,0,0,8"/>
                                    <Border CornerRadius="12"
                                            Background="#111621"
                                            BorderBrush="#26FFFFFF"
                                            BorderThickness="1"
                                            Height="40"
                                            Padding="12,0">
                                        <TextBox x:Name="TxtEtiquetaAsistido"
                                                 Text="SWITCH SD"
                                                 MaxLength="11"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="White"
                                                 CaretBrush="#BD00FF"
                                                 FontSize="13"
                                                 FontWeight="Bold"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 FocusVisualStyle="{x:Null}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Tamaño emuMMC: selectores preestablecidos -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource OverlayAcentoCian}" Margin="0,0,10,0">
                                                <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="#0D0D12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Espacio reservado para emuMMC" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Es una copia de la consola que vive en la microSD. Si no sabes cuál elegir, deja 12 GB."
                                                   FontSize="11" Foreground="{StaticResource OverlayTextoSecundario}"
                                                   TextWrapping="Wrap" Margin="30,0,80,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtGbValorAsistido"
                                               Text="12 GB" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource OverlayAcentoCian}"/>
                                </Grid>

                                <UniformGrid Columns="4" Margin="0,0,0,20">
                                    <RadioButton x:Name="BtnPreset12" GroupName="EmuMMCAsistido"
                                                 Tag="12" IsChecked="True" Margin="0,0,8,0"
                                                 Style="{StaticResource EstiloPresetEmuMMC}"
                                                 Checked="PresetEmuMMC_Checked">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="12" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="GB" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Opacity="0.75"/>
                                            <Border Background="#1400D2FF" CornerRadius="4" Padding="6,1"
                                                    Margin="0,4,0,0" HorizontalAlignment="Center">
                                                <TextBlock Text="RECOMENDADO" FontSize="7" FontWeight="Bold"
                                                           Foreground="{StaticResource OverlayAcentoCian}"/>
                                            </Border>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="BtnPreset24" GroupName="EmuMMCAsistido"
                                                 Tag="24" Margin="0,0,8,0"
                                                 Style="{StaticResource EstiloPresetEmuMMC}"
                                                 Checked="PresetEmuMMC_Checked">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="24" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="GB" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Opacity="0.75"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="BtnPreset32" GroupName="EmuMMCAsistido"
                                                 Tag="32" Margin="0,0,8,0"
                                                 Style="{StaticResource EstiloPresetEmuMMC}"
                                                 Checked="PresetEmuMMC_Checked">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="32" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="GB" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Opacity="0.75"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="BtnPreset64" GroupName="EmuMMCAsistido"
                                                 Tag="64"
                                                 Style="{StaticResource EstiloPresetEmuMMC}"
                                                 Checked="PresetEmuMMC_Checked">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="64" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
                                            <TextBlock Text="GB" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Opacity="0.75"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>

                                </StackPanel>
                                <!-- / PanelOpcionesFormato -->

                                    <!-- Firmware opcional: se ilumina al marcarlo -->
                                    <Border x:Name="PanelFirmwareAsistido"
                                            CornerRadius="12" BorderThickness="1.5"
                                            Padding="16,14" Margin="0,0,0,14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#33FFD700"/>
                                                <Setter Property="Background" Value="#05FFD700"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ChkIncluirFirmware}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FFD700"/>
                                                        <Setter Property="Background" Value="#22FFD700"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#FFD700" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox x:Name="ChkIncluirFirmware"
                                                              Style="{StaticResource EstiloToggleSwitch}"
                                                              Checked="ChkIncluirFirmware_Changed"
                                                              Unchecked="ChkIncluirFirmware_Changed"/>
                                                    <TextBlock Text="Añadir firmware oficial"
                                                               Foreground="#FFD700" FontSize="12" FontWeight="Bold"
                                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtInfoFirmwareAsistido"
                                                           FontSize="11" Foreground="#C0B080" TextWrapping="Wrap" Margin="54,4,0,0"
                                                           Text="Sirve para actualizar la versión de la consola. Si no lo necesitas, déjalo apagado."/>
                                            </StackPanel>
                                            <ComboBox x:Name="ComboVersionFirmware" Grid.Column="1"
                                                      Style="{StaticResource EstiloComboOscuro}"
                                                      DisplayMemberPath="Version"
                                                      Width="140" Height="28" Margin="12,0,0,0"
                                                      VerticalAlignment="Center" IsEnabled="False"/>
                                        </Grid>
                                    </Border>

                                    <!-- Aviso destructivo -->
                                    <Border x:Name="WarningDestructivoAsistido"
                                            CornerRadius="12" BorderThickness="1"
                                            BorderBrush="#99EF4444" Background="#1AEF4444"
                                            Padding="16,14" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="⚠" FontSize="24" Foreground="#FF6B6B"
                                                       VerticalAlignment="Top" Margin="0,0,14,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Se borrarán todos los datos" FontSize="15"
                                                           FontWeight="Bold" Foreground="#FF6B6B" Margin="0,0,0,6"/>
                                                <TextBlock TextWrapping="Wrap" Foreground="#E0C0C0" FontSize="12" LineHeight="18">
                                                    <Run>La microSD será formateada y se eliminarán todos sus datos. Se llamará</Run>
                                                    <Run FontWeight="Bold" Foreground="White" Text="{Binding Text, ElementName=TxtEtiquetaAsistido}"/><Run>&#x00A0;y se instalarán los módulos seleccionados.</Run>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    </StackPanel>
                                    </ScrollViewer>

                                    <!-- Columna derecha: contenido del paquete -->
                                    <Border Grid.Column="2" CornerRadius="14" Background="#0A0A10"
                                            BorderBrush="#22FFFFFF" BorderThickness="1" Padding="18,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="5" Height="16" CornerRadius="3"
                                                        Background="{StaticResource OverlayAcentoCian}" Margin="0,0,10,0"/>
                                                <TextBlock Text="Contenido del paquete"
                                                           FontSize="16" FontWeight="Bold" Foreground="White"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtContadorModulosAsistido"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource OverlayAcentoCian}"/>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                            <TextBlock Text="Desmarca lo que no quieras instalar. Lo necesario para que funcione se añade solo."
                                                       FontSize="11" Foreground="{StaticResource OverlayTextoSecundario}"
                                                       TextWrapping="Wrap" Margin="15,0,0,10"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="10" Background="#111621" BorderBrush="#26FFFFFF"
                                                        BorderThickness="1" Height="36" Padding="12,0">
                                                    <Grid>
                                                        <TextBlock x:Name="TxtPlaceholderBuscarAsistido"
                                                                   Text="🔍  Buscar módulos..." FontSize="12"
                                                                   Foreground="#606070" VerticalAlignment="Center"
                                                                   IsHitTestVisible="False"/>
                                                        <TextBox x:Name="TxtBuscarModuloAsistido"
                                                                 Background="Transparent" BorderThickness="0"
                                                                 Foreground="White" CaretBrush="#00D2FF"
                                                                 FontSize="12" VerticalContentAlignment="Center"
                                                                 FocusVisualStyle="{x:Null}"
                                                                 TextChanged="TxtBuscarModuloAsistido_TextChanged"/>
                                                    </Grid>
                                                </Border>
                                                <Button x:Name="BtnMarcarTodosAsistido" Grid.Column="1"
                                                        Content="Desmarcar todos" Margin="10,0,0,0"
                                                        Height="36" Padding="14,0" Cursor="Hand"
                                                        Background="#111621" Foreground="#C0C0D0"
                                                        BorderBrush="#26FFFFFF" BorderThickness="1"
                                                        FontSize="11" FontWeight="SemiBold"
                                                        Click="BtnMarcarTodosAsistido_Click"/>
                                            </Grid>
                                        </StackPanel>

                                        <ScrollViewer x:Name="ScrollModulosAsistido" Grid.Row="2"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <ItemsControl x:Name="ListaModulosAsistido"
                                                              ItemTemplate="{StaticResource PlantillaModuloRecomendado}"
                                                              Margin="0,0,0,14">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>

                                    <!-- Dependencias automáticas (amber) -->
                                    <Border x:Name="PanelDepsAsistido"
                                            Visibility="Collapsed"
                                            CornerRadius="12" BorderThickness="1"
                                            BorderBrush="#55FFD54A" Background="#06FFD54A"
                                            Padding="16,14" Margin="0,0,0,12">
                                        <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="5" Height="14" CornerRadius="3"
                                                    Background="{StaticResource OverlayAcentoAmber}" Margin="0,0,10,0"/>
                                            <TextBlock Text="TAMBIÉN SE AÑADIRÁ (NECESARIO)"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource OverlayAcentoAmber}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock FontSize="11" Foreground="#A08050"
                                                   TextWrapping="Wrap" Margin="0,0,0,10">
                                            <Run>Estos módulos son requeridos por los principales y se instalarán automáticamente&#x00A0;</Run><Run FontWeight="Bold" Foreground="{StaticResource OverlayAcentoAmber}">antes</Run><Run>&#x00A0;que el resto.</Run>
                                        </TextBlock>
                                        <ItemsControl x:Name="ListaDepsAsistido"
                                                      ItemTemplate="{StaticResource PlantillaModuloDependencia}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <TextBlock x:Name="TxtDepsRequierenPor"
                                                   Visibility="Collapsed"
                                                   FontSize="10" Foreground="#806040"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                                   FontStyle="Italic"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        </Border>
                        </Grid>


                        <!-- Footer -->
                        <Border Grid.Row="3" Style="{StaticResource EstiloOverlayFooter}">
                            <Grid>
                                <TextBlock x:Name="TxtEstadoAsistido"
                                           Text="Mantén pulsado para confirmar"
                                           Foreground="{StaticResource OverlayTextoApagado}"
                                           FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>

                                <controles:SafeButton x:Name="BtnIniciarAsistido"
                                        HorizontalAlignment="Center"
                                        IsEnabled="False"
                                        Width="240" Height="40"
                                        HoldTimeSeconds="2"
                                        IsSafeMode="True"
                                        Style="{StaticResource EstiloBotonEliminarHold}"
                                        Click="BtnIniciarAsistido_Click">
                                    <TextBlock x:Name="TxtBtnIniciarAsistido"
                                               Text="INICIAR PROCESO COMPLETO"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </controles:SafeButton>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════════════
                 OVERLAY: Dependencias — Frosted glass con tarjetas reales del catálogo.
                 El blur del MainGrid + el fondo semitransparente crean el efecto de
                 vidrio empañado. Las tarjetas usan exactamente la misma PlantillaModuloGamer
                 del catálogo, por lo que el progreso de instalación es visible en cada una.
                 ══════════════════════════════════════════════════════════════════ -->
            <Grid x:Name="PanelDependenciasOverlay"
                  Grid.Row="0" Grid.RowSpan="2"
                  Grid.Column="0" Grid.ColumnSpan="3"
                  Visibility="Collapsed"
                  Panel.ZIndex="850">

            <!-- Backdrop: click fuera = cerrar (sólo si no hay instalación activa) -->
            <Border Background="#CC000008"
                    MouseLeftButtonDown="OverlayDepsBackdrop_MouseDown"/>

            <!-- ═══════════════════════════════════════════════
                 Mesa de crafteo — Minecraft style
                 ═══════════════════════════════════════════════ -->
            <Border x:Name="PanelCrafteo"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="20"
                    BorderThickness="2"
                    Background="#0C0C1A">
                <Border.BorderBrush>
                    <SolidColorBrush x:Name="PincelBordeCrafteo" Color="#2A2A40"/>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="0"
                                      Color="Black" Opacity="0.97"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- header amber -->
                        <RowDefinition Height="Auto"/>  <!-- crafteo -->
                        <RowDefinition Height="Auto"/>  <!-- status -->
                    </Grid.RowDefinitions>

                    <!-- Header amber -->
                    <Border Grid.Row="0"
                            Background="#08FFFFFF"
                            CornerRadius="18,18,0,0"
                            Padding="24,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4"
                                    Background="#FFD54A" Margin="0,0,10,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFD54A" BlurRadius="10"
                                                      ShadowDepth="0" Opacity="0.9"/>
                                </Border.Effect>
                            </Border>
                            <TextBlock Text="INSTALAR DEPENDENCIAS"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#FFD54A" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Cuerpo: tres columnas (ingredientes | flecha | resultado) -->
                    <Grid Grid.Row="1" Margin="28,20,28,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- ingredientes -->
                            <ColumnDefinition Width="110"/>   <!-- flecha -->
                            <ColumnDefinition Width="Auto"/>  <!-- resultado -->
                        </Grid.ColumnDefinitions>

                        <!-- ── INGREDIENTES (deps B, C…) ── -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="DEPENDENCIAS"
                                       Foreground="#404060" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>

                            <Border Grid.Row="1"
                                    Background="#080812"
                                    CornerRadius="12" BorderThickness="2" Padding="4">
                                <Border.BorderBrush>
                                    <SolidColorBrush x:Name="PincelBordeIngredientes" Color="#1A1A30"/>
                                </Border.BorderBrush>
                                <!-- Cards de deps con botones activos -->
                                <ItemsControl x:Name="ListaDepOverlay"
                                              IsHitTestVisible="True"
                                              ButtonBase.Click="DepCatalogo_ClickBoton"
                                              ItemTemplate="{StaticResource PlantillaModuloGamer}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Center" MaxWidth="700"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Border>

                            <!-- Botón instalar todo -->
                            <Button Grid.Row="3"
                                    x:Name="BtnInstalarTodoDeps"
                                    Content="INSTALAR TODO"
                                    HorizontalAlignment="Stretch"
                                    Height="36"
                                    Style="{StaticResource EstiloBotonTarjetaInstalar}"
                                    Click="BtnInstalarTodoDeps_Click"/>
                        </Grid>

                        <!-- ── FLECHA (animada al desbloquear A) ── -->
                        <Grid Grid.Column="1"
                              VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path x:Name="FlechaCrafteo"
                                  Data="M 0,0 L 52,0 M 37,-13 L 52,0 L 37,13"
                                  StrokeThickness="3.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round">
                                <Path.Stroke>
                                    <SolidColorBrush x:Name="PincelFlecha" Color="#1E1E38"/>
                                </Path.Stroke>
                                <Path.Effect>
                                    <DropShadowEffect x:Name="GlowFlecha"
                                                      Color="#40C057" BlurRadius="0"
                                                      ShadowDepth="0" Opacity="0"/>
                                </Path.Effect>
                            </Path>
                        </Grid>

                        <!-- ── RESULTADO (módulo A, apagado hasta que deps listas) ── -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">

                            <TextBlock Text="RESULTADO"
                                       Foreground="#404060" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>

                            <Border x:Name="BordeResultado"
                                    Background="#080812"
                                    CornerRadius="12" BorderThickness="2" Padding="4">
                                <Border.BorderBrush>
                                    <SolidColorBrush x:Name="PincelBordeResultado" Color="#1A1A30"/>
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="GlowResultado"
                                                      Color="#40C057" BlurRadius="0"
                                                      ShadowDepth="0" Opacity="0"/>
                                </Border.Effect>

                                <!-- A: apagada (Opacity baja, IsHitTestVisible=False)
                                     Se enciende cuando todos los ingredientes están listos -->
                                <Grid x:Name="ContenedorResultadoA"
                                      Opacity="0.28"
                                      IsHitTestVisible="False"
                                      ButtonBase.Click="ResultadoCatalogo_ClickBoton">
                                    <ItemsControl x:Name="ListaResultadoA"
                                                  IsHitTestVisible="True"
                                                  ItemTemplate="{StaticResource PlantillaModuloGamer}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <!-- Botón instalar sin dependencias (hold-to-confirm) -->
                            <controles:SafeButton x:Name="BtnInstalarSinDeps"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    HoldTimeSeconds="2"
                                    IsSafeMode="True"
                                    Style="{StaticResource EstiloBotonSinDepsHold}"
                                    Click="BtnInstalarSinDeps_Click">
                                <TextBlock Text="INSTALAR SIN DEPENDENCIAS"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </controles:SafeButton>

                        </StackPanel>
                    </Grid>

                    <!-- Status strip -->
                    <Border Grid.Row="2"
                            Background="#060610"
                            CornerRadius="0,0,18,18"
                            Padding="28,10">
                        <TextBlock x:Name="TxtEstadoCrafteo"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#606075"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════
                 OVERLAY: Limpiar Micro SD / Preparar actualización
                 Flujo en 3 columnas: Se borrará · Se conserva · Se instalará
                 ══════════════════════════════════════════════ -->
            <Grid x:Name="PanelLimpiezaSDOverlay"
                  Grid.Row="0" Grid.RowSpan="2"
                  Grid.Column="0" Grid.ColumnSpan="3"
                  Visibility="Collapsed"
                  Panel.ZIndex="905">
                <Grid.Resources>
                    <Geometry x:Key="GeoCandadoLimpieza">M4,9 L4,6 A4,4 0 0 1 12,6 L12,9 M2.5,9 L13.5,9 L13.5,16 L2.5,16 Z M8,11.5 L8,13.5</Geometry>
                    <Geometry x:Key="GeoPapeleraLimpieza">M2,4 L14,4 M6,4 L6,2 L10,2 L10,4 M3.5,4 L4.5,15 L11.5,15 L12.5,4 M6.5,7 L6.5,12 M9.5,7 L9.5,12</Geometry>
                    <Geometry x:Key="GeoDescargaLimpieza">M8,2 L8,11 M4.5,7.5 L8,11 L11.5,7.5 M2,14 L14,14</Geometry>

                    <Style x:Key="EstiloChipLimpieza" TargetType="Button">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="#00D2FF"/>
                        <Setter Property="Background" Value="#1000D2FF"/>
                        <Setter Property="BorderBrush" Value="#4000D2FF"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="6" Padding="8,3"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3300D2FF"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#00D2FF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="EstiloBotonSecundarioLimpieza" TargetType="Button">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="#D0D0D8"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="10" Padding="22,0"
                                            Background="#14141C" BorderBrush="#33FFFFFF" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#22222E"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#88FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <Border Background="#CC000008"
                        MouseLeftButtonDown="LimpiezaSD_BackdropClick"/>

                <Border Style="{StaticResource EstiloOverlayPanel}" Width="1200" MaxHeight="860" Margin="0,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Style="{StaticResource EstiloOverlayHeader}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{StaticResource OverlayAcentoAmber}"
                                            Margin="0,0,10,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FFD54A" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                        </Border.Effect>
                                    </Border>
                                    <TextBlock x:Name="TxtTituloLimpiezaSD" Text="LIMPIAR MICRO SD" Foreground="White"
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource EstiloChipLimpieza}"
                                            Foreground="#A0A0B0" Background="Transparent" BorderBrush="#33FFFFFF"
                                            Margin="0,0,10,0"
                                            ToolTip="Elegir qué carpetas y archivos se conservan siempre"
                                            Click="LimpiezaSD_AbrirAjustes_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeoCandadoLimpieza}" Stroke="#A0A0B0"
                                                  StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Gestionar elementos conservados"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="✕" Width="30" Height="30" Margin="0,0,10,0"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#707080" FontSize="13" Cursor="Hand"
                                            ToolTip="Cerrar sin hacer cambios"
                                            Click="LimpiezaSD_Cerrar_Click"
                                            Style="{StaticResource EstiloBotonTopBar}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Contexto + KPIs -->
                        <StackPanel Grid.Row="1" Margin="24,16,24,0">
                            <Border x:Name="PanelLimpiezaSDContextoActualizacion"
                                    Visibility="Collapsed"
                                    CornerRadius="10" Background="#0A1A22"
                                    BorderBrush="#3300D2FF" BorderThickness="1"
                                    Padding="16,12" Margin="0,0,0,14">
                                <TextBlock x:Name="TxtSubtituloContextoActualizacion"
                                           TextWrapping="Wrap" Foreground="#C0C0D0" FontSize="12"
                                           Text="NX-SWITE analizó tu microSD. Para actualizar se hará una instalación limpia: revisa qué se borrará, qué se conserva y qué se instalará antes de continuar."/>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="12" Padding="18,12" Margin="0,0,10,0"
                                        Background="#1A0A0C" BorderBrush="#66EF4444" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoPapeleraLimpieza}" Stroke="#EF4444" StrokeThickness="1.6"
                                              Width="26" Height="26" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtKpiBorrar" Text="0" FontSize="28" FontWeight="Black"
                                                   Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Se borrarán" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="carpetas y archivos de la microSD" FontSize="10" Foreground="#A08080"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" CornerRadius="12" Padding="18,12" Margin="0,0,10,0"
                                        Background="#0A1620" BorderBrush="#5500D2FF" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoCandadoLimpieza}" Stroke="#00D2FF" StrokeThickness="1.6"
                                              Width="26" Height="26" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtKpiProtegido" Text="0" FontSize="28" FontWeight="Black"
                                                   Foreground="#00D2FF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Se conservan" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="no se tocarán" FontSize="10" Foreground="#80A0B0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="PanelResumenPaquete" Grid.Column="2"
                                        Visibility="Collapsed"
                                        CornerRadius="12" Padding="18,12"
                                        Background="#0F0F18" BorderBrush="#2A2A35" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Margin="0,0,22,0">
                                            <TextBlock x:Name="TxtResumenTotalModulos" Text="0" FontSize="20" FontWeight="Black"
                                                       Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock Text="módulos" FontSize="10" Foreground="#707080" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,22,0">
                                            <TextBlock x:Name="TxtResumenActualizaciones" Text="0" FontSize="20" FontWeight="Black"
                                                       Foreground="{StaticResource OverlayAcentoAmber}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="se actualizan" FontSize="10" Foreground="#707080" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock x:Name="TxtResumenPorInstalar" Text="0" FontSize="20" FontWeight="Black"
                                                       Foreground="#22C55E" HorizontalAlignment="Center"/>
                                            <TextBlock Text="nuevos" FontSize="10" Foreground="#707080" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Cuerpo: 3 columnas -->
                        <UniformGrid Grid.Row="2" Rows="1" Margin="24,16,24,12">

                            <!-- SE BORRARÁ -->
                            <Border CornerRadius="12" Background="#0E0A0C" BorderBrush="#44EF4444" BorderThickness="1"
                                    Margin="0,0,6,0" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeoPapeleraLimpieza}" Stroke="#EF4444" StrokeThickness="1.6"
                                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtEncabezadoBorrar" Text="SE BORRARÁ" Foreground="#EF4444"
                                                       FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtContadorBorrar" Text=" (0)"
                                                       Foreground="#A08080" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Se eliminará de la microSD. Pulsa «Conservar» en lo que quieras mantener."
                                                   Foreground="#A08080" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="ListaBorrar">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="8" Padding="10,6" Margin="0,0,4,4" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#160C0E"/>
                                                                    <Setter Property="BorderBrush" Value="#2A1518"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EsCritico}" Value="True">
                                                                            <Setter Property="Background" Value="#2A0A0A"/>
                                                                            <Setter Property="BorderBrush" Value="#EF4444"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Image Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                                                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Source"
                                                                                    Value="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoArchivoUrl, Converter={StaticResource IconoCacheConverter}}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Tipo}" Value="Carpeta">
                                                                                    <Setter Property="Source"
                                                                                            Value="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoCarpetaUrl, Converter={StaticResource IconoCacheConverter}}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Tipo}" Value="Comprimido">
                                                                                    <Setter Property="Source"
                                                                                            Value="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoZipUrl, Converter={StaticResource IconoCacheConverter}}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Nombre, Mode=OneWay}" FontSize="11.5"
                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#E0D0D0"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding EsCritico}" Value="True">
                                                                                        <Setter Property="Foreground" Value="#FF8A80"/>
                                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <Border CornerRadius="4" Background="#33EF4444" Padding="5,1" Margin="6,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            ToolTip="Carpeta importante del sistema de la consola">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding EsCritico}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="IMPORTANTE" FontSize="8.5" FontWeight="Bold" Foreground="#FF8A80"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Style="{StaticResource EstiloChipLimpieza}"
                                                                        Margin="6,0,0,0" VerticalAlignment="Center"
                                                                        ToolTip="No borrar: mover a «Se conserva»"
                                                                        Tag="{Binding Nombre, Mode=OneWay}"
                                                                        Click="BtnProtegerEntrada_Click">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Path Data="{StaticResource GeoCandadoLimpieza}" Stroke="#00D2FF" StrokeThickness="1.4"
                                                                              Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0"/>
                                                                        <TextBlock Text="Conservar"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock x:Name="TxtSinContenidoBorrar"
                                                   Text="No hay nada que borrar."
                                                   Foreground="#606070" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- SE CONSERVA -->
                            <Border CornerRadius="12" Background="#0A0F14" BorderBrush="#3300D2FF" BorderThickness="1"
                                    Margin="6,0,6,0" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeoCandadoLimpieza}" Stroke="#00D2FF" StrokeThickness="1.6"
                                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="SE CONSERVA" Foreground="#00D2FF"
                                                       FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtContadorProtegido" Text=" (0)"
                                                       Foreground="#80A0B0" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Esto se queda tal cual en la microSD (juegos, partidas, etc.)."
                                                   Foreground="#80A0B0" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="ListaProtegido">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="8" Background="#0C1620"
                                                                BorderBrush="#1A3040" BorderThickness="1"
                                                                Padding="10,6" Margin="0,0,4,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Path Grid.Column="0" Data="{StaticResource GeoCandadoLimpieza}"
                                                                      Stroke="#00D2FF" StrokeThickness="1.4"
                                                                      Width="13" Height="13" Stretch="Uniform"
                                                                      Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Nombre, Mode=OneWay}"
                                                                           Foreground="#A0D4F0" FontSize="11.5"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"/>
                                                                <Button Grid.Column="2" Style="{StaticResource EstiloChipLimpieza}"
                                                                        Foreground="#A0A0B0" Background="Transparent" BorderBrush="#33FFFFFF"
                                                                        Margin="6,0,0,0" VerticalAlignment="Center"
                                                                        Content="Quitar"
                                                                        ToolTip="Dejar de conservar: se borrará"
                                                                        Tag="{Binding Nombre, Mode=OneWay}"
                                                                        Click="BtnDesprotegerEntrada_Click"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <StackPanel x:Name="PanelSinProtegidos" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Visibility="Collapsed">
                                            <Path Data="{StaticResource GeoCandadoLimpieza}" Stroke="#405060" StrokeThickness="1.4"
                                                  Width="34" Height="34" Stretch="Uniform" Margin="0,0,0,10"/>
                                            <TextBlock Text="No se conserva nada" Foreground="#A0B0C0" FontSize="12" FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Todo lo de la columna roja se borrará. Usa «Conservar» para mantener algo."
                                                       Foreground="#607080" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center"
                                                       MaxWidth="260" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSinSD"
                                                   Text="Conecta una Micro SD para ver su contenido."
                                                   Foreground="#404050" FontSize="11"
                                                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>

                                    <StackPanel Grid.Row="2" x:Name="PanelContenidoAConservar" Margin="0,8,0,0">
                                        <ItemsControl x:Name="ListaContenidoAConservar"/>
                                        <Border x:Name="PanelTrucosDetectados"
                                                Visibility="Collapsed"
                                                CornerRadius="10" Background="#0C1620"
                                                BorderBrush="#1A3040" BorderThickness="1"
                                                Padding="12,10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Trucos (cheats)" FontSize="11.5" FontWeight="Bold" Foreground="#00D2FF"/>
                                                        <TextBlock x:Name="TxtResumenTrucos" Text="0 juegos · 0 archivos"
                                                                   FontSize="10" Foreground="#80A0B0"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="ChkPreservarTrucos" Grid.Column="1"
                                                              IsChecked="True"
                                                              Style="{StaticResource EstiloToggleSwitch}"
                                                              ToolTip="Conservar los trucos de tus juegos"
                                                              Click="ChkPreservarTrucos_Click"/>
                                                </Grid>
                                                <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                                    <ItemsControl x:Name="ListaTrucosDetectados">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding NombreJuego}" FontSize="11"
                                                                           Foreground="#D0D0D8" Margin="0,0,0,3"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SE INSTALARÁ (solo actualización) -->
                            <Border x:Name="ColumnaInstalarLimpieza"
                                    Visibility="Collapsed"
                                    CornerRadius="12" Background="#0A120E" BorderBrush="#3322C55E" BorderThickness="1"
                                    Margin="6,0,0,0" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeoDescargaLimpieza}" Stroke="#22C55E" StrokeThickness="1.8"
                                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="SE INSTALARÁ" Foreground="#22C55E"
                                                       FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Después de limpiar, se instala el paquete con estas versiones."
                                                   Foreground="#80A090" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <StackPanel x:Name="PanelSeccionActualizaciones" Visibility="Collapsed" Margin="0,0,0,12">
                                                <TextBlock Text="SE ACTUALIZA" Foreground="{StaticResource OverlayAcentoAmber}"
                                                           FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <ItemsControl x:Name="ListaActualizacionesModulos">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="8" Background="#14120A"
                                                                    BorderBrush="#33FFD54A" BorderThickness="1"
                                                                    Padding="10,6" Margin="0,0,4,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Nombre}" Foreground="White" FontSize="11.5"
                                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                               VerticalAlignment="Center"/>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding VersionInstalada}" Foreground="#707080" FontSize="10.5"/>
                                                                        <TextBlock Text="  →  " Foreground="{StaticResource OverlayAcentoAmber}" FontSize="10.5" FontWeight="Bold"/>
                                                                        <TextBlock Text="{Binding VersionNueva}" Foreground="{StaticResource OverlayAcentoAmber}" FontSize="10.5" FontWeight="Bold"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel x:Name="PanelSeccionPorInstalar" Visibility="Collapsed">
                                                <TextBlock Text="NUEVO" Foreground="#22C55E"
                                                           FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <ItemsControl x:Name="ListaPorInstalarModulos">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="8" Background="#0C160F"
                                                                    BorderBrush="#2222C55E" BorderThickness="1"
                                                                    Padding="10,6" Margin="0,0,4,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Nombre}" Foreground="White" FontSize="11.5"
                                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding VersionRecomendada}"
                                                                               Foreground="#22C55E" FontSize="10.5" FontWeight="Bold"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <!-- Footer: aviso + Cancelar + SafeButton -->
                        <Border Grid.Row="3" Background="#0A0A10" BorderBrush="#2A2A35" BorderThickness="0,1,0,0"
                                CornerRadius="0,0,15,15" Padding="24,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="⚠" Foreground="#EF4444" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center" MaxWidth="560">
                                        <TextBlock x:Name="TxtAvisoGeneralLimpieza" Foreground="#FCA5A5" FontSize="11.5" TextWrapping="Wrap">
                                            <Run FontWeight="Bold">Esta acción es irreversible.</Run>
                                            <Run>Lo de la columna roja se borrará de la microSD.</Run>
                                        </TextBlock>
                                        <TextBlock x:Name="TxtAdvertenciaCriticos"
                                                   Foreground="#FF6A3D" FontSize="11"
                                                   FontWeight="Bold" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Cancelar" Height="44" Margin="0,0,12,0"
                                        Style="{StaticResource EstiloBotonSecundarioLimpieza}"
                                        Click="LimpiezaSD_Cerrar_Click"/>
                                <controles:SafeButton x:Name="BtnConfirmarLimpiezaSD" Grid.Column="2"
                                        IsSafeMode="True"
                                        HoldTimeSeconds="2"
                                        Style="{StaticResource EstiloBotonEliminarHold}"
                                        Width="360" Height="44"
                                        Click="LimpiezaSD_Confirmar_Click">
                                    <TextBlock x:Name="TxtBtnConfirmarLimpiezaSD"
                                               Text="MANTÉN PULSADO PARA LIMPIAR SD"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </controles:SafeButton>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════
                 OVERLAY: Ajustes de usuario
                 ══════════════════════════════════════════════ -->
            <Grid x:Name="PanelAjustesOverlay"
                  Grid.Row="0" Grid.RowSpan="2"
                  Grid.Column="0" Grid.ColumnSpan="3"
                  Visibility="Collapsed"
                  Panel.ZIndex="910">

                <!-- Backdrop: click fuera = cerrar -->
                <Border Background="#CC000008"
                        MouseLeftButtonDown="BtnCerrarAjustes_Click"/>

                <!-- Panel flotante centrado -->
                <Border Style="{StaticResource EstiloOverlayPanel}"
                        Width="720" Height="520">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <!-- Barra de titulo -->
                        <Border Grid.Row="0"
                                Background="{StaticResource OverlayHeaderBackground}"
                                BorderThickness="0,0,0,1" BorderBrush="#1E1E28"
                                CornerRadius="18,18,0,0">
                            <Grid Margin="18,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{StaticResource OverlayAcentoCian}"
                                            Margin="0,0,10,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                        </Border.Effect>
                                    </Border>
                                    <TextBlock Text="AJUSTES" Foreground="White"
                                               FontSize="12" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Width="28" Height="28"
                                        Click="BtnCerrarAjustes_Click" ToolTip="Cerrar"
                                        Style="{StaticResource EstiloBotonTopBar}">
                                    <Path Data="M 5,5 L 19,19 M 19,5 L 5,19"
                                          Stroke="#707080" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Cuerpo: Sidebar + contenido -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sidebar -->
                            <Border Grid.Column="0" Background="#06060C" Padding="10,12">
                                <StackPanel>
                                    <TextBlock Text="CATEGORIAS" Foreground="#404050"
                                               FontSize="9" FontWeight="Bold" Margin="6,0,0,8"/>
                                    <RadioButton x:Name="TabSonido"
                                                 Content="  Sonido"
                                                 Style="{StaticResource EstiloTabAjuste}"
                                                 IsChecked="True"
                                                 Checked="TabAjuste_Checked"/>
                                    <RadioButton x:Name="TabCache"
                                                 Content="  Caché"
                                                 Style="{StaticResource EstiloTabAjuste}"
                                                 Checked="TabAjuste_Checked"/>
                                    <RadioButton x:Name="TabCarpetasProtegidas"
                                                 Content="  Carpetas protegidas"
                                                 Style="{StaticResource EstiloTabAjuste}"
                                                 Checked="TabAjuste_Checked"/>
                                    <RadioButton x:Name="TabGitHub"
                                                 Content="  GitHub Token"
                                                 Style="{StaticResource EstiloTabAjuste}"
                                                 Checked="TabAjuste_Checked"/>
                                </StackPanel>
                            </Border>

                            <Rectangle Grid.Column="1" Fill="#1E1E28"/>

                            <!-- Panel scrollable -->
                            <ScrollViewer Grid.Column="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="20,16,16,16">
                                <StackPanel>

                                    <StackPanel x:Name="PanelSonidoAjustes">

                                        <TextBlock Text="GENERAL" Style="{StaticResource EstiloCabeceraSeccion}"/>

                                        <Border Style="{StaticResource EstiloFilaAjuste}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Sonido activado" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Master switch - silencia todos los sonidos del programa."
                                                               Foreground="#505060" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox x:Name="SwSonidoActivo" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                                          Style="{StaticResource EstiloToggleSwitch}" Click="SwitchAjuste_Click"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="POR EVENTO" Style="{StaticResource EstiloCabeceraSeccion}"/>

                                        <Border Style="{StaticResource EstiloFilaAjuste}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Sonido de arranque" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Se reproduce al abrir la aplicacion." Foreground="#505060" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="SwIntro" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                                          Style="{StaticResource EstiloToggleSwitch}" Click="SwitchAjuste_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource EstiloFilaAjuste}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Hover" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Sonido al pasar el mouse por encima de botones y tarjetas."
                                                               Foreground="#505060" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox x:Name="SwHover" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                                          Style="{StaticResource EstiloToggleSwitch}" Click="SwitchAjuste_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource EstiloFilaAjuste}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Clic" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Sonido al hacer clic en botones." Foreground="#505060" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="SwClick" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                                          Style="{StaticResource EstiloToggleSwitch}" Click="SwitchAjuste_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource EstiloFilaAjuste}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Navegacion" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Sonido al cambiar de seccion o mundo." Foreground="#505060" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="SwNavegacion" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                                          Style="{StaticResource EstiloToggleSwitch}" Click="SwitchAjuste_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource EstiloFilaAjuste}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Instalacion" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Sonido al iniciar la instalacion de un modulo." Foreground="#505060" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="SwInstalar" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                                          Style="{StaticResource EstiloToggleSwitch}" Click="SwitchAjuste_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource EstiloFilaAjuste}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Exito" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Sonido al completar una operacion exitosamente." Foreground="#505060" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="SwExito" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                                          Style="{StaticResource EstiloToggleSwitch}" Click="SwitchAjuste_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource EstiloFilaAjuste}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Error" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Sonido al producirse un error en una operacion." Foreground="#505060" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="SwError" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                                          Style="{StaticResource EstiloToggleSwitch}" Click="SwitchAjuste_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource EstiloFilaAjuste}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Cerrar aplicacion" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Sonido al cerrar el programa." Foreground="#505060" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="SwCerrar" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                                          Style="{StaticResource EstiloToggleSwitch}" Click="SwitchAjuste_Click"/>
                                            </Grid>
                                        </Border>

                                    </StackPanel>

                                    <!-- SECCION: CACHE -->
                                    <StackPanel x:Name="PanelCacheAjustes" Visibility="Collapsed">

                                        <TextBlock Text="RESUMEN" Style="{StaticResource EstiloCabeceraSeccion}"/>

                                        <!-- Tarjeta ZIPs -->
                                        <Border Style="{StaticResource EstiloFilaAjuste}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Archivos comprimidos (ZIP)"
                                                               Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Total de archivos .zip, .7z y otros en la bóveda de caché."
                                                               Foreground="#505060" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="8"
                                                        Background="#0D2A35" Padding="12,4" Margin="12,0,0,0">
                                                    <TextBlock x:Name="TxtPesoZips"
                                                               Text="0 MB"
                                                               Foreground="{StaticResource AcentoCian}"
                                                               FontSize="13" FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Tarjeta extracción -->
                                        <Border Style="{StaticResource EstiloFilaAjuste}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Archivos descomprimidos"
                                                               Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Total de archivos extraidos listos para copiar a la SD."
                                                               Foreground="#505060" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="8"
                                                        Background="#0D2A35" Padding="12,4" Margin="12,0,0,0">
                                                    <TextBlock x:Name="TxtPesoExtraccion"
                                                               Text="0 MB"
                                                               Foreground="{StaticResource AcentoCian}"
                                                               FontSize="13" FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Botón limpiar todo -->
                                        <Border Margin="0,4,0,0" Padding="0,8,0,0">
                                            <Button x:Name="BtnLimpiarTodoCache"
                                                    Content="LIMPIAR TODO EL CACHE"
                                                    Style="{StaticResource EstiloBotonEliminar}"
                                                    HorizontalAlignment="Stretch"
                                                    Click="BtnLimpiarTodoCache_Click"/>
                                        </Border>

                                        <TextBlock Text="POR MODULO" Style="{StaticResource EstiloCabeceraSeccion}"/>

                                        <!-- Lista dinámica de módulos con caché -->
                                        <ItemsControl x:Name="ListaCacheModulos">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource EstiloFilaAjuste}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Nombre}"
                                                                           Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Detalle}"
                                                                           Foreground="#505060" FontSize="11" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Content="✕"
                                                                    Tag="{Binding}"
                                                                    Style="{StaticResource EstiloBotonEliminar}"
                                                                    Width="32" Height="32"
                                                                    Margin="12,0,0,0"
                                                                    FontSize="12"
                                                                    Click="BtnEliminarCacheModulo_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>

                                    <!-- SECCIÓN: CARPETAS PROTEGIDAS -->
                                    <StackPanel x:Name="PanelCarpetasProtegidas" Visibility="Collapsed">

                                    <TextBlock Text="ENTRADAS PROTEGIDAS AL LIMPIAR SD"
                                               Style="{StaticResource EstiloCabeceraSeccion}"/>

                                    <!-- Añadir manualmente (arriba) -->
                                    <Border Style="{StaticResource EstiloFilaAjuste}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtNuevaEntrada"
                                                     Grid.Column="0"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="White" FontSize="13"
                                                     CaretBrush="White"
                                                     VerticalAlignment="Center"
                                                     ToolTip="Nombre de carpeta o archivo (ej: atmosphere)"
                                                     KeyDown="TxtNuevaEntrada_KeyDown"/>
                                            <Button Grid.Column="1"
                                                    Content="+ Añadir"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#00D2FF"
                                                    FontSize="12" Cursor="Hand"
                                                    Padding="10,4"
                                                    Click="BtnAnadirEntradaProtegida_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- Descripción -->
                                    <Border Style="{StaticResource EstiloOverlayAviso}" Margin="0,0,0,10">
                                        <TextBlock Foreground="#C0A84A" FontSize="11" TextWrapping="Wrap">
                                            <Run FontWeight="Bold">Carpetas y archivos de la raíz de la SD que nunca se borrarán.</Run>
                                            <Run>Solo se muestran y protegen entradas de primer nivel.</Run>
                                        </TextBlock>
                                    </Border>

                                    <!-- Lista de entradas protegidas guardadas (sincronizada con el explorador) -->
                                    <!-- Solo visual: el toggle del explorador SD gestiona añadir/quitar -->

                                    <!-- Entradas guardadas que no existen físicamente en la SD -->
                                    <TextBlock x:Name="TxtCabeceraEntradasGuardadas"
                                               Style="{StaticResource EstiloCabeceraSeccion}"
                                               Visibility="Collapsed"/>
                                    <ItemsControl x:Name="ListaEntradasProtegidas" Visibility="Collapsed">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource EstiloFilaAjuste}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Icono de advertencia: esta entrada no existe en la SD -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="&#x26A0;"
                                                                   FontSize="12" Margin="0,0,8,0"
                                                                   Foreground="#C0A84A"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="Esta entrada no existe actualmente en la SD conectada"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding}"
                                                                   Foreground="#C0A84A" FontSize="13"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2"
                                                                Content="&#x2715;"
                                                                Tag="{Binding}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="#EF4444"
                                                                FontSize="13" Cursor="Hand"
                                                                Padding="8,4"
                                                                Click="BtnQuitarEntradaProtegida_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Explorador de la SD (solo si hay SD conectada) -->
                                    <TextBlock x:Name="TxtCabeceraExploradorSD"
                                               Text="CONTENIDO DE LA SD (primer nivel)"
                                               Style="{StaticResource EstiloCabeceraSeccion}"
                                               Visibility="Collapsed"/>

                                    <TextBlock x:Name="TxtSinSDEnAjustes"
                                               Text="Conecta una Micro SD para ver su contenido y marcar entradas protegidas directamente."
                                               Foreground="#404050" FontSize="11"
                                               TextWrapping="Wrap" Margin="4,8,0,0"/>

                                    <!-- Lista del explorador de la SD -->
                                    <ItemsControl x:Name="ListaExploradorSD" Visibility="Collapsed">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="10,7" Margin="0,0,0,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding EsCritico}" Value="True"/>
                                                                        <Condition Binding="{Binding EstaProtegido}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                                <ColorAnimation
                                                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                                    From="#FF4400" To="#FF0000"
                                                                                    Duration="0:0:0.7"/>
                                                                                <ColorAnimation
                                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                    From="#1A0500" To="#2A0000"
                                                                                    Duration="0:0:0.7"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0"
                                                               Width="16" Height="16"
                                                               Stretch="Uniform"
                                                               Margin="0,0,10,0" VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Source"
                                                                            Value="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoArchivoUrl, Converter={StaticResource IconoCacheConverter}}"/>
                                                                    <Setter Property="Opacity" Value="0.7"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tipo}" Value="Carpeta">
                                                                            <Setter Property="Source"
                                                                                    Value="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoCarpetaUrl, Converter={StaticResource IconoCacheConverter}}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tipo}" Value="Comprimido">
                                                                            <Setter Property="Source"
                                                                                    Value="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoZipUrl, Converter={StaticResource IconoCacheConverter}}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <TextBlock Grid.Column="1" Text="{Binding Nombre}"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding EsCritico}" Value="True"/>
                                                                                <Condition Binding="{Binding EstaProtegido}" Value="False"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <MultiDataTrigger.EnterActions>
                                                                                <BeginStoryboard>
                                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                                        <ColorAnimation
                                                                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                                                            From="#FF7744" To="#FF3300"
                                                                                            Duration="0:0:0.7"/>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </MultiDataTrigger.EnterActions>
                                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <CheckBox Grid.Column="2"
                                                                  IsChecked="{Binding EstaProtegido}"
                                                                  Style="{StaticResource EstiloToggleSwitch}"
                                                                  Tag="{Binding Nombre}"
                                                                  Click="CheckEntradaSD_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>

                                    <!-- SECCIÓN: GITHUB TOKEN -->
                                    <StackPanel x:Name="PanelGitHub" Visibility="Collapsed">

                                        <TextBlock Text="TOKEN DE GITHUB (OPCIONAL)"
                                                   Style="{StaticResource EstiloCabeceraSeccion}"/>

                                        <!-- Descripción -->
                                        <Border Style="{StaticResource EstiloFilaAjuste}" Margin="0,0,0,4">
                                            <TextBlock TextWrapping="Wrap" Foreground="#707080" FontSize="11" LineHeight="18">
                                                <Run Text="Aumenta el límite de la API de GitHub de 60 a 5 000 peticiones/hora."/>
                                                <LineBreak/>
                                                <Run Text="Permite detectar cambios silenciosos de hash en assets descargados (mismo número de versión, archivo distinto)."/>
                                                <LineBreak/>
                                                <Run Text="Si no configuras un token la app funciona igual, instalando desde caché cuando no haya red."/>
                                            </TextBlock>
                                        </Border>

                                        <!-- Campo de token -->
                                        <Border Style="{StaticResource EstiloFilaAjuste}" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0"
                                                           Text="Token personal (ghp_...)"
                                                           Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                <PasswordBox x:Name="TxtTokenGitHub"
                                                             Grid.Row="2"
                                                             Background="#0D0D14"
                                                             Foreground="White"
                                                             BorderBrush="#2A2A40"
                                                             BorderThickness="1"
                                                             Padding="8,6"
                                                             FontSize="12"
                                                             FontFamily="Consolas"
                                                             MaxLength="200"
                                                             PasswordChar="●"/>
                                            </Grid>
                                        </Border>

                                        <!-- Botones guardar / borrar -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="BtnGuardarToken"
                                                    Grid.Column="0"
                                                    Content="GUARDAR TOKEN"
                                                    Style="{StaticResource EstiloBotonInstalar}"
                                                    HorizontalAlignment="Stretch"
                                                    Click="BtnGuardarToken_Click"/>
                                            <Button x:Name="BtnBorrarToken"
                                                    Grid.Column="2"
                                                    Content="BORRAR"
                                                    Style="{StaticResource EstiloBotonEliminar}"
                                                    Width="80"
                                                    Click="BtnBorrarToken_Click"/>
                                        </Grid>

                                        <!-- Estado del token -->
                                        <Border Style="{StaticResource EstiloFilaAjuste}" Margin="0,8,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="Estado del token"
                                                           Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtEstadoToken"
                                                           Grid.Column="1"
                                                           Text="Sin token configurado"
                                                           Foreground="#505060" FontSize="11"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Cómo obtener un token -->
                                        <Border Style="{StaticResource EstiloFilaAjuste}" Margin="0,4,0,0">
                                            <TextBlock TextWrapping="Wrap" Foreground="#505060" FontSize="11" LineHeight="17">
                                                <Run Text="Cómo obtener un token: "/>
                                                <Run Text="github.com → Settings → Developer settings → Personal access tokens → Tokens (classic)"
                                                     FontFamily="Consolas" Foreground="#707090"/>
                                                <LineBreak/>
                                                <Run Text="Permisos necesarios: solo "/>
                                                <Run Text="public_repo" FontFamily="Consolas" Foreground="#00D2FF"/>
                                                <Run Text=" (o sin permisos para repos públicos)."/>
                                            </TextBlock>
                                        </Border>

                                    </StackPanel>

                                </StackPanel>

                            </ScrollViewer>
                        </Grid>

                        <!-- Barra inferior de estado -->
                        <Border Grid.Row="2"
                                Background="{StaticResource OverlayFooterBackground}"
                                BorderThickness="0,1,0,0" BorderBrush="#1E1E28"
                                CornerRadius="0,0,18,18" Padding="20,0">
                            <TextBlock x:Name="TxtEstadoAjustes"
                                       Text="Los cambios se guardan automaticamente."
                                       Foreground="#404050" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Border>

                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 OVERLAY: Visor de Log de Actividad
                 ZIndex 912 → por encima de todos los overlays existentes.
                 Cierra con click fuera (backdrop). Muestra todas las sesiones
                 colapsables con colores por nivel (OK, INFO, WARN, ERROR).
                 ══════════════════════════════════════════════════════════ -->
            <Grid x:Name="PanelLogOverlay"
                  Grid.Row="0" Grid.RowSpan="2"
                  Grid.Column="0" Grid.ColumnSpan="3"
                  Visibility="Collapsed"
                  Panel.ZIndex="912">

                <!-- Backdrop: click fuera = cerrar -->
                <Border Background="#CC000008"
                        MouseLeftButtonDown="PanelLog_BackdropClick"/>

                <!-- Panel centrado -->
                <Border x:Name="PanelLogContenido"
                        Style="{StaticResource EstiloOverlayPanel}"
                        Width="700" MaxHeight="640">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ── Cabecera ámbar ── -->
                        <Border Grid.Row="0" Style="{StaticResource EstiloOverlayHeader}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{StaticResource OverlayAcentoAmber}"
                                            Margin="0,0,12,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FFD54A" BlurRadius="10"
                                                              ShadowDepth="0" Opacity="0.9"/>
                                        </Border.Effect>
                                    </Border>
                                    <TextBlock Text="REGISTRO DE ACTIVIDAD"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource OverlayAcentoAmber}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Click="BtnCerrarLog_Click">
                                    <TextBlock Text="✕" FontSize="14"
                                               Foreground="#707080" Opacity="0.7"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Rectangle Grid.Row="0" Height="1" Fill="#2A2A35"
                                   VerticalAlignment="Bottom"/>

                        <!-- ── Cuerpo: sesiones colapsables con scroll ── -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="20,14,20,0">
                            <StackPanel x:Name="PanelSesionesLog"/>
                        </ScrollViewer>

                        <!-- ── Footer: botones de acción ── -->
                        <Border Grid.Row="2" Style="{StaticResource EstiloOverlayFooter}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Sesiones más recientes primero"
                                           Foreground="{StaticResource OverlayTextoApagado}"
                                           FontSize="10" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="1"
                                        x:Name="BtnLimpiarLog"
                                        Margin="0,0,10,0"
                                        Width="130" Height="38"
                                        Cursor="Hand"
                                        Click="BtnLimpiarLog_Click"
                                        Style="{StaticResource EstiloBotonEliminar}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🗑" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="LIMPIAR LOG"
                                                   FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        x:Name="BtnCopiarTextoLog"
                                        Margin="0,0,10,0"
                                        Width="150" Height="38"
                                        Cursor="Hand"
                                        Click="BtnCopiarTextoLog_Click"
                                        Style="{StaticResource EstiloBotonMenu}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="COPIAR TEXTO"
                                                   FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="3"
                                        x:Name="BtnGuardarArchivoLog"
                                        Width="150" Height="38"
                                        Cursor="Hand"
                                        Click="BtnGuardarArchivoLog_Click"
                                        Style="{StaticResource EstiloBotonInstalar}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="GUARDAR ARCHIVO"
                                                   FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════
                 OVERLAY RP2040 / PICOFLY (ZIndex 913)
                 ═══════════════════════════════════════════════════════════ -->
            <Grid x:Name="PanelRp2040Overlay"
                  Grid.Row="0" Grid.RowSpan="2"
                  Grid.Column="0" Grid.ColumnSpan="3"
                  Visibility="Collapsed"
                  Panel.ZIndex="913">

                <!-- Backdrop -->
                <Border Background="{StaticResource OverlayBackdropBrush}"
                        MouseLeftButtonDown="PanelRp2040_BackdropClick"/>

                <!-- Panel centrado -->
                <Border x:Name="ContenidoRp2040Overlay"
                        Style="{StaticResource EstiloOverlayPanel}"
                        Width="500">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ── Cabecera ── -->
                        <Border Grid.Row="0" Style="{StaticResource EstiloOverlayHeader}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{StaticResource OverlayAcentoCian}"
                                            Margin="0,0,12,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00D2FF" BlurRadius="10"
                                                              ShadowDepth="0" Opacity="0.9"/>
                                        </Border.Effect>
                                    </Border>
                                    <TextBlock Text="PICOFLY — ACTUALIZAR FIRMWARE"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource OverlayAcentoCian}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Click="BtnCerrarRp2040_Click">
                                    <TextBlock Text="✕" FontSize="14"
                                               Foreground="#707080" Opacity="0.7"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Rectangle Grid.Row="0" Height="1" Fill="#2A2A35" VerticalAlignment="Bottom"/>

                        <!-- ── Cuerpo ── -->
                        <StackPanel Grid.Row="1" Margin="24,20,24,16">

                            <!-- Tarjeta de info del chip — mismo patrón que tarjeta SD -->
                            <Border Style="{StaticResource EstiloOverlayTarjetaSD}"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Badge estado: fondo cian cuando detectado -->
                                    <Border x:Name="BadgeEstadoChip"
                                            Grid.Column="0"
                                            Background="#1400D2FF" CornerRadius="8"
                                            Padding="10,6" Margin="0,0,14,0"
                                            MinWidth="42"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtRp2040EstadoBadge"
                                                   Text="OFF"
                                                   FontSize="11" FontWeight="Black"
                                                   Foreground="{StaticResource OverlayAcentoCian}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Info columna -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                        <!-- Título de estado -->
                                        <TextBlock x:Name="TxtRp2040Estado"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource OverlayTextoTitulo}"
                                                   Margin="0,0,0,4"/>

                                        <!-- Modelo del chip (colapsable) -->
                                        <TextBlock x:Name="TxtRp2040VersionActual"
                                                   FontSize="11"
                                                   Foreground="{StaticResource OverlayTextoSecundario}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Fila: versión disponible + icono caché -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="VERSIÓN DISPONIBLE"
                                               Foreground="{StaticResource OverlayTextoApagado}"
                                               FontSize="9" FontWeight="Bold"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtRp2040VersionRemota"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource OverlayAcentoCian}"/>
                                </StackPanel>

                                <!-- Icono caché — visible solo cuando el firmware está en caché -->
                                <StackPanel x:Name="PanelIconoCacheRp2040"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <Image Width="22" Height="22" Stretch="Uniform"
                                           Opacity="0.75" Margin="0,0,6,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoCacheUrl, Converter={StaticResource IconoCacheConverter}}"/>
                                    <TextBlock Text="caché"
                                               Foreground="{StaticResource OverlayTextoApagado}"
                                               FontSize="10" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Barra de progreso + mensaje -->
                            <Border x:Name="PanelProgresoRp2040"
                                    CornerRadius="8"
                                    Background="#0A0A14"
                                    BorderBrush="#1A1A28"
                                    BorderThickness="1"
                                    Padding="14,10"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="TxtRp2040Progreso"
                                               Foreground="{StaticResource OverlayTextoSecundario}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <Border CornerRadius="4" Background="#14FFFFFF" Height="4">
                                        <Border x:Name="BarraProgresoRp2040"
                                                CornerRadius="4" Height="4"
                                                HorizontalAlignment="Left" Width="0"
                                                Background="{StaticResource OverlayAcentoCian}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ── Footer ── -->
                        <Border Grid.Row="2" Style="{StaticResource EstiloOverlayFooter}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnFlashearRp2040"
                                        Grid.Column="0"
                                        Height="38" Cursor="Hand"
                                        Click="BtnFlashearRp2040_Click"
                                        Style="{StaticResource EstiloBotonInstalar}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Stretch="Uniform"
                                               Opacity="0.9" Margin="0,0,8,0"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoRp2040Url, Converter={StaticResource IconoCacheConverter}}"/>
                                        <TextBlock Text="ACTUALIZAR CHIP"
                                                   FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnGuardarRp2040"
                                        Grid.Column="2"
                                        Height="38" Cursor="Hand"
                                        Click="BtnGuardarRp2040_Click"
                                        Style="{StaticResource EstiloBotonMenu}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Stretch="Uniform"
                                               Opacity="0.75" Margin="0,0,8,0"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding Source={x:Static cfg:ConfiguracionRemota.Ui}, Path=IconoCacheUrl, Converter={StaticResource IconoCacheConverter}}"/>
                                        <TextBlock Text="GUARDAR EN PC"
                                                   FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════════
                 OVERLAY: Llaves de Consola (ZIndex 913)
                 Estado (semáforo) arriba. Izquierda: consola en la microSD.
                 Derecha: respaldos guardados en el PC.
                 ══════════════════════════════════════════════════════════════ -->
            <Grid x:Name="PanelRespaldoLlavesOverlay"
                  Grid.Row="0" Grid.RowSpan="2"
                  Grid.Column="0" Grid.ColumnSpan="3"
                  Visibility="Collapsed"
                  Panel.ZIndex="913">

                <Border Background="#CC000008"
                        MouseLeftButtonDown="RespaldoLlaves_BackdropClick"/>

                <Border x:Name="ContenidoRespaldoLlavesOverlay"
                        Style="{StaticResource EstiloOverlayPanel}"
                        Width="900" MaxHeight="700">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera -->
                        <Border Grid.Row="0" Style="{StaticResource EstiloOverlayHeader}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LLAVES DE CONSOLA"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#E0E0F0"/>
                                    <TextBlock Text="prod.keys, BISKEYS y PRODINFO identificados por consola"
                                               FontSize="10" Foreground="#606070" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Click="BtnCerrarRespaldoLlaves_Click">
                                    <TextBlock Text="&#x2715;" FontSize="14"
                                               Foreground="#707080" Opacity="0.7"/>
                                </Button>
                            </Grid>
                        </Border>
                        <Rectangle Grid.Row="0" Height="1" Fill="#2A2A35" VerticalAlignment="Bottom"/>

                        <!-- Estado general (semáforo) -->
                        <Border x:Name="BordeEstadoLlaves" Grid.Row="1"
                                Margin="20,16,20,0" Padding="16,12"
                                CornerRadius="12" BorderThickness="1"
                                Background="#0F0F18" BorderBrush="#2A2A35">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="PuntoEstadoLlaves" Width="12" Height="12"
                                         Fill="#707080" VerticalAlignment="Top" Margin="0,4,14,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="TxtRespaldoVerificacion"
                                               Text="Analizando…" FontSize="13"
                                               FontWeight="Bold" Foreground="#A0A0B0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtRespaldoEstadoAnalisis"
                                               Text="" FontSize="11"
                                               Foreground="#707080" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Visibility="Collapsed"/>
                                    <Border x:Name="PanelRespaldoAdvertencia"
                                            Margin="0,6,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtRespaldoMsgAdvertencia"
                                                   Text="" TextWrapping="Wrap"
                                                   Foreground="#B0B0C0" FontSize="11" LineHeight="17"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Cuerpo: SD | PC -->
                        <Grid Grid.Row="2" Margin="20,14,20,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ── IZQUIERDA: consola en la microSD ── -->
                            <Border Grid.Column="0" CornerRadius="12" Background="#0C0C14"
                                    BorderBrush="#1E1E28" BorderThickness="1" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="EN LA MICROSD" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource OverlayAcentoCian}"
                                               Margin="0,0,0,12"/>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="PanelRespaldoDetalle" Visibility="Collapsed">
                                            <TextBlock x:Name="TxtRespaldoSerial"
                                                       Text="&#x2014;" FontSize="20"
                                                       FontWeight="Bold" Foreground="#E0E0F0"
                                                       FontFamily="Consolas"/>
                                            <TextBlock x:Name="TxtRespaldoModelo"
                                                       Text="" FontSize="11"
                                                       Foreground="#8080A0" Margin="0,2,0,0"
                                                       Visibility="Collapsed"/>

                                            <Border CornerRadius="8" Background="#0A00D2FF"
                                                    BorderBrush="#2000D2FF" BorderThickness="1"
                                                    Padding="12,8" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="NIVEL DE LLAVES" FontSize="9" FontWeight="Bold"
                                                               Foreground="#506070"/>
                                                    <TextBlock x:Name="TxtRespaldoNivelSD" Text="&#x2014;"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#00D2FF" TextWrapping="Wrap"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="ARCHIVOS" FontSize="9" FontWeight="Bold"
                                                       Foreground="#505060" Margin="0,14,0,6"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="prod.keys" FontSize="11" Foreground="#A0A0B0"/>
                                                <TextBlock x:Name="TxtRespaldoProdkeys" Grid.Column="1"
                                                           FontSize="11" FontWeight="Bold"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="BISKEYS.bin" FontSize="11" Foreground="#A0A0B0"/>
                                                <TextBlock x:Name="TxtRespaldoBiskeys" Grid.Column="1"
                                                           FontSize="11" FontWeight="Bold"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="PRODINFO.bin" FontSize="11" Foreground="#A0A0B0"/>
                                                <TextBlock x:Name="TxtRespaldoProdinfo" Grid.Column="1"
                                                           FontSize="11" FontWeight="Bold"/>
                                            </Grid>

                                            <TextBlock Text="SE GUARDARÁ EN" FontSize="9" FontWeight="Bold"
                                                       Foreground="#505060" Margin="0,14,0,4"/>
                                            <TextBlock x:Name="TxtRespaldoDestino"
                                                       Text="&#x2014;" FontSize="10"
                                                       Foreground="#707088"
                                                       TextWrapping="Wrap" FontFamily="Consolas"/>

                                            <TextBlock x:Name="TxtRespaldoFeedback" Text=""
                                                       FontSize="11" FontWeight="Bold"
                                                       TextWrapping="Wrap" Margin="0,12,0,0"
                                                       Visibility="Collapsed"/>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Button x:Name="BtnConfirmarRespaldo" Grid.Row="2"
                                            IsEnabled="False" Height="40" Margin="0,14,0,0"
                                            Cursor="Hand" Click="BtnConfirmarRespaldo_Click"
                                            ToolTip="Guarda las llaves de esta consola en el PC (nunca reemplaza un respaldo más nuevo)">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="B" CornerRadius="10"
                                                        Background="#0F2414" BorderBrush="#4CAF50"
                                                        BorderThickness="1">
                                                    <TextBlock x:Name="T" Text="&#x2193;  RESPALDAR EN EL PC"
                                                               FontSize="11" FontWeight="Bold"
                                                               Foreground="#4CAF50"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#16341D"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="B" Property="Background" Value="#0E0E14"/>
                                                        <Setter TargetName="B" Property="BorderBrush" Value="#252535"/>
                                                        <Setter TargetName="T" Property="Foreground" Value="#404050"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- ── DERECHA: respaldos en el PC ── -->
                            <Border Grid.Column="2" CornerRadius="12" Background="#0C0C14"
                                    BorderBrush="#1E1E28" BorderThickness="1" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="GUARDADOS EN EL PC"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource OverlayAcentoCian}"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="BtnAbrirCarpetaRespaldo"
                                                HorizontalAlignment="Right"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" Click="BtnAbrirCarpetaRespaldo_Click"
                                                ToolTip="Abrir carpeta de respaldos">
                                            <TextBlock Text="Abrir carpeta"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#606070"/>
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <TextBlock x:Name="TxtSinRespaldosPC"
                                                   Text="Todavía no hay respaldos en este equipo."
                                                   Foreground="#404050" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="Collapsed"/>

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                                            <ItemsControl x:Name="ListaRespaldosPC">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="TarjetaRespaldo"
                                                                CornerRadius="10" BorderThickness="1.5"
                                                                Background="#10101A" BorderBrush="#252535"
                                                                Padding="12,10" Margin="0,0,0,8"
                                                                Cursor="Hand"
                                                                MouseLeftButtonDown="TarjetaRespaldo_Click">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Serial}"
                                                                               FontSize="13" FontWeight="Bold"
                                                                               FontFamily="Consolas"
                                                                               Foreground="White"/>
                                                                    <TextBlock Text="{Binding FechaFormateada}"
                                                                               HorizontalAlignment="Right"
                                                                               FontSize="9" Foreground="#505060"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding ModeloRegionResumen}"
                                                                           FontSize="10" Foreground="#8080A0"
                                                                           Margin="0,2,0,0"
                                                                           Visibility="{Binding TieneModelo, Converter={StaticResource BoolToVis}}"/>
                                                                <TextBlock Text="{Binding NivelResumen}"
                                                                           FontSize="10" FontWeight="SemiBold"
                                                                           Foreground="#00D2FF"
                                                                           Margin="0,6,0,0"/>
                                                                <Grid Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding ResumenArchivos}"
                                                                               FontSize="9" Foreground="#606070"/>
                                                                    <TextBlock Text="{Binding IntegridadResumen}"
                                                                               HorizontalAlignment="Right"
                                                                               FontSize="9" FontWeight="SemiBold"
                                                                               Foreground="{Binding IntegridadColor}"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>

                                    <TextBlock x:Name="TxtRestaurarFeedback" Grid.Row="2" Text=""
                                               FontSize="11" FontWeight="Bold"
                                               TextWrapping="Wrap" Margin="0,10,0,0"
                                               Visibility="Collapsed"/>

                                    <Button x:Name="BtnRestaurarSeleccionado" Grid.Row="3"
                                            IsEnabled="False" Height="40" Margin="0,14,0,0"
                                            Cursor="Hand" Click="BtnRestaurarSeleccionado_Click"
                                            ToolTip="Copia el respaldo seleccionado a la microSD (nunca reemplaza llaves más nuevas)">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="B" CornerRadius="10"
                                                        Background="#0A1A26"
                                                        BorderBrush="{StaticResource OverlayAcentoCian}"
                                                        BorderThickness="1">
                                                    <TextBlock x:Name="T" Text="&#x2191;  RESTAURAR EN LA MICROSD"
                                                               FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource OverlayAcentoCian}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#0E2638"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="B" Property="Background" Value="#0E0E14"/>
                                                        <Setter TargetName="B" Property="BorderBrush" Value="#252535"/>
                                                        <Setter TargetName="T" Property="Foreground" Value="#404050"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Footer -->
                        <Border Grid.Row="3" Style="{StaticResource EstiloOverlayFooter}">
                            <Grid>
                                <TextBlock x:Name="TxtRespaldoSeleccionadoInfo"
                                           Text="Selecciona un respaldo para restaurarlo a la microSD."
                                           Foreground="{StaticResource OverlayTextoApagado}"
                                           FontSize="10" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
