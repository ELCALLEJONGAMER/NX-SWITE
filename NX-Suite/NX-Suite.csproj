<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>NX-Swite</AssemblyName>
    <RootNamespace>NX_Swite</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.7.1</Version>
    <ApplicationIcon>Assets\NX-SWITE_SIMPLIFICADO.ico</ApplicationIcon>

    <!-- Configuración de publicación para la beta -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\**" />
    <Resource Include="Assets\**" Exclude="Assets\certificado_plantilla.png;Assets\configuracion-fija.json" />
    <EmbeddedResource Include="Assets\certificado_plantilla.png" />
    <EmbeddedResource Include="Assets\configuracion-fija.json" LogicalName="NX_Suite.configuracion-fija.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.2.0" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.4" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Solo se usa para garantizar que el updater se compile antes del target CopiarUpdater.
         ReferenceOutputAssembly=false + Private=false evita que su DLL se incluya en NX-Swite. -->
    <ProjectReference Include="..\NX-Suite.Updater\NX-Suite.Updater.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Copia todos los archivos necesarios de NX-Suite.Updater al directorio de salida -->
  <Target Name="CopiarUpdater" AfterTargets="Build">
    <ItemGroup>
      <ArchivosUpdater Include="$(MSBuildThisFileDirectory)..\NX-Suite.Updater\bin\$(Configuration)\$(TargetFramework)\NX-Swite.Updater.*" />
    </ItemGroup>
    <Warning Condition="'@(ArchivosUpdater)' == ''" Text="No se encontraron los archivos de NX-Swite.Updater; el actualizador no se copiará a la salida." />
    <Copy SourceFiles="@(ArchivosUpdater)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Publica el updater (self-contained, single-file) y lo copia junto al exe principal al hacer dotnet publish -->
  <Target Name="PublicarUpdater" AfterTargets="Publish">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\NX-Suite.Updater\NX-Suite.Updater.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true /p:PublishSingleFile=true /p:IncludeNativeLibrariesForSelfExtract=true /p:EnableCompressionInSingleFile=true -o &quot;$(PublishDir)&quot;" />
  </Target>

</Project>
