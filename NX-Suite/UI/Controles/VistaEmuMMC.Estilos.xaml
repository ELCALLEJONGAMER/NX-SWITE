<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:NX_Swite.UI.Controles">

    <!-- Pestaña (control segmentado) -->
    <Style x:Key="EstiloPestana" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="PestanasEmu"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fondo" CornerRadius="10" Padding="18,8" Background="Transparent" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center" TextElement.FontWeight="Bold" TextElement.FontSize="13"/>
                            <Border x:Name="Contador" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" Background="#14FFFFFF"
                                    Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:VistaEmuMMC.VisibleSiTexto}}">
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="11" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#0FFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#2200D2FF"/>
                            <Setter Property="Foreground" Value="{DynamicResource AcentoCian}"/>
                            <Setter TargetName="Contador" Property="Background" Value="#3300D2FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filtro (chip seleccionable) -->
    <Style x:Key="EstiloFiltro" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fondo" CornerRadius="14" Padding="12,4" Margin="0,0,6,0" BorderThickness="1"
                            BorderBrush="{DynamicResource BordeGeneral}" Background="Transparent">
                        <ContentPresenter TextElement.FontSize="11" TextElement.FontWeight="SemiBold"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#0FFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource AcentoCian}"/>
                            <Setter TargetName="Fondo" Property="Background" Value="#1A00D2FF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tarjeta de juego (icono cuadrado + nombre + perfiles) -->
    <Style x:Key="EstiloJuego" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,12,14"/>
        <Setter Property="ToolTip" Value="{Binding Descripcion}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <StackPanel Width="132">
                        <Grid x:Name="Caja" Width="132" Height="132" RenderTransformOrigin="0.5,0.5">
                            <Border CornerRadius="14" Background="#1A1A24">
                                <TextBlock Text="{Binding Inicial}" FontSize="44" FontWeight="ExtraBold" Foreground="#33FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Marco" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Icono}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="6" Padding="6,1" Margin="8" Background="#CC000000"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding Tamano}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <Border x:Name="Check" Width="22" Height="22" CornerRadius="11" Margin="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource AcentoCian}" Visibility="Collapsed">
                                <Path Data="M5 12l4 4 10-10" Stroke="#0F0F15" StrokeThickness="2.4" Stretch="Uniform" Width="11"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Nombre}" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="2,8,2,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Perfiles}" Foreground="{DynamicResource TextoSecundario}" FontSize="10" Margin="2,2,2,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Caja" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.04" ScaleY="1.04"/></Setter.Value></Setter>
                            <Setter TargetName="Marco" Property="BorderBrush" Value="#66FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource AcentoCian}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Miniatura del álbum -->
    <Style x:Key="EstiloMiniatura" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="ToolTip" Value="{Binding Descripcion}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Width="192" Height="108" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="Escala"/></Grid.RenderTransform>
                        <Border x:Name="Marco" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Miniatura}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Velo" CornerRadius="10" Background="Transparent"/>
                        <!-- Degradado inferior para legibilidad -->
                        <Border CornerRadius="0,0,10,10" Height="34" VerticalAlignment="Bottom" Margin="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#AA000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- Icono de vídeo -->
                        <Border Width="38" Height="38" CornerRadius="19" Background="#99000000"
                                Visibility="{Binding VisibilidadVideo}">
                            <Path Data="M0 0L10 6 0 12z" Fill="White" Stretch="Uniform" Width="12" Margin="3,0,0,0"/>
                        </Border>
                        <!-- Hora + origen -->
                        <DockPanel VerticalAlignment="Bottom" Margin="10,0,10,7">
                            <Border DockPanel.Dock="Right" CornerRadius="5" Padding="5,1" Background="#B3000000">
                                <TextBlock Text="{Binding Etiqueta}" Foreground="{Binding ColorEtiqueta}" FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="{Binding Hora}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- Check de selección -->
                        <Border x:Name="Check" Width="22" Height="22" CornerRadius="11" Margin="8"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource AcentoCian}"
                                Visibility="Collapsed">
                            <Path Data="M5 12l4 4 10-10" Stroke="#0F0F15" StrokeThickness="2.4" Stretch="Uniform" Width="11"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Marco" Property="BorderBrush" Value="#8800D2FF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource AcentoCian}"/>
                            <Setter TargetName="Velo" Property="Background" Value="#2200D2FF"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
