<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NX_Swite.UI.Controles.VistaEmuMMC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Mismo lenguaje visual que VistaHubCFW (tarjetas + halo neon en hover). -->
        <Style x:Key="EstiloTarjeta" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#0F0F15"/>
            <Setter Property="BorderBrush" Value="#2A2A35"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="Black" Opacity="0.55"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EstiloProximamente" TargetType="Border" BasedOn="{StaticResource EstiloTarjeta}">
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="ToolTip" Value="Disponible en una próxima versión"/>
        </Style>
        <Style x:Key="EstiloHalo" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="BorderThickness" Value="5"/>
            <Setter Property="BorderBrush" Value="{StaticResource PincelNeonRotatorio}"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Margin" Value="-4"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <BlurEffect Radius="18"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EstiloBadge" TargetType="Border">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#1A00D2FF"/>
        </Style>
        <Style x:Key="EstiloIcono" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stroke" Value="#00D2FF"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EstiloEtiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#707080"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="EstiloValor" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="EstiloTituloTarjeta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="EstiloDescTarjeta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0AA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="EstiloChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="EstiloBadgeExperimental" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#22FFB300"/>
            <Setter Property="BorderBrush" Value="#FFB300"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="EstiloBoton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#14141C"/>
            <Setter Property="BorderBrush" Value="#00D2FF"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" CornerRadius="10" BorderThickness="1.5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#2200D2FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- DASHBOARD -->
        <Grid x:Name="PanelDashboard">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBoton}"
                        VerticalAlignment="Center" Click="BtnActualizar_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14"
                              Data="M21 12a9 9 0 1 1-3-6.7 M21 4v5h-5"/>
                        <TextBlock Text="Actualizar" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="EMUMMC" Foreground="#00D2FF" FontSize="22" FontWeight="ExtraBold"/>
                    <TextBlock x:Name="TxtSubtitulo" Text="Gestión y mantenimiento de tu emuMMC"
                               Foreground="#707080" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Barra de estado -->
            <Border Grid.Row="1" Style="{StaticResource EstiloTarjeta}" Padding="22,16" Margin="0,0,0,16">
                <UniformGrid Columns="4">
                    <DockPanel>
                        <Border x:Name="BadgeEstado" Style="{StaticResource EstiloBadge}">
                            <Path x:Name="IconoEstado" Style="{StaticResource EstiloIcono}" Data="M20 6L9 17l-5-5"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="ESTADO" Style="{StaticResource EstiloEtiqueta}"/>
                            <TextBlock x:Name="TxtEstado" Text="—" Style="{StaticResource EstiloValor}"
                                       Foreground="#00D2FF" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <Border Style="{StaticResource EstiloBadge}" Background="#1AB388FF">
                            <Path Style="{StaticResource EstiloIcono}" Stroke="#B388FF"
                                  Data="M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5 M2 12l10 5 10-5"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="TIPO" Style="{StaticResource EstiloEtiqueta}"/>
                            <TextBlock x:Name="TxtTipo" Text="—" Style="{StaticResource EstiloValor}"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <Border Style="{StaticResource EstiloBadge}">
                            <Path Style="{StaticResource EstiloIcono}" Data="M7 2h8l4 4v16H7z M10 6v3 M13 6v3 M16 6v3"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="MICROSD" Style="{StaticResource EstiloEtiqueta}"/>
                            <TextBlock x:Name="TxtSd" Text="—" Style="{StaticResource EstiloValor}"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <Border Style="{StaticResource EstiloBadge}" Background="#1AB388FF">
                            <Path Style="{StaticResource EstiloIcono}" Stroke="#B388FF"
                                  Data="M6 6h12v12H6z M9 9h6v6H9z M9 2v4 M15 2v4 M9 18v4 M15 18v4 M2 9h4 M2 15h4 M18 9h4 M18 15h4"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="CONTENIDOS EN SD" Style="{StaticResource EstiloEtiqueta}"/>
                            <TextBlock x:Name="TxtContenidos" Text="—" Style="{StaticResource EstiloValor}"/>
                        </StackPanel>
                    </DockPanel>
                </UniformGrid>
            </Border>

            <UniformGrid Grid.Row="2" Columns="3" Rows="2">
                <!-- Saves (activa) -->
                <Grid Margin="0,0,12,12">
                    <Border Style="{StaticResource EstiloHalo}"/>
                    <Border Style="{StaticResource EstiloTarjeta}" Padding="22" Cursor="Hand"
                            MouseEnter="Tarjeta_MouseEnter" MouseLeave="Tarjeta_MouseLeave"
                            MouseLeftButtonUp="TarjetaSaves_Click">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <StackPanel>
                            <Border Style="{StaticResource EstiloBadge}" HorizontalAlignment="Left">
                                <Path Style="{StaticResource EstiloIcono}"
                                      Data="M5 3h11l3 3v15H5z M8 3v6h8V3 M8 21v-7h8v7"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="Saves" Style="{StaticResource EstiloTituloTarjeta}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource EstiloBadgeExperimental}"><TextBlock Text="EXPERIMENTAL" Foreground="#FFB300" FontSize="10" FontWeight="Bold"/></Border>
                            </StackPanel>
                            <TextBlock Text="Consulta y respalda las partidas guardadas por perfil."
                                       Style="{StaticResource EstiloDescTarjeta}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource EstiloProximamente}" Padding="22" Margin="0,0,12,12">
                    <StackPanel>
                        <Border Style="{StaticResource EstiloBadge}" HorizontalAlignment="Left">
                            <Path Style="{StaticResource EstiloIcono}" Data="M12 3v12 M7 10l5 5 5-5 M4 21h16"/>
                        </Border>
                        <TextBlock Text="Respaldar emuMMC" Style="{StaticResource EstiloTituloTarjeta}" Margin="0,14,0,0"/>
                        <TextBlock Text="Copia completa de la emuMMC al PC." Style="{StaticResource EstiloDescTarjeta}"/>
                        <Border Style="{StaticResource EstiloChip}"><TextBlock Text="PRÓXIMAMENTE" Foreground="#9AA0AA" FontSize="10" FontWeight="Bold"/></Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource EstiloProximamente}" Padding="22" Margin="0,0,0,12">
                    <StackPanel>
                        <Border Style="{StaticResource EstiloBadge}" HorizontalAlignment="Left">
                            <Path Style="{StaticResource EstiloIcono}" Data="M3 12a9 9 0 1 0 3-6.7 M3 4v5h5"/>
                        </Border>
                        <TextBlock Text="Restaurar" Style="{StaticResource EstiloTituloTarjeta}" Margin="0,14,0,0"/>
                        <TextBlock Text="Restaura una copia de seguridad previa." Style="{StaticResource EstiloDescTarjeta}"/>
                        <TextBlock Text="Mientras tanto: inicia el juego una vez y copia el save con JKSV o DBI (MTP)."
                                   Style="{StaticResource EstiloDescTarjeta}" Foreground="#00D2FF"/>
                        <Border Style="{StaticResource EstiloChip}"><TextBlock Text="PRÓXIMAMENTE" Foreground="#9AA0AA" FontSize="10" FontWeight="Bold"/></Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource EstiloProximamente}" Padding="22" Margin="0,0,12,0">
                    <StackPanel>
                        <Border Style="{StaticResource EstiloBadge}" Background="#1AB388FF" HorizontalAlignment="Left">
                            <Path Style="{StaticResource EstiloIcono}" Stroke="#B388FF" Data="M4 7h13 M13 3l4 4-4 4 M20 17H7 M11 13l-4 4 4 4"/>
                        </Border>
                        <TextBlock Text="Migrar" Style="{StaticResource EstiloTituloTarjeta}" Margin="0,14,0,0"/>
                        <TextBlock Text="Convierte entre emuMMC de partición y de archivos." Style="{StaticResource EstiloDescTarjeta}"/>
                        <Border Style="{StaticResource EstiloChip}"><TextBlock Text="PRÓXIMAMENTE" Foreground="#9AA0AA" FontSize="10" FontWeight="Bold"/></Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource EstiloProximamente}" Padding="22" Margin="0,0,12,0">
                    <StackPanel>
                        <Border Style="{StaticResource EstiloBadge}" Background="#1AFFB300" HorizontalAlignment="Left">
                            <Path Style="{StaticResource EstiloIcono}" Stroke="#FFB300" Data="M12 3v14 M6 11l6 6 6-6 M5 21h14"/>
                        </Border>
                        <TextBlock Text="Downgrade" Style="{StaticResource EstiloTituloTarjeta}" Margin="0,14,0,0"/>
                        <TextBlock Text="Instala un firmware anterior en la emuMMC." Style="{StaticResource EstiloDescTarjeta}"/>
                        <Border Style="{StaticResource EstiloChip}"><TextBlock Text="PRÓXIMAMENTE" Foreground="#9AA0AA" FontSize="10" FontWeight="Bold"/></Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource EstiloProximamente}" Padding="22">
                    <StackPanel>
                        <Border Style="{StaticResource EstiloBadge}" Background="#1AFF5252" HorizontalAlignment="Left">
                            <Path Style="{StaticResource EstiloIcono}" Stroke="#FF5252" Data="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z"/>
                        </Border>
                        <TextBlock Text="Reparar arranque" Style="{StaticResource EstiloTituloTarjeta}" Margin="0,14,0,0"/>
                        <TextBlock Text="Corrige problemas de arranque de la emuMMC." Style="{StaticResource EstiloDescTarjeta}"/>
                        <Border Style="{StaticResource EstiloChip}"><TextBlock Text="PRÓXIMAMENTE" Foreground="#9AA0AA" FontSize="10" FontWeight="Bold"/></Border>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Detalles técnicos (plegable) -->
            <Border Grid.Row="3" Style="{StaticResource EstiloTarjeta}" Margin="0,16,0,0" Padding="18,10">
                <Expander Foreground="White" IsExpanded="False">
                    <Expander.Header>
                        <TextBlock Text="Detalles técnicos" FontWeight="SemiBold" Foreground="White"/>
                    </Expander.Header>
                    <ItemsControl x:Name="ListaDatos" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,28,6">
                                    <TextBlock Text="{Binding Key, StringFormat={}{0}:}" Foreground="#707080"/>
                                    <TextBlock Text="{Binding Value}" Foreground="White" Margin="6,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </Border>
        </Grid>

        <!-- SUBVISTA SAVES -->
        <Grid x:Name="PanelSaves" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Left" Style="{StaticResource EstiloBoton}" Click="BtnVolver_Click"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14" Data="M15 18l-6-6 6-6"/>
                        <TextBlock Text="Volver" Margin="6,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRespaldar" DockPanel.Dock="Right" Style="{StaticResource EstiloBoton}"
                        Content="Respaldar seleccionados" Margin="8,0,0,0" IsEnabled="False"
                        VerticalAlignment="Center" Click="BtnRespaldar_Click"/>
                <Button x:Name="BtnLeerSaves" DockPanel.Dock="Right" Style="{StaticResource EstiloBoton}"
                        Content="Reescanear" VerticalAlignment="Center" Click="BtnLeerSaves_Click"/>
                <ComboBox x:Name="ComboPerfil" DockPanel.Dock="Right" Width="180" Margin="0,0,8,0"
                          VerticalAlignment="Center" SelectionChanged="ComboPerfil_SelectionChanged"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SAVES" Foreground="#00D2FF" FontSize="22" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource EstiloBadgeExperimental}"><TextBlock Text="EXPERIMENTAL" Foreground="#FFB300" FontSize="10" FontWeight="Bold"/></Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtSaves" Text="Escanea la emuMMC para listar las partidas."
                               Foreground="#707080" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource EstiloTarjeta}" Padding="10">
                <ListView x:Name="ListaSaves" SelectionMode="Extended"
                          Background="Transparent" Foreground="White" BorderThickness="0"
                          SelectionChanged="ListaSaves_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Fondo" Background="Transparent" CornerRadius="8"
                                                BorderThickness="1" BorderBrush="Transparent" Padding="0,2">
                                            <GridViewRowPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Fondo" Property="Background" Value="#1400D2FF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Fondo" Property="Background" Value="#3300D2FF"/>
                                                <Setter TargetName="Fondo" Property="BorderBrush" Value="#00D2FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="52">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Width="40" Height="40" Stretch="UniformToFill"
                                               Source="{Binding IconoUrl, TargetNullValue={x:Null}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Juego"    Width="300" DisplayMemberBinding="{Binding Nombre}"/>
                            <GridViewColumn Header="Perfil"   Width="140" DisplayMemberBinding="{Binding Perfil}"/>
                            <GridViewColumn Header="TitleID"  Width="160" DisplayMemberBinding="{Binding TitleId}"/>
                            <GridViewColumn Header="Tamaño"   Width="90"  DisplayMemberBinding="{Binding TamanoTexto}"/>
                            <GridViewColumn Header="Fecha"    Width="140" DisplayMemberBinding="{Binding Fecha, StringFormat=g}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
            <StackPanel x:Name="PanelEscanear" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource EstiloBoton}" Padding="28,12" Click="BtnLeerSaves_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EstiloIcono}" Width="18" Height="18" Data="M11 4a7 7 0 1 0 0 14a7 7 0 1 0 0-14z M21 21l-5-5"/>
                        <TextBlock Text="ESCANEAR SAVES" Margin="10,0,0,0" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Lectura segura: no se modifica la emuMMC." Foreground="#707080" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
            <StackPanel x:Name="PanelEscaneando" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="56" Height="56" StrokeThickness="5" Stroke="{StaticResource PincelNeonRotatorio}" StrokeDashArray="6 3" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform x:Name="GiroSpinner"/></Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="GiroSpinner" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="Escaneando saves…" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
