<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NX_Swite.UI.Controles.VistaEmuMMC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NX_Swite.UI.Controles">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="VistaEmuMMC.Estilos.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <!-- Mismo lenguaje visual que VistaHubCFW (tarjetas + halo neon en hover). -->
        <Style x:Key="EstiloTarjeta" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#0F0F15"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BordeGeneral}"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="Black" Opacity="0.55"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EstiloProximamente" TargetType="Border" BasedOn="{StaticResource EstiloTarjeta}">
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="ToolTip" Value="Disponible en una próxima versión"/>
        </Style>
        <Style x:Key="EstiloHalo" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="BorderThickness" Value="5"/>
            <Setter Property="BorderBrush" Value="{StaticResource PincelNeonRotatorio}"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Margin" Value="-4"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="EstiloBadge" TargetType="Border">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#1A00D2FF"/>
        </Style>
        <Style x:Key="EstiloIcono" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stroke" Value="#00D2FF"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EstiloEtiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="EstiloTituloSeccion" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AcentoCian}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EstiloSubtitulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- Panel interior (dentro de una tarjeta) -->
        <Style x:Key="EstiloPanelInterior" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BordeGeneral}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <!-- Opción seleccionable con forma de tarjeta (incluir juegos, etc.) -->
        <Style x:Key="EstiloOpcionTarjeta" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Borde" CornerRadius="14" BorderThickness="1.5" Padding="16,12"
                                Background="#0AFFFFFF" BorderBrush="{DynamicResource BordeGeneral}">
                            <DockPanel>
                                <Border x:Name="Check" DockPanel.Dock="Right" Width="22" Height="22" CornerRadius="11"
                                        BorderThickness="1.5" BorderBrush="{DynamicResource TextoSecundario}"
                                        VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Path x:Name="Tick" Data="M5 12l4 4 10-10" Stroke="#0F0F15" StrokeThickness="2.4"
                                          Stretch="Uniform" Width="11" Height="11" Visibility="Collapsed"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="Background" Value="#1400D2FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource AcentoCian}"/>
                                <Setter TargetName="Check" Property="Background" Value="{DynamicResource AcentoCian}"/>
                                <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource AcentoCian}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Borde" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Lista de respaldos -->
        <Style x:Key="EstiloItemRespaldo" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Fondo" CornerRadius="14" BorderThickness="1.5" Padding="14,10"
                                Background="#0AFFFFFF" BorderBrush="{DynamicResource BordeGeneral}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#1400D2FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#2200D2FF"/>
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource AcentoCian}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="PlantillaRespaldo">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Tamano}" Foreground="#9AA0AA" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <ItemsControl ItemsSource="{Binding Chips}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="7" Padding="7,2" Margin="0,0,6,2"
                                        Background="{Binding Fondo}" BorderBrush="{Binding Color}" BorderThickness="1">
                                    <TextBlock Text="{Binding Texto}" Foreground="{Binding Color}" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
        <!-- Fila de comprobación (icono + texto) -->
        <DataTemplate x:Key="PlantillaComprobacion">
            <DockPanel Margin="0,0,0,10">
                <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="9" Background="{Binding Fondo}" VerticalAlignment="Top">
                    <Path Data="{Binding Icono}" Stroke="{Binding Color}" StrokeThickness="2" Stretch="Uniform" Width="13" Height="13"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="{Binding Titulo}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Detalle}" Foreground="#9AA0AA" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
        <Style x:Key="EstiloValor" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="EstiloTituloTarjeta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="EstiloDescTarjeta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0AA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="EstiloChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="EstiloBadgeExperimental" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#22FFB300"/>
            <Setter Property="BorderBrush" Value="#FFB300"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="EstiloBoton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#14141C"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AcentoCian}"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" CornerRadius="10" BorderThickness="1.5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#2200D2FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Acciones principales del Centro de herramientas -->
        <Style x:Key="EstiloAccion" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="Black" Opacity="0.6"/>
                </Setter.Value>
            </Setter>
        </Style>
        <LinearGradientBrush x:Key="FondoAccionCian" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3300D2FF" Offset="0"/>
            <GradientStop Color="#0A00D2FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FondoAccionVioleta" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#33B388FF" Offset="0"/>
            <GradientStop Color="#0AB388FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FondoAccionAmbar" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#33FFB300" Offset="0"/>
            <GradientStop Color="#0AFFB300" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="EstiloTituloAccion" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style x:Key="EstiloDescAccion" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <!-- Fondo oscuro futurista para Juegos / Álbum -->
        <!-- Base azul noche + foco de luz inferior + líneas de circuito diagonales en la esquina -->
        <DrawingBrush x:Key="FondoFuturista" Stretch="Fill">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M0,0 H400 V300 H0 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0E131C" Offset="0"/>
                                <GradientStop Color="#0A0E15" Offset="1"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M60,200 H340 V300 H60 Z">
                        <GeometryDrawing.Brush>
                            <RadialGradientBrush Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.5" RadiusY="1">
                                <GradientStop Color="#552A7FFF" Offset="0"/>
                                <GradientStop Color="#1A1E5AC8" Offset="0.45"/>
                                <GradientStop Color="#000E131C" Offset="1"/>
                            </RadialGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M400,120 L280,300 M400,150 L300,300 M400,175 L330,280 L320,300 M400,205 L345,300 M400,230 L370,275 L355,300 M400,60 L340,150 L338,170">
                        <GeometryDrawing.Pen>
                            <Pen Thickness="0.8">
                                <Pen.Brush>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                        <GradientStop Color="#0000D2FF" Offset="0"/>
                                        <GradientStop Color="#6600D2FF" Offset="0.6"/>
                                        <GradientStop Color="#2200D2FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Pen.Brush>
                            </Pen>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#8800D2FF" Geometry="M338,172 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 M330,280 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- Herramienta secundaria (compacta) -->
        <Style x:Key="EstiloMini" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BordeGeneral}"/>
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <!-- Botón llamativo de escaneo -->
        <Style x:Key="EstiloBotonEscanear" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow" CornerRadius="16" Margin="-6" Opacity="0.55">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00D2FF" Offset="0"/>
                                        <GradientStop Color="#B388FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0.9" Duration="0:0:1.4"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                            <Border x:Name="Cuerpo" CornerRadius="14" Padding="34,14" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00D2FF" Offset="0"/>
                                        <GradientStop Color="#7C4DFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M11 4a7 7 0 1 0 0.01 0 M21 21l-5-5" Stroke="White" StrokeThickness="2.4" Stretch="Uniform"
                                          Width="18" Height="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="ESCANEAR TU EMUMMC" Foreground="White" FontSize="15" FontWeight="ExtraBold"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cuerpo" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.05" ScaleY="1.05"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- DASHBOARD (desplazable en pantallas bajas) -->
        <ScrollViewer x:Name="ScrollDashboard" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding Visibility, ElementName=PanelDashboard}" SizeChanged="ScrollDashboard_SizeChanged">
        <Grid x:Name="PanelDashboard">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ PERFIL DE LA CONSOLA ═══ -->
            <Border x:Name="TarjetaPerfil" Style="{StaticResource EstiloTarjeta}" Padding="0" Margin="0,0,18,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#14141C" Offset="0"/>
                        <GradientStop Color="#0C0C12" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Banner con la consola detectada (Lite / OLED / Normal) -->
                    <Border CornerRadius="18,18,0,0" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush x:Name="FondoPerfil" StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2200D2FF" Offset="0"/>
                                <GradientStop Color="#10101A" Offset="0.55"/>
                                <GradientStop Color="#22FF4081" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Viewbox x:Name="FondoConsola" Margin="18,14,18,26" Opacity="0.22" IsHitTestVisible="False">
                                <Path x:Name="SiluetaConsola" StrokeThickness="1.6" StrokeLineJoin="Round">
                                    <Path.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="ColorConsolaIzq" Color="#00D2FF" Offset="0"/>
                                            <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                            <GradientStop x:Name="ColorConsolaDer" Color="#FF4081" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Stroke>
                                    <Path.Effect>
                                        <DropShadowEffect x:Name="GlowConsola" BlurRadius="22" ShadowDepth="0" Color="#00D2FF" Opacity="0.9"/>
                                    </Path.Effect>
                                </Path>
                            </Viewbox>
                            <Border IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0.45"/>
                                        <GradientStop Color="#EE14141C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Avatares en abanico (solapados con el banner) -->
                    <StackPanel Grid.Row="1" Margin="20,-46,20,18">
                        <Grid HorizontalAlignment="Left" Margin="22,0,0,0">
                    <ItemsControl x:Name="ListaPerfiles" VerticalAlignment="Center" Margin="22,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Panel.ZIndex" Value="{Binding Orden}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Raiz" Width="76" Height="76" Margin="-22,0,0,0" Cursor="Hand"
                                      ToolTip="{Binding Apodo}" MouseLeftButtonUp="Perfil_Click"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                                    <Ellipse x:Name="Aro" StrokeThickness="3" Stroke="#0F0F15" Fill="{Binding Color}">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Inicial}" Foreground="White" FontSize="28" FontWeight="ExtraBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Margin="3" Visibility="{Binding VisibilidadAvatar}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding Imagen}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                        <Setter TargetName="Raiz" Property="Margin" Value="4,0,0,0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Seleccionado}" Value="True">
                                        <Setter TargetName="Aro" Property="Stroke" Value="{DynamicResource AcentoCian}"/>
                                    </DataTrigger>
                                    <Trigger SourceName="Raiz" Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Raiz" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.08" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="Raiz" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.08" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Raiz" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="Raiz" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        </Grid>
                        <TextBlock x:Name="TxtPerfilNombre" Text="Perfiles de la emuMMC" Foreground="White"
                                   FontSize="26" FontWeight="ExtraBold" Margin="0,12,0,0" TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#00D2FF" Opacity="0.35"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtPerfilDetalle" Text="Lee la emuMMC para ver tus perfiles y tu almacenamiento."
                                   Style="{StaticResource EstiloSubtitulo}" TextWrapping="Wrap" TextTrimming="None"/>

                        <!-- Modelo de consola detectado -->
                        <Border x:Name="ChipModelo" HorizontalAlignment="Left" Margin="0,10,0,0"
                                CornerRadius="9" Padding="10,4" Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource EstiloIcono}" Width="12" Height="12" Stroke="White"
                                      Data="M7 6h10a5 5 0 0 1 0 12H7A5 5 0 0 1 7 6z M7 10v4 M5 12h4"/>
                                <TextBlock x:Name="TxtModeloConsola" Foreground="White" FontSize="10" FontWeight="Bold" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Estado de la emuMMC -->
                        <Border x:Name="BadgeEstado" CornerRadius="12" Padding="12,8" Margin="0,14,0,0"
                                BorderThickness="1" BorderBrush="#3300E676" Background="#1A00E676">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path x:Name="IconoEstado" Style="{StaticResource EstiloIcono}" Width="14" Height="14" Data="M20 6L9 17l-5-5"/>
                                <TextBlock Text="emuMMC " Foreground="White" FontWeight="Bold" FontSize="13" Margin="10,0,0,0"/>
                                <TextBlock x:Name="TxtEstado" Text="—" Foreground="#00D2FF" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- Datos clave -->
                        <StackPanel Margin="2,14,2,0">
                            <DockPanel Margin="0,0,0,10">
                                <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14" Stroke="#707080" Margin="0,0,12,0"
                                      Data="M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5 M2 12l10 5 10-5"/>
                                <TextBlock x:Name="TxtTipo" DockPanel.Dock="Right" Text="—" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Tipo" Foreground="{DynamicResource TextoSecundario}" FontSize="12"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14" Stroke="#707080" Margin="0,0,12,0"
                                      Data="M7 2h8l4 4v16H7z M10 6v3 M13 6v3 M16 6v3"/>
                                <TextBlock x:Name="TxtSd" DockPanel.Dock="Right" Text="—" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="MicroSD" Foreground="{DynamicResource TextoSecundario}" FontSize="12"/>
                            </DockPanel>
                            <DockPanel>
                                <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14" Stroke="#707080" Margin="0,0,12,0"
                                      Data="M6 6h12v12H6z M9 9h6v6H9z M9 2v4 M15 2v4 M9 18v4 M15 18v4"/>
                                <TextBlock x:Name="TxtContenidos" DockPanel.Dock="Right" Text="—" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Contenidos en SD" Foreground="{DynamicResource TextoSecundario}" FontSize="12"/>
                            </DockPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BordeGeneral}" Margin="0,14"/>

                        <!-- Almacenamiento -->
                        <TextBlock Text="ALMACENAMIENTO" Style="{StaticResource EstiloEtiqueta}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ListaEspacio">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detalle}"
                                                       Foreground="{DynamicResource TextoSecundario}" FontSize="11"/>
                                            <TextBlock Text="{Binding Nombre}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <Grid Height="8" Margin="0,5,0,0">
                                            <Border CornerRadius="4" Background="#1AFFFFFF"/>
                                            <Border CornerRadius="4" HorizontalAlignment="Left" Background="{Binding Color}">
                                                <Border.Width>
                                                    <MultiBinding Converter="{x:Static local:VistaEmuMMC.Proporcion}">
                                                        <Binding Path="Porcentaje"/>
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtSinEspacio" Text="Sin datos todavía." Foreground="{DynamicResource TextoSecundario}" FontSize="12"/>

                        <Button x:Name="BtnLeerConsola" Style="{StaticResource EstiloBoton}" HorizontalAlignment="Stretch"
                                Margin="0,10,0,0" Click="BtnLeerConsola_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14"
                                      Data="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z M12 9a3 3 0 1 0 0 6 3 3 0 1 0 0-6"/>
                                <TextBlock x:Name="TxtBtnLeerConsola" Text="Leer consola" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Expander Foreground="White" IsExpanded="False" Margin="0,12,0,0">
                            <Expander.Header>
                                <TextBlock Text="Detalles técnicos" FontWeight="SemiBold" Foreground="{DynamicResource TextoSecundario}"/>
                            </Expander.Header>
                    <ItemsControl x:Name="ListaDatos" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,28,6">
                                    <TextBlock Text="{Binding Key, StringFormat={}{0}:}" Foreground="#707080"/>
                                    <TextBlock Text="{Binding Value}" Foreground="White" Margin="6,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ COLUMNA PRINCIPAL ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Navegación -->
                <Border Grid.Row="2" VerticalAlignment="Top" Style="{StaticResource EstiloTarjeta}" CornerRadius="16" Padding="6" Panel.ZIndex="5" Visibility="Collapsed" x:Name="BarraNavegacion">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBoton}" VerticalAlignment="Center"
                                Margin="0,0,4,0" Click="BtnEscanear_Click" ToolTip="Volver a escanear la emuMMC">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14" Data="M21 12a9 9 0 1 1-3-6.7 M21 4v5h-5"/>
                                <TextBlock Text="Reescanear" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabJuegos" Content="Juegos" Style="{StaticResource EstiloPestana}" IsChecked="True" Checked="Pestana_Checked"/>
                            <RadioButton x:Name="TabAlbum" Content="Álbum" Style="{StaticResource EstiloPestana}" Checked="Pestana_Checked"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Centro de herramientas -->
                <Border x:Name="PanelInicio" Grid.Row="0" Style="{StaticResource EstiloTarjeta}" Padding="20,16" Margin="0,0,0,16" Background="{StaticResource FondoFuturista}">
                    <StackPanel>
                        <TextBlock Text="Centro de herramientas" Foreground="White" FontSize="20" FontWeight="ExtraBold"/>
                        <TextBlock x:Name="TxtSubtitulo" Text="Gestión y mantenimiento de tu emuMMC" Style="{StaticResource EstiloSubtitulo}"/>
                        <UniformGrid Columns="3" Margin="0,14,0,0">
                            <Grid Margin="0,0,12,0">
                                <Border Style="{StaticResource EstiloHalo}"/>
                                <Border Style="{StaticResource EstiloAccion}" BorderBrush="#9900D2FF" Background="{StaticResource FondoAccionCian}"
                                        MouseEnter="Tarjeta_MouseEnter" MouseLeave="Tarjeta_MouseLeave" MouseLeftButtonUp="TarjetaRespaldar_Click">
                                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource EstiloIcono}" Width="30" Height="30" Data="M12 3v12 M7 10l5 5 5-5 M4 21h16"/>
                                        <TextBlock Text="Respaldar" Style="{StaticResource EstiloTituloAccion}"/>
                                        <TextBlock Text="Copia completa de la emuMMC" Style="{StaticResource EstiloDescAccion}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,12,0">
                                <Border Style="{StaticResource EstiloHalo}"/>
                                <Border Style="{StaticResource EstiloAccion}" BorderBrush="#99B388FF" Background="{StaticResource FondoAccionVioleta}"
                                        MouseEnter="Tarjeta_MouseEnter" MouseLeave="Tarjeta_MouseLeave" MouseLeftButtonUp="TarjetaRestaurar_Click">
                                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource EstiloIcono}" Width="30" Height="30" Stroke="#B388FF" Data="M3 12a9 9 0 1 0 3-6.7 M3 4v5h5"/>
                                        <TextBlock Text="Restaurar" Style="{StaticResource EstiloTituloAccion}"/>
                                        <TextBlock Text="Recupera una copia previa" Style="{StaticResource EstiloDescAccion}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid>
                                <Border Style="{StaticResource EstiloHalo}"/>
                                <Border Style="{StaticResource EstiloAccion}" BorderBrush="#99FFB300" Background="{StaticResource FondoAccionAmbar}"
                                        MouseEnter="Tarjeta_MouseEnter" MouseLeave="Tarjeta_MouseLeave" MouseLeftButtonUp="TarjetaMigrar_Click">
                                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Style="{StaticResource EstiloIcono}" Width="30" Height="30" Stroke="#FFB300" Data="M4 7h13 M13 3l4 4-4 4 M20 17H7 M11 13l-4 4 4 4"/>
                                        <TextBlock Text="Migrar" Style="{StaticResource EstiloTituloAccion}"/>
                                        <TextBlock Text="Traslada a otra microSD" Style="{StaticResource EstiloDescAccion}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,12,0,0">
                            <Border Style="{StaticResource EstiloMini}" Margin="0,0,12,0" ToolTip="Próximamente">
                                <DockPanel>
                                    <Path Style="{StaticResource EstiloIcono}" Width="16" Height="16" Stroke="#FFB300" Data="M12 3v14 M6 11l6 6 6-6 M5 21h14"/>
                                    <TextBlock DockPanel.Dock="Right" Text="PRÓXIMAMENTE" Foreground="#9AA0AA" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="Downgrade de firmware" Foreground="White" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource EstiloMini}" ToolTip="Próximamente">
                                <DockPanel>
                                    <Path Style="{StaticResource EstiloIcono}" Width="16" Height="16" Stroke="#FF5252" Data="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/>
                                    <TextBlock DockPanel.Dock="Right" Text="PRÓXIMAMENTE" Foreground="#9AA0AA" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reparar arranque" Foreground="White" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" x:Name="ZonaContenido" Margin="0,62,0,0" Visibility="Collapsed">
            <Border x:Name="PanelAlbum" Style="{StaticResource EstiloTarjeta}" Padding="20,16" Visibility="Collapsed" Background="{StaticResource FondoFuturista}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="BtnExportarAlbum" DockPanel.Dock="Right" Style="{StaticResource EstiloBoton}"
                                Click="BtnExportarAlbum_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14" Data="M12 3v12 M7 10l5 5 5-5 M4 21h16"/>
                                <TextBlock x:Name="TxtBtnExportar" Text="Extraer" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnCargarAlbum" DockPanel.Dock="Right" Style="{StaticResource EstiloBoton}" Margin="0,0,8,0"
                                Click="BtnCargarAlbum_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14" Data="M21 12a9 9 0 1 1-3-6.7 M21 4v5h-5"/>
                                <TextBlock x:Name="TxtBtnCargarAlbum" Text="Cargar álbum" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton GroupName="FiltroAlbum" Content="Todo" Style="{StaticResource EstiloFiltro}" IsChecked="True" Tag="todo" Checked="FiltroAlbum_Checked"/>
                            <RadioButton GroupName="FiltroAlbum" Content="Capturas" Style="{StaticResource EstiloFiltro}" Tag="img" Checked="FiltroAlbum_Checked"/>
                            <RadioButton GroupName="FiltroAlbum" Content="Vídeos" Style="{StaticResource EstiloFiltro}" Tag="vid" Checked="FiltroAlbum_Checked"/>
                            <TextBlock x:Name="TxtAlbumInfo" Text="" Foreground="{DynamicResource TextoSecundario}" FontSize="12"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <ListBox x:Name="ListaAlbum" Grid.Row="1" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource EstiloMiniatura}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                             SelectionChanged="ListaAlbum_SelectionChanged" MouseDoubleClick="ListaAlbum_DoubleClick"
                             KeyDown="ListaAlbum_KeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Ver" Click="MenuAlbumVer_Click"/>
                                <MenuItem Header="Extraer seleccionados…" Click="BtnExportarAlbum_Click"/>
                                <MenuItem Header="Seleccionar todo" Click="MenuAlbumTodo_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2,6,0,10">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding ItemCount, StringFormat={}  ·  {0}}" Foreground="{DynamicResource TextoSecundario}" FontSize="12" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <!-- Estado vacío / cargando -->
                    <StackPanel x:Name="PanelAlbumVacio" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="72" Height="72" CornerRadius="20" Background="#1A00D2FF" HorizontalAlignment="Center">
                            <Path Style="{StaticResource EstiloIcono}" Width="32" Height="32"
                                  Data="M3 5h18v14H3z M3 15l5-5 4 4 3-3 6 6 M15 9a1.5 1.5 0 1 0 0.01 0"/>
                        </Border>
                        <TextBlock x:Name="TxtAlbumVacio" Text="Tus capturas y vídeos de la consola aparecerán aquí."
                                   Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                        <TextBlock Text="Se leen de la microSD y de la memoria de la consola (emuMMC, solo lectura)."
                                   Foreground="{DynamicResource TextoSecundario}" FontSize="12" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="BarraAlbum" Height="4" Width="220" Margin="0,16,0,0" IsIndeterminate="True"
                                     Visibility="Collapsed" Foreground="{DynamicResource AcentoCian}" Background="#14FFFFFF" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PESTAÑA JUEGOS -->
            <Border x:Name="PanelJuegos" Style="{StaticResource EstiloTarjeta}" Padding="20,16" Background="{StaticResource FondoFuturista}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Partidas guardadas (Saves)" Foreground="White" FontSize="18" FontWeight="ExtraBold"/>
                        <TextBlock Text="Juegos detectados en la emuMMC con partidas guardadas" Style="{StaticResource EstiloSubtitulo}"/>
                    </StackPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,12">
                        <Button x:Name="BtnRespaldarJuegos" DockPanel.Dock="Right" Style="{StaticResource EstiloBoton}"
                                Click="BtnRespaldarJuegos_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14" Data="M12 3v12 M7 10l5 5 5-5 M4 21h16"/>
                                <TextBlock Text="Respaldar saves" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnCargarJuegos" DockPanel.Dock="Right" Style="{StaticResource EstiloBoton}" Margin="0,0,8,0"
                                Click="BtnCargarJuegos_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14" Data="M21 12a9 9 0 1 1-3-6.7 M21 4v5h-5"/>
                                <TextBlock x:Name="TxtBtnCargarJuegos" Text="Cargar juegos" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Border CornerRadius="10" Background="#0AFFFFFF" BorderBrush="{DynamicResource BordeGeneral}" BorderThickness="1"
                                Padding="10,0" Width="240" HorizontalAlignment="Left" Height="32">
                            <DockPanel>
                                <Path Style="{StaticResource EstiloIcono}" Width="13" Height="13" Stroke="{DynamicResource TextoSecundario}"
                                      Data="M11 4a7 7 0 1 0 0.01 0 M21 21l-5-5"/>
                                <Grid Margin="8,0,0,0">
                                    <TextBlock x:Name="TxtBuscarMarca" Text="Buscar juego…" Foreground="{DynamicResource TextoSecundario}"
                                               FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBox x:Name="TxtBuscarJuego" Background="Transparent" BorderThickness="0" Foreground="White"
                                             CaretBrush="White" FontSize="12" VerticalAlignment="Center" TextChanged="TxtBuscarJuego_TextChanged"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="TxtJuegosInfo" Foreground="{DynamicResource TextoSecundario}" FontSize="12"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DockPanel>

                    <ListBox x:Name="ListaJuegos" Grid.Row="2" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource EstiloJuego}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="ListaJuegos_SelectionChanged"
                             MouseDoubleClick="BtnRespaldarJuegos_Click">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copiar Title ID" Click="MenuCopiarTitleId_Click"/>
                                <MenuItem Header="Copiar nombre" Click="MenuCopiarNombre_Click"/>
                                <Separator/>
                                <MenuItem Header="Respaldar save…" Click="BtnRespaldarJuegos_Click"/>
                                <MenuItem Header="Seleccionar todo" Click="MenuJuegosTodo_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <StackPanel x:Name="PanelJuegosVacio" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="72" Height="72" CornerRadius="20" Background="#1AB388FF" HorizontalAlignment="Center">
                            <Path Style="{StaticResource EstiloIcono}" Width="32" Height="32" Stroke="#B388FF"
                                  Data="M7 6h10a5 5 0 0 1 0 12H7A5 5 0 0 1 7 6z M7 10v4 M5 12h4 M15 11h0.01 M17 13h0.01"/>
                        </Border>
                        <TextBlock x:Name="TxtJuegosVacio" Text="Tus juegos y partidas guardadas aparecerán aquí."
                                   Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                        <TextBlock Text="Clic derecho para copiar el Title ID o respaldar la partida guardada."
                                   Foreground="{DynamicResource TextoSecundario}" FontSize="12" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="BarraJuegos" Height="4" Width="220" Margin="0,16,0,0" IsIndeterminate="True"
                                     Visibility="Collapsed" Foreground="#B388FF" Background="#14FFFFFF" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>

                </Grid>

                <!-- Bloqueo hasta escanear -->
                <Border x:Name="BloqueoContenido" Grid.Row="2" Style="{StaticResource EstiloTarjeta}" Background="{StaticResource FondoFuturista}" MinHeight="340">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="84" Height="84" CornerRadius="24" Background="#1400D2FF" BorderBrush="#3300D2FF" BorderThickness="1" HorizontalAlignment="Center">
                            <Path Style="{StaticResource EstiloIcono}" Width="36" Height="36" Stroke="#00D2FF"
                                  Data="M5 11h14v10H5z M8 11V7a4 4 0 0 1 8 0v4 M12 15v2"/>
                        </Border>
                        <TextBlock Text="Contenido bloqueado" Foreground="White" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                        <TextBlock Text="Escanea tu emuMMC para desbloquear perfiles, juegos, saves y álbum de una sola vez."
                                   Foreground="{DynamicResource TextoSecundario}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,26"/>
                        <Button x:Name="BtnEscanear" Style="{StaticResource EstiloBotonEscanear}" HorizontalAlignment="Center" Click="BtnEscanear_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>

        <!-- SUBVISTA SAVES -->
        <Grid x:Name="PanelSaves" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Left" Style="{StaticResource EstiloBoton}" Click="BtnVolver_Click"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14" Data="M15 18l-6-6 6-6"/>
                        <TextBlock Text="Volver" Margin="6,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRespaldar" DockPanel.Dock="Right" Style="{StaticResource EstiloBoton}"
                        Content="Respaldar seleccionados" Margin="8,0,0,0" IsEnabled="False"
                        VerticalAlignment="Center" Click="BtnRespaldar_Click"/>
                <Button x:Name="BtnLeerSaves" DockPanel.Dock="Right" Style="{StaticResource EstiloBoton}"
                        Content="Reescanear" VerticalAlignment="Center" Click="BtnLeerSaves_Click"/>
                <ComboBox x:Name="ComboPerfil" DockPanel.Dock="Right" Width="180" Margin="0,0,8,0"
                          VerticalAlignment="Center" SelectionChanged="ComboPerfil_SelectionChanged"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RESCATAR SAVES" Foreground="#00D2FF" FontSize="22" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource EstiloBadgeExperimental}"><TextBlock Text="EXPERIMENTAL" Foreground="#FFB300" FontSize="10" FontWeight="Bold"/></Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtSaves" Text="Escanea la emuMMC para listar las partidas."
                               Foreground="#707080" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource EstiloTarjeta}" Padding="10">
                <ListView x:Name="ListaSaves" SelectionMode="Extended"
                          Background="Transparent" Foreground="White" BorderThickness="0"
                          SelectionChanged="ListaSaves_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Fondo" Background="Transparent" CornerRadius="8"
                                                BorderThickness="1" BorderBrush="Transparent" Padding="0,2">
                                            <GridViewRowPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Fondo" Property="Background" Value="#1400D2FF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Fondo" Property="Background" Value="#3300D2FF"/>
                                                <Setter TargetName="Fondo" Property="BorderBrush" Value="#00D2FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="52">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Width="40" Height="40" Stretch="UniformToFill"
                                               Source="{Binding IconoUrl, TargetNullValue={x:Null}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Juego"    Width="300" DisplayMemberBinding="{Binding Nombre}"/>
                            <GridViewColumn Header="Perfil"   Width="140" DisplayMemberBinding="{Binding Perfil}"/>
                            <GridViewColumn Header="TitleID"  Width="160" DisplayMemberBinding="{Binding TitleId}"/>
                            <GridViewColumn Header="Tamaño"   Width="90"  DisplayMemberBinding="{Binding TamanoTexto}"/>
                            <GridViewColumn Header="Fecha"    Width="140" DisplayMemberBinding="{Binding Fecha, StringFormat=g}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
            <StackPanel x:Name="PanelEscanear" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource EstiloBoton}" Padding="28,12" Click="BtnLeerSaves_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EstiloIcono}" Width="18" Height="18" Data="M11 4a7 7 0 1 0 0 14a7 7 0 1 0 0-14z M21 21l-5-5"/>
                        <TextBlock Text="ESCANEAR SAVES" Margin="10,0,0,0" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Lectura segura: no se modifica la emuMMC." Foreground="#707080" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Para recuperarlos en la consola usa un gestor de partidas: DBI, JKSV o Checkpoint." TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Foreground="#00D2FF" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel x:Name="PanelEscaneando" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="56" Height="56" StrokeThickness="5" Stroke="{StaticResource PincelNeonRotatorio}" StrokeDashArray="6 3" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="Escaneando saves…" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>

        <!-- SUBVISTA MIGRAR (un lector: SD origen → PC → SD destino) -->
        <Grid x:Name="PanelMigrar" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
                <Button x:Name="BtnVolverMigrar" DockPanel.Dock="Left" Style="{StaticResource EstiloBoton}" Click="BtnVolver_Click"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14" Data="M15 18l-6-6 6-6"/>
                        <TextBlock Text="Volver" Margin="6,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MIGRAR MICROSD" Foreground="#00D2FF" FontSize="22" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource EstiloBadgeExperimental}"><TextBlock Text="EXPERIMENTAL" Foreground="#FFB300" FontSize="10" FontWeight="Bold"/></Border>
                    </StackPanel>
                    <TextBlock Text="Con un solo lector: la SD antigua se copia al PC y después se vuelca en la nueva."
                               Foreground="#707080" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <UniformGrid Grid.Row="1" Columns="3">
                <!-- Paso 1 -->
                <Border x:Name="Paso1" Style="{StaticResource EstiloTarjeta}" Padding="22" Margin="0,0,12,0">
                    <DockPanel>
                        <Button x:Name="BtnPaso1" DockPanel.Dock="Bottom" Style="{StaticResource EstiloBoton}"
                                Content="Copiar SD actual al PC" Click="BtnPaso1_Click"/>
                        <StackPanel>
                            <Border Style="{StaticResource EstiloBadge}" HorizontalAlignment="Left">
                                <Path Style="{StaticResource EstiloIcono}" Data="M12 3v12 M7 10l5 5 5-5 M4 21h16"/>
                            </Border>
                            <TextBlock Text="1 · Copiar SD actual" Style="{StaticResource EstiloTituloTarjeta}" Margin="0,14,0,0"/>
                            <TextBlock Text="Inserta la microSD antigua y selecciónala. Se copia al PC sin modificarla: archivos y, si existe, la partición emuMMC."
                                       Style="{StaticResource EstiloDescTarjeta}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- Paso 2 -->
                <Border x:Name="Paso2" Style="{StaticResource EstiloTarjeta}" Padding="22" Margin="0,0,12,0">
                    <StackPanel>
                        <Border Style="{StaticResource EstiloBadge}" Background="#1AB388FF" HorizontalAlignment="Left">
                            <Path Style="{StaticResource EstiloIcono}" Stroke="#B388FF" Data="M7 2h8l4 4v16H7z M10 6v3 M13 6v3 M16 6v3"/>
                        </Border>
                        <TextBlock Text="2 · Cambiar microSD" Style="{StaticResource EstiloTituloTarjeta}" Margin="0,14,0,0"/>
                        <TextBlock Text="Extrae la microSD antigua, inserta la nueva y selecciónala en el panel de la derecha."
                                   Style="{StaticResource EstiloDescTarjeta}"/>
                        <TextBlock Text="No borres la copia del PC hasta comprobar que la consola arranca con la nueva SD."
                                   Style="{StaticResource EstiloDescTarjeta}" Foreground="#FFB300" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Paso 3 -->
                <Border x:Name="Paso3" Style="{StaticResource EstiloTarjeta}" Padding="22">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button x:Name="BtnPaso3" Style="{StaticResource EstiloBoton}" BorderBrush="#FF5252"
                                    Content="Preparar y restaurar en SD nueva" Click="BtnPaso3_Click"/>
                            <Button x:Name="BtnElegirCopia" Style="{StaticResource EstiloBoton}" BorderBrush="#2A2A35"
                                    Content="Usar otra copia del PC…" Margin="0,8,0,0" Click="BtnElegirCopia_Click"/>
                        </StackPanel>
                        <StackPanel>
                            <Border Style="{StaticResource EstiloBadge}" Background="#1AFF5252" HorizontalAlignment="Left">
                                <Path Style="{StaticResource EstiloIcono}" Stroke="#FF5252" Data="M3 12a9 9 0 1 0 3-6.7 M3 4v5h5"/>
                            </Border>
                            <TextBlock Text="3 · Restaurar en SD nueva" Style="{StaticResource EstiloTituloTarjeta}" Margin="0,14,0,0"/>
                            <TextBlock Text="Se BORRA la SD nueva, se particiona con el mismo tipo de emuMMC y se restaura la copia. Se verifica al terminar."
                                       Style="{StaticResource EstiloDescTarjeta}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>
        </Grid>

        <!-- SUBVISTA RESPALDAR -->
        <Grid x:Name="PanelRespaldar" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
                <Button x:Name="BtnVolverRespaldar" DockPanel.Dock="Left" Style="{StaticResource EstiloBoton}" Click="BtnVolver_Click"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14" Data="M15 18l-6-6 6-6"/>
                        <TextBlock Text="Volver" Margin="6,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RESPALDAR EMUMMC" Style="{StaticResource EstiloTituloSeccion}"/>
                        <Border Style="{StaticResource EstiloBadgeExperimental}"><TextBlock Text="EXPERIMENTAL" Foreground="#FFB300" FontSize="10" FontWeight="Bold"/></Border>
                    </StackPanel>
                    <TextBlock Text="Un punto de restauración por si algo sale mal en el futuro. La microSD solo se lee."
                               Style="{StaticResource EstiloSubtitulo}"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource EstiloTarjeta}" Padding="24" Margin="0,0,12,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Right" x:Name="TxtTotalRespaldo" Text="—" Foreground="White"
                                           FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TAMAÑO ESTIMADO" Style="{StaticResource EstiloEtiqueta}"/>
                                    <TextBlock x:Name="TxtDestinoRespaldo" Text="—" Foreground="#9AA0AA" FontSize="12"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <Button x:Name="BtnCrearRespaldo" Style="{StaticResource EstiloBoton}" Padding="20,12" Click="BtnCrearRespaldo_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource EstiloIcono}" Width="16" Height="16" Data="M12 3v12 M7 10l5 5 5-5 M4 21h16"/>
                                    <TextBlock Text="CREAR RESPALDO" Margin="10,0,0,0" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCarpetaRespaldos" Style="{StaticResource EstiloBoton}" BorderBrush="{DynamicResource BordeGeneral}"
                                    Content="Cambiar carpeta de respaldos…" Margin="0,8,0,0" Click="BtnCarpetaRespaldos_Click"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="ORIGEN" Style="{StaticResource EstiloEtiqueta}"/>
                            <Border Style="{StaticResource EstiloPanelInterior}" Margin="0,6,0,18">
                                <UniformGrid Columns="3">
                                    <StackPanel>
                                        <TextBlock Text="MICROSD" Style="{StaticResource EstiloEtiqueta}"/>
                                        <TextBlock x:Name="TxtRespSd" Text="—" Style="{StaticResource EstiloValor}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="TIPO" Style="{StaticResource EstiloEtiqueta}"/>
                                        <TextBlock x:Name="TxtRespTipo" Text="—" Style="{StaticResource EstiloValor}" FontSize="16"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="FIRMWARE" Style="{StaticResource EstiloEtiqueta}"/>
                                        <TextBlock x:Name="TxtRespFirmware" Text="—" Style="{StaticResource EstiloValor}" FontSize="16"/>
                                    </StackPanel>
                                </UniformGrid>
                            </Border>

                            <TextBlock Text="QUÉ INCLUIR" Style="{StaticResource EstiloEtiqueta}"/>
                            <ToggleButton Style="{StaticResource EstiloOpcionTarjeta}" IsChecked="True" IsHitTestVisible="False" Focusable="False" Margin="0,6,0,8">
                                <DockPanel>
                                    <TextBlock x:Name="TxtTamEmu" DockPanel.Dock="Right" Text="—" Foreground="#9AA0AA" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="emuMMC (sistema, perfiles y partidas)" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Siempre incluida." Foreground="#9AA0AA" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="ChkRespJuegos" Style="{StaticResource EstiloOpcionTarjeta}" Checked="ChkRespJuegos_Cambiado" Unchecked="ChkRespJuegos_Cambiado">
                                <DockPanel>
                                    <TextBlock x:Name="TxtTamJuegos" DockPanel.Dock="Right" Text="—" Foreground="#9AA0AA" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="Juegos instalados en la microSD" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Evita reinstalarlos después, pero ocupa mucho más espacio." Foreground="#9AA0AA" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </ToggleButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource EstiloTarjeta}" Padding="20">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBoton}" Padding="10,5"
                                    BorderBrush="{DynamicResource BordeGeneral}" Click="BtnAbrirCarpetaRespaldos_Click">
                                <TextBlock Text="Abrir carpeta" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                            <TextBlock Text="RESPALDOS EN ESTE PC" Style="{StaticResource EstiloEtiqueta}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid>
                            <ListBox x:Name="ListaRespaldosResp" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource EstiloItemRespaldo}"
                                     ItemTemplate="{StaticResource PlantillaRespaldo}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            <TextBlock x:Name="TxtSinRespaldosResp" Text="Aún no hay respaldos." Foreground="{DynamicResource TextoSecundario}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- SUBVISTA RESTAURAR -->
        <Grid x:Name="PanelRestaurar" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
                <Button x:Name="BtnVolverRestaurar" DockPanel.Dock="Left" Style="{StaticResource EstiloBoton}" Click="BtnVolver_Click"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14" Data="M15 18l-6-6 6-6"/>
                        <TextBlock Text="Volver" Margin="6,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnOtraCarpetaRestaurar" DockPanel.Dock="Right" Style="{StaticResource EstiloBoton}" BorderBrush="{DynamicResource BordeGeneral}"
                        VerticalAlignment="Center" Content="Buscar en otra carpeta…" Click="BtnOtraCarpetaRestaurar_Click"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RESTAURAR EMUMMC" Style="{StaticResource EstiloTituloSeccion}"/>
                        <Border Style="{StaticResource EstiloBadgeExperimental}"><TextBlock Text="EXPERIMENTAL" Foreground="#FFB300" FontSize="10" FontWeight="Bold"/></Border>
                    </StackPanel>
                    <TextBlock Text="Elige un respaldo. Se comprueba antes de escribir nada en la microSD."
                               Style="{StaticResource EstiloSubtitulo}"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource EstiloTarjeta}" Padding="20" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="1 · ELIGE UN RESPALDO" Style="{StaticResource EstiloEtiqueta}" Margin="0,0,0,12"/>
                        <Grid>
                            <ListBox x:Name="ListaRespaldosRest" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource EstiloItemRespaldo}"
                                     ItemTemplate="{StaticResource PlantillaRespaldo}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="ListaRespaldosRest_SelectionChanged"/>
                            <TextBlock x:Name="TxtSinRespaldosRest" Text="No se encontraron respaldos." Foreground="{DynamicResource TextoSecundario}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource EstiloTarjeta}" Padding="24">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <ToggleButton x:Name="ChkRestJuegos" Style="{StaticResource EstiloOpcionTarjeta}" Margin="0,0,0,12" IsEnabled="False">
                                <DockPanel>
                                    <TextBlock x:Name="TxtRestTamJuegos" DockPanel.Dock="Right" Text="—" Foreground="#9AA0AA" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="Restaurar también los juegos instalados" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock x:Name="TxtRestJuegosDesc" Text="Este respaldo no incluye juegos." Foreground="#9AA0AA" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </ToggleButton>
                            <Button x:Name="BtnRestaurar" Style="{StaticResource EstiloBoton}" Padding="20,12" IsEnabled="False"
                                    BorderBrush="{DynamicResource AcentoRojo}" Click="BtnRestaurar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource EstiloIcono}" Width="16" Height="16" Stroke="{DynamicResource AcentoRojo}" Data="M3 12a9 9 0 1 0 3-6.7 M3 4v5h5"/>
                                    <TextBlock Text="RESTAURAR EN LA MICROSD" Margin="10,0,0,0" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="2 · COMPROBACIONES" Style="{StaticResource EstiloEtiqueta}" Margin="0,0,0,12"/>
                            <ItemsControl x:Name="ListaComprobaciones" ItemTemplate="{StaticResource PlantillaComprobacion}"/>
                            <TextBlock x:Name="TxtSinSeleccion" Text="Selecciona un respaldo para analizarlo frente a la microSD actual."
                                       Foreground="{DynamicResource TextoSecundario}" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Estado / progreso compartido por Migrar, Respaldar y Restaurar -->
        <Border x:Name="PanelProgreso" Grid.Row="1" Style="{StaticResource EstiloTarjeta}" Margin="0,16,0,0" Padding="22,16"
                Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="BtnCancelarMigracion" DockPanel.Dock="Right" Style="{StaticResource EstiloBoton}"
                        BorderBrush="{DynamicResource AcentoRojo}" Content="Cancelar" Margin="16,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed" Click="BtnCancelarMigracion_Click"/>
                <TextBlock x:Name="TxtPorcentaje" DockPanel.Dock="Right" Text="" Foreground="White" FontSize="20"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <StackPanel>
                    <TextBlock x:Name="TxtEtiquetaCopia" Text="COPIA EN EL PC" Style="{StaticResource EstiloEtiqueta}"/>
                    <TextBlock x:Name="TxtCopiaMigracion" Text="Ninguna" Foreground="White" FontSize="13"
                               FontWeight="SemiBold" Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="BarraMigracion" Height="6" Minimum="0" Maximum="100"
                                 Background="#14141C" Foreground="{StaticResource PincelNeonRotatorio}" BorderThickness="0"/>
                    <TextBlock x:Name="TxtMigracion" Text="Listo para empezar." Foreground="#9AA0AA" FontSize="12"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- VISOR DEL ÁLBUM (superpuesto) -->
        <Grid x:Name="Visor" Grid.RowSpan="2" Visibility="Collapsed" Background="#F2060609" Focusable="True"
              KeyDown="Visor_KeyDown" MouseLeftButtonUp="Visor_FondoClick">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="20,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBoton}" Click="VisorCerrar_Click" ToolTip="Cerrar (Esc)">
                    <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14" Data="M6 6l12 12 M18 6L6 18"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBoton}" Margin="0,0,8,0" Click="VisorExtraer_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EstiloIcono}" Width="14" Height="14" Data="M12 3v12 M7 10l5 5 5-5 M4 21h16"/>
                        <TextBlock Text="Extraer" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtVisorTitulo" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtVisorDetalle" Style="{StaticResource EstiloSubtitulo}"/>
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1" Margin="70,0">
                <Image x:Name="VisorImagen" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <MediaElement x:Name="VisorVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                              Visibility="Collapsed" MediaEnded="VisorVideo_Ended" MouseLeftButtonUp="VisorVideo_Click"/>
            </Grid>
            <Button Grid.Row="1" HorizontalAlignment="Left" Margin="16,0" Style="{StaticResource EstiloBoton}"
                    Click="VisorAnterior_Click" ToolTip="Anterior (←)">
                <Path Style="{StaticResource EstiloIcono}" Width="16" Height="16" Data="M15 18l-6-6 6-6"/>
            </Button>
            <Button Grid.Row="1" HorizontalAlignment="Right" Margin="16,0" Style="{StaticResource EstiloBoton}"
                    Click="VisorSiguiente_Click" ToolTip="Siguiente (→)">
                <Path Style="{StaticResource EstiloIcono}" Width="16" Height="16" Data="M9 18l6-6-6-6"/>
            </Button>
            <TextBlock x:Name="TxtVisorPosicion" Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,16"
                       Foreground="{DynamicResource TextoSecundario}" FontSize="12" FontWeight="SemiBold"/>
        </Grid>

        <!-- OVERLAY DE ESCANEO -->
        <Grid x:Name="OverlayEscaneo" Visibility="Collapsed" Panel.ZIndex="200">
            <Grid.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#F00C0C14" Offset="0"/>
                    <GradientStop Color="#FA050508" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="150" Height="150">
                    <Ellipse Stroke="#1AFFFFFF" StrokeThickness="6"/>
                    <Ellipse StrokeThickness="6" StrokeDashArray="12 30" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00D2FF" Offset="0"/>
                                <GradientStop Color="#B388FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                        <Ellipse.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#00D2FF"/></Ellipse.Effect>
                        <Ellipse.RenderTransform><RotateTransform x:Name="GiroEscaneo"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Margin="26" Stroke="#55FF4081" StrokeThickness="2" StrokeDashArray="2 6" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform x:Name="GiroEscaneo2"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock x:Name="TxtPorcentajeEscaneo" Text="0%" Foreground="White" FontSize="26" FontWeight="ExtraBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="ESCANEANDO EMUMMC" Foreground="#00D2FF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,26,0,0"/>
                <TextBlock x:Name="TxtMensajeEscaneo" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Margin="0,8,0,0" TextAlignment="Center" MaxWidth="520" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtPasoEscaneo" Foreground="{DynamicResource TextoSecundario}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <Grid Width="360" Height="6" Margin="0,18,0,0">
                    <Border CornerRadius="3" Background="#14FFFFFF"/>
                    <Border x:Name="BarraEscaneo" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00D2FF" Offset="0"/>
                                <GradientStop Color="#B388FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
