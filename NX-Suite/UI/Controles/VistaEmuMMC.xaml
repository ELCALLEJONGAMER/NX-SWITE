<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NX_Swite.UI.Controles.VistaEmuMMC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="22" BorderBrush="#2A2A35" BorderThickness="2"
            Background="#0800D2FF" Padding="28,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel>
                <Button x:Name="BtnActualizar" DockPanel.Dock="Right" Content="Actualizar"
                        Padding="14,6" Click="BtnActualizar_Click"/>
                <StackPanel>
                    <TextBlock Text="emuMMC" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Información de la emuMMC de la microSD seleccionada (solo lectura)."
                               Foreground="#9AA0AA" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="TxtEstado" Grid.Row="1" Margin="0,18,0,0" FontSize="16"
                       FontWeight="SemiBold" Foreground="#00CCFF" TextWrapping="Wrap"/>

            <ItemsControl x:Name="ListaDatos" Grid.Row="2" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Key}" Foreground="#9AA0AA"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="White" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button x:Name="BtnRespaldar" DockPanel.Dock="Right" Content="Respaldar seleccionados"
                            Padding="14,6" Margin="8,0,0,0" IsEnabled="False" Click="BtnRespaldar_Click"/>
                    <Button x:Name="BtnLeerSaves" DockPanel.Dock="Right" Content="Leer saves"
                            Padding="14,6" Click="BtnLeerSaves_Click"/>
                    <ComboBox x:Name="ComboPerfil" DockPanel.Dock="Right" Width="180" Margin="0,0,8,0"
                              SelectionChanged="ComboPerfil_SelectionChanged"/>
                    <TextBlock x:Name="TxtSaves" Text="Saves de juegos" Foreground="White"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <ListView x:Name="ListaSaves" Grid.Row="1" Margin="0,10,0,0" SelectionMode="Extended"
                          Background="Transparent" Foreground="White" BorderBrush="#2A2A35"
                          SelectionChanged="ListaSaves_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="52">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Width="40" Height="40" Stretch="UniformToFill"
                                               Source="{Binding IconoUrl, TargetNullValue={x:Null}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Juego"    Width="300" DisplayMemberBinding="{Binding Nombre}"/>
                            <GridViewColumn Header="Perfil"   Width="140" DisplayMemberBinding="{Binding Perfil}"/>
                            <GridViewColumn Header="TitleID"  Width="160" DisplayMemberBinding="{Binding TitleId}"/>
                            <GridViewColumn Header="Tamaño"   Width="90"  DisplayMemberBinding="{Binding TamanoTexto}"/>
                            <GridViewColumn Header="Fecha"    Width="140" DisplayMemberBinding="{Binding Fecha, StringFormat=g}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
    </Border>
</UserControl>
