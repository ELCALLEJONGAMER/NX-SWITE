<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ColoresGlobales.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ??????????????????????????????????????????????????????????????????????
         TOGGLE SWITCH  - CheckBox con apariencia de interruptor deslizante
         Uso:  &lt;CheckBox Style="{StaticResource EstiloToggleSwitch}" IsChecked="True"/&gt;
    ?????????????????????????????????????????????????????????????????????????? -->
    <Style x:Key="EstiloToggleSwitch" TargetType="CheckBox">
        <Setter Property="Focusable"     Value="False"/>
        <Setter Property="Cursor"        Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid VerticalAlignment="Center">
                        <!-- Pista -->
                        <Border x:Name="Track"
                                Width="44" Height="24"
                                CornerRadius="12"
                                Background="#2A2A35"
                                BorderThickness="1"
                                BorderBrush="#3A3A48">
                            <Border.Effect>
                                <DropShadowEffect x:Name="TrackGlow"
                                                  Color="#00D2FF"
                                                  BlurRadius="0"
                                                  ShadowDepth="0"
                                                  Opacity="0"/>
                            </Border.Effect>
                        </Border>
                        <!-- Pulgar -->
                        <Border x:Name="Thumb"
                                Width="18" Height="18"
                                CornerRadius="9"
                                Background="#707080"
                                HorizontalAlignment="Left"
                                Margin="3,0,0,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- ON -->
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                         Storyboard.TargetProperty="X"
                                                         To="20" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#0D2A35" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#00D2FF" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="Thumb"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#00D2FF" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="TrackGlow"
                                                         Storyboard.TargetProperty="BlurRadius"
                                                         To="10" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="TrackGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.45" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#2A2A35" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#3A3A48" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="Thumb"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#707080" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="TrackGlow"
                                                         Storyboard.TargetProperty="BlurRadius"
                                                         To="0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="TrackGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ??????????????????????????????????????????????????????????????????????
         FILA DE AJUSTE  - contenedor horizontal para label + descripcion + switch
    ?????????????????????????????????????????????????????????????????????????? -->
    <Style x:Key="EstiloFilaAjuste" TargetType="Border">
        <Setter Property="Background"       Value="#12121A"/>
        <Setter Property="CornerRadius"     Value="10"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="BorderBrush"      Value="#1E1E28"/>
        <Setter Property="Padding"          Value="16,12"/>
        <Setter Property="Margin"           Value="0,0,0,6"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#2A2A38"/>
                <Setter Property="Background"  Value="#14141E"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ??????????????????????????????????????????????????????????????????????
         CABECERA DE SECCION
    ?????????????????????????????????????????????????????????????????????????? -->
    <Style x:Key="EstiloCabeceraSeccion" TargetType="TextBlock">
        <Setter Property="Foreground"   Value="#707080"/>
        <Setter Property="FontSize"     Value="10"/>
        <Setter Property="FontWeight"   Value="Bold"/>
        <Setter Property="Margin"       Value="4,16,0,8"/>
    </Style>

    <!-- ??????????????????????????????????????????????????????????????????????
         TAB BUTTON de la ventana de ajustes (selector de seccion lateral)
    ?????????????????????????????????????????????????????????????????????????? -->
    <Style x:Key="EstiloTabAjuste" TargetType="RadioButton">
        <Setter Property="Foreground"       Value="#707080"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="FontWeight"       Value="SemiBold"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Margin"           Value="0,2"/>
        <Setter Property="GroupName"        Value="TabsAjuste"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Contenedor"
                            CornerRadius="10"
                            Padding="14,10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Contenedor" Property="Background" Value="#1A1A25"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Contenedor" Property="Background" Value="#16161F"/>
                            <Setter Property="Foreground" Value="#C0C0D0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boton cerrar ventana de ajustes -->
    <Style x:Key="EstiloBtnCerrarAjustes" TargetType="Button">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Width"        Value="28"/>
        <Setter Property="Height"       Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3A1520"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
