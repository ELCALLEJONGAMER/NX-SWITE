<Application x:Class="NX_Suite.Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Acento" Color="#00D2FF" />

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E26" />
            <Setter Property="Foreground" Value="#E6E6EA" />
            <Setter Property="BorderBrush" Value="#33333F" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A35" />
            <Setter Property="Foreground" Value="#E6E6EA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#16161C" />
            <Setter Property="Foreground" Value="#E6E6EA" />
            <Setter Property="BorderBrush" Value="#2A2A35" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E6EA" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#16161C" />
            <Setter Property="Foreground" Value="#E6E6EA" />
            <Setter Property="RowBackground" Value="#1B1B22" />
            <Setter Property="AlternatingRowBackground" Value="#1F1F27" />
            <Setter Property="BorderBrush" Value="#2A2A35" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#2A2A35" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#22222B" />
            <Setter Property="Foreground" Value="#9A9AA8" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="#2A2A35" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9AA8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>

        <Style x:Key="Titulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00D2FF" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Ayuda" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6E6E7C" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Application.Resources>
</Application>
